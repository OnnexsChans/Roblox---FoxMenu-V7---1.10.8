	local function textBox(parent, ph, size, pos)
		local tb = F.new("TextBox", { Size = size, Position = pos, BackgroundColor3 = C.panel, Text = "", PlaceholderText = ph,
			PlaceholderColor3 = C.muted, TextColor3 = C.white, Font = EF.GothamMedium, TextSize = 12, ClearTextOnFocus = false,
			TextXAlignment = EXA.Left, ClipsDescendants = true, TextWrapped = false, R = 9 }, parent)
		F.new("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) }, tb)
		return tb
	end
	local function halfBtn(parent, text, left, cb)
		local b = F.new("TextButton", { Size = U2(0.5, -14, 0, 30), Position = left and U2(0, 8, 0.5, -15) or U2(0.5, 6, 0.5, -15), BackgroundColor3 = C.panel,
			Text = text, TextColor3 = C.text, Font = EF.GothamBold, TextSize = 12, AutoButtonColor = false, R = 9 }, parent)
		F.interactive(b, "panel", "white", "black", true)
		b.MouseButton1Click:Connect(function() F.click() cb(b) end)
		return b
	end

