function F.loadProfile(n)
	local p = S.profiles[n]
	if type(p) ~= "table" then return F.toast("Perfil não encontrado") end
	local ids = {}
	for id in pairs(p) do if Reg[id] then ids[#ids + 1] = id end end
	table.sort(ids)
	local touched, gBefore = st.statsTouched, Reg.grav and Reg.grav.get()
	-- 1) desliga o que o perfil quer desligado · 2) sliders/escolhas (só o que mudou) · 3) liga o que o perfil quer ligado
	for _, id in ipairs(ids) do
		if p[id] == false and Reg[id].get() == true then F.safe(Reg[id].set, false) end
	end
	for _, id in ipairs(ids) do
		local v = p[id]
		if type(v) ~= "boolean" and Reg[id].get() ~= v then F.safe(Reg[id].set, v) end
	end
	for _, id in ipairs(ids) do
		if p[id] == true and Reg[id].get() ~= true then F.safe(Reg[id].set, true) end
	end
	-- valores iguais ao padrão = volta ao original do jogo (não força 16 / 50 / 196)
	if Reg.walk and Reg.jump and p.walk == Reg.walk.def and p.jump == Reg.jump.def and (touched or st.statsTouched) then F.restoreStats() end
	if Reg.grav and p.grav == Reg.grav.def and gBefore ~= Reg.grav.def then workspace.Gravity = origGravity end
	F.syncToggles()
	F.toast("Perfil carregado: " .. n)
end
F.rebuildProfiles = function()
	F.clearBox(V.profBox)
	local names = {}
	for n in pairs(S.profiles) do names[#names + 1] = n end
	table.sort(names)
	if #names == 0 then F.note(V.profBox, "Nenhum perfil salvo.", 20) end
	for i, n in ipairs(names) do
		local row = F.new("Frame", { Size = U2(1, 0, 0, 44), BackgroundColor3 = C.item, LayoutOrder = i, R = 12 }, V.profBox)
		F.txt(row, "💾  " .. n, { Size = U2(1, -150, 1, 0), Position = U2o(14, 0) })
		F.smallBtn(row, "Carregar", 128, 80, function() F.loadProfile(n) end)
		F.smallBtn(row, "×", 40, 32, function() S.profiles[n] = nil F.save() F.rebuildProfiles() end)
	end
end
F.rebuildProfiles()
local NORESET = { tg_share = true, tg_self = true, tg_others = true, tg_owner = true, introopt = true, sbcollapse = true, theme = true, accent = true, scale = true, opacity = true, sounds = true, toasts = true }
function F.resetAll()
	local sf = F.safe
	sf(F.stopAction, true) sf(F.setSpectate, false)
	V.replay = false
	local ids = {}
	for id in pairs(Reg) do if not NORESET[id] then ids[#ids + 1] = id end end
	table.sort(ids)
	for _, id in ipairs(ids) do -- primeiro desliga o que está ligado (evita um recurso religar outro), depois volta sliders/escolhas
		local r = Reg[id]
		if r.def == false and r.get() == true then sf(r.set, false) end
	end
	for _, id in ipairs(ids) do
		local r = Reg[id]
		if not (r.def == false and r.get() == false) and r.get() ~= r.def then sf(r.set, r.def) end
	end
	sf(F.restoreStats) sf(F.restoreCamera) sf(F.restoreLighting)
	pcall(function() workspace.Gravity = origGravity end)
	F.toast("Tudo desfeito")
end

-- REINICIAR: desfaz tudo (mesma rotina do "Desfazer tudo"), devolve a interface ao estado inicial e repete a abertura.
-- Não cria elementos nem conexões novas: só reaproveita o que já existe (a intro se desconecta sozinha ao terminar).
function F.restart()
	if V.closing or V.intro or V.restarting then return end
	V.restarting = true
	local sf = F.safe
	sf(F.closeDropdown)
	sf(F.resetAll) -- desliga tudo que está ativo e reverte os efeitos (voo, flashback, ESP, luz, câmera...)
	if F.isListening and F.isListening() then sf(F.rebuildBinds) end -- cancela "Pressione..." de um atalho
	V.sBox.Text = "" V.sBox:ReleaseFocus()
	search.Text = "" -- o filtro de jogadores (já dispara a reconstrução da lista)
	F.X.frQ = "" sf(F.rebuildFriends)
	sf(F.selectTarget, nil)
	for _, t in pairs(V.tabs) do
		if t.scroll:IsA("ScrollingFrame") then t.scroll.CanvasPosition = Vector2.zero end
	end
	V.minimized = false
	F.setVisible(false) -- fecha a janela (e a bolinha) e fecha a busca
	F.reselect("Início")
	if S.noIntro then F.ready() else F.intro(F.ready) end -- respeita a opção "Animação de abertura"
end
