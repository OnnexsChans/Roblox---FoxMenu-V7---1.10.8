			MU.statusL = F.txt(row, "Parada", { Size = U2(1, -28, 0, 16), Position = U2o(14, 30), TextColor3 = C.muted, TextSize = 11, Font = EF.Gotham })
			local hit = F.new("TextButton", { Size = U2(1, -28, 0, 20), Position = U2o(14, 50), BackgroundTransparency = 1, Text = "", AutoButtonColor = false }, row)
			local bar = F.new("Frame", { Size = U2(1, 0, 0, 6), AnchorPoint = Vector2.new(0, 0.5), Position = U2(0, 0, 0.5, 0), BackgroundColor3 = C.off, BorderSizePixel = 0, R = 3 }, hit)
			MU.pfill = F.new("Frame", { Size = U2(0, 0, 1, 0), BackgroundColor3 = C.white, BorderSizePixel = 0, R = 3 }, bar)
