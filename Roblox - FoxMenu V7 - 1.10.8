function F.setEsp(on)
	X.espOn = on
	if X.espC then X.espC:Disconnect() X.espC = nil end
	if not on then for p in pairs(X.esp) do F.espClear(p) end return end
	local acc = 0.5
	X.espC = RS.Heartbeat:Connect(function(dt)
		acc += dt
		if acc < 0.5 then return end
		acc = 0
		for _, p in ipairs(Players:GetPlayers()) do
			local e, c = X.esp[p], p.Character
			if p ~= player and c then
				local want = X.espMode ~= "Só o alvo selecionado" or p == V.target
				if want and (not e or e.c ~= c) then F.espApply(p)
				elseif not want and e then F.espClear(p)
				elseif e then
					local d = F.dist(p)
					e.lbl.Text = e.name .. (d and ("  ·  " .. d .. "m") or "")
				end
			elseif e then F.espClear(p) end
		end
		for p in pairs(X.esp) do if not p.Parent then F.espClear(p) end end
	end)
end
local _sel = F.selectTarget
function F.selectTarget(p)
