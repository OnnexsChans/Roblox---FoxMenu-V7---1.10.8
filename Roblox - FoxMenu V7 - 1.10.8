function E.paintSel()
	for _, t in pairs(E.tiles) do
		if t.sk and t.b.Parent then F.tw(t.sk, { Transparency = (E.selIdx == t.idx) and 0.15 or 1 }, 0.15) end
	end
end
-- filtra o "Meu menu" pelo nome/criador já salvos (sem rede): pula pra página certa e destaca o slot.
-- Enter de novo passa para o próximo resultado.
function E.libFilterLive(cycle)
	local ui = E.ui
	local q = F.norm(E.ui.sb.Text or "")
	E.libMI = E.libMI or 0
	if q == "" then E.libQ, E.libMatches, E.libMI = "", {}, 0 return end
	if q ~= E.libQ then
		E.libQ, E.libMatches, E.libMI = q, {}, 0
		for i, e in ipairs(D.lib) do
			if F.norm(e.n or ""):find(q, 1, true) or F.norm(e.c or ""):find(q, 1, true) then E.libMatches[#E.libMatches + 1] = i end
		end
	end
	if #E.libMatches == 0 then F.snd("err") return end
	E.libMI = cycle and (E.libMI % #E.libMatches + 1) or (E.libMI == 0 and 1 or E.libMI)
	local idx = E.libMatches[E.libMI]
	local pg = E.pageOf(idx, "emote")
	if pg ~= E.page then E.page = pg E.renderMenu() end
	E.selIdx = idx
	E.paintSel()
	E.refreshMenuBar()
	local t = E.tiles[E.off("emote") + idx - (pg - 1) * PER_PAGE]
	if t and t.sk then
		F.tw(t.sk, { Transparency = 0 }, 0.12)
		task.delay(0.7, function() if t.sk and t.sk.Parent then F.tw(t.sk, { Transparency = 1 }, 0.4) end end)
	end
	if #E.libMatches > 1 then F.toast(E.libMI .. " de " .. #E.libMatches .. " no seu menu", "ok") end
end
function E.renderMenu(dir)
	local ui = E.ui
	if not (ui and ui.slots) then return end
	if E.wmode == "emote" then E.page = math.clamp(E.page, 1, E.pageCount()) end
	local pgE = math.clamp(E.page, 1, E.pageCountE())
	for _, c in ipairs(ui.slots:GetChildren()) do
		if c:IsA("GuiObject") then c:Destroy() end
	end
	E.tiles = {}
	local K, origs = E.off("emote"), E.origNames()
	for s = 1, PER_PAGE do
		local v = (pgE - 1) * PER_PAGE + s
		if v <= K then
			E.tileOrig(s, origs[v])
		else
			local idx = v - K
			E.tile(s, idx, D.lib[idx])
		end
	end
	E.paintSel()
	if dir then
		ui.slots.Position, ui.slots.GroupTransparency = U2o(dir * 48, 36), 1
		F.tw(ui.slots, { Position = U2o(0, 36), GroupTransparency = 0 }, 0.28, QUINT)
	end
	E.refreshMenuBar()
end
function E.refreshMenuBar()
	local ui = E.ui
	if not (ui and ui.menu) then return end
	if ui.bAuto then E.setOn(ui.bAuto, E.auto, E.auto and "⚡ Envio automático: ligado" or "⚡ Envio automático: desligado") end
	E.setOn(ui.bSync, E.sync, E.sync and "🔁 Sync: ligado" or "🔁 Sync: desligado")
	local sel = E.selIdx and D.lib[E.selIdx]
	ui.tool.Visible, ui.hint.Visible = sel ~= nil, sel == nil
	if sel then
		ui.tFav.Text = E.isFav("emote", sel.id) and "★ Favorito" or "☆ Favoritar"
		ui.tTest.Text = E.playingId == sel.id and "⏹ Parar" or "▶ Testar"
	end
	local nOrig = E.off("emote")
	ui.pageLbl.Text = ("Página %d / %d   ·   %d emote(s) no menu"):format(math.clamp(E.page, 1, E.pageCountE()), E.pageCountE(), #D.lib)
		.. (nOrig > 0 and ("   ·   🔒 %d original(is)"):format(nOrig) or "")
	for _, t in pairs(E.tiles) do
		local e = D.lib[t.idx]
		if e and t.star then
			local fav = E.isFav("emote", e.id)
			t.star.Text, t.star.TextColor3 = fav and "★" or "☆", fav and GOLD or C.white
			t.state.Text = E.playingId == e.id and "▶ tocando" or (E.sync and "● na roda" or "")
		end
	end
end

