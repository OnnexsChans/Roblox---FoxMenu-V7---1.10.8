		F.txt(b, (it.creator or e.c or "") ~= "" and ("por @" .. (it.creator or e.c)) or "", { Size = U2(1, -16, 0, 14), Position = U2o(8, 79), TextColor3 = C.muted, Font = EF.Gotham, TextSize = 11 })
