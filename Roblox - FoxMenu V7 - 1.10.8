	if X.espOn and X.espMode == "Só o alvo selecionado" then for q in pairs(X.esp) do F.espClear(q) end end
end

-- ===== anti-invisível (denuncia quem está invisível) =====
local function isInvis(c)
	local n, hid = 0, 0
	for _, d in ipairs(c:GetChildren()) do
		if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" then
			n += 1
			if d.Transparency >= 0.9 then hid += 1 end
		end
	end
	return n > 0 and hid == n
end
function F.setAntiInvis(on)
	if X.invC then X.invC:Disconnect() X.invC = nil end
	local function clear() for p, e in pairs(X.inv) do e.hl:Destroy() e.bb:Destroy() X.inv[p] = nil end end
	clear()
	if not on then return end
	local acc = 1
	X.invC = RS.Heartbeat:Connect(function(dt)
		acc += dt
		if acc < 0.6 then return end
		acc = 0
		for _, p in ipairs(Players:GetPlayers()) do
			local c = p ~= player and p.Character
			local rr = c and c:FindFirstChild("HumanoidRootPart")
			local e = X.inv[p]
			if c and rr and isInvis(c) then
				if not e or e.c ~= c then
					if e then e.hl:Destroy() e.bb:Destroy() end
					X.inv[p] = { c = c, hl = mkHL(c, C3(255, 70, 90), nil, 0.3), bb = (mkBB(rr, "⚠ INVISÍVEL · " .. p.DisplayName, C3(255, 110, 120), 200)) }
				end
			elseif e then e.hl:Destroy() e.bb:Destroy() X.inv[p] = nil end
		end
	end)
end

