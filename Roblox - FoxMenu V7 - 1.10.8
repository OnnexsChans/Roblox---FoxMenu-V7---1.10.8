-- ===== proteção =====
function F.setAntiVoid(on)
	if X.avC then X.avC:Disconnect() X.avC = nil end
	if not on then return end
	local nxt = 0
	local rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Exclude
	X.avC = RS.Heartbeat:Connect(function()
		local r = F.root()
		if not r then return end
		local t = os.clock()
		if t >= nxt then
			nxt = t + 0.1
			rp.FilterDescendantsInstances = { player.Character }
			if workspace:Raycast(r.Position, Vector3.new(0, -8, 0), rp) then X.safe = r.CFrame end
		end
		if r.Position.Y < -40 then
			local cf = X.cp or X.safe
			if cf then
				r.CFrame = cf + Vector3.new(0, 3, 0)
				r.AssemblyLinearVelocity = Vector3.zero
				F.toast("Anti-Void: resgatado")
			end
		end
	end)
end
function F.setAntiFling(on)
	for _, k in ipairs({ "afC", "afS" }) do if X[k] then X[k]:Disconnect() X[k] = nil end end
	for part in pairs(X.afOrig) do
		if part.Parent then pcall(function() part.CanCollide = true end) end
		X.afOrig[part] = nil
	end
	if not on then return end
	local nxt, last = 0, 0
	X.afS = RS.Stepped:Connect(function()
		for _, p in ipairs(Players:GetPlayers()) do
			local c = p ~= player and p.Character
			if c then
				for _, d in ipairs(c:GetChildren()) do
					if d:IsA("BasePart") and d.CanCollide then X.afOrig[d] = true d.CanCollide = false end
				end
			end
		end
	end)
	X.afC = RS.Heartbeat:Connect(function()
		local r, h = F.root(), aliveHum()
		if not (r and h) then return end
		local t = os.clock()
		local v, w = r.AssemblyLinearVelocity.Magnitude, r.AssemblyAngularVelocity.Magnitude
		if t >= nxt and v <= 42 and w <= 12 and h.MoveDirection.Magnitude <= 1.05 and not h.Sit then
			nxt = t + 0.12
			X.afSafe = r.CFrame
		end
		if (v >= 160 or w >= 50) and not st.fly and t - last > 0.12 then
			last = t
			if X.afSafe then r.CFrame = X.afSafe end
			r.AssemblyLinearVelocity, r.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
			h.PlatformStand, h.Sit = false, false
		end
	end)
end

