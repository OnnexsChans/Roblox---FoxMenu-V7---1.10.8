function F.fox(parent, px, props)
	local f = F.new("Frame", { Size = U2o(px, px), BackgroundTransparency = 1 }, parent)
	for k, v in pairs(props or {}) do f[k] = v end
	local P = {}
	local function part(n, x, y, w, h, rot, col, rad, z)
		P[n] = F.new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(x, y), Size = UDim2.fromScale(w, h),
			Rotation = rot, BackgroundColor3 = col, BorderSizePixel = 0, ZIndex = z, R = UDim.new(rad, 0) }, f)
	end
	part("earL", 0.25, 0.27, 0.30, 0.30, 45, FOX.o, 0.12, 1)
	part("earR", 0.75, 0.27, 0.30, 0.30, 45, FOX.o, 0.12, 1)
	part("inL", 0.25, 0.30, 0.15, 0.15, 45, FOX.k, 0.15, 2)
	part("inR", 0.75, 0.30, 0.15, 0.15, 45, FOX.k, 0.15, 2)
	part("head", 0.5, 0.52, 0.72, 0.48, 0, FOX.o, 0.45, 3)
	part("mark", 0.5, 0.37, 0.11, 0.11, 45, FOX.d, 0.2, 4)
	part("chL", 0.27, 0.68, 0.30, 0.30, 45, FOX.c, 0.12, 4)
	part("chR", 0.73, 0.68, 0.30, 0.30, 45, FOX.c, 0.12, 4)
	part("chin", 0.5, 0.72, 0.32, 0.32, 45, FOX.c, 0.12, 5)
	part("eyeL", 0.36, 0.50, 0.12, 0.07, 20, FOX.k, 0.5, 6)
	part("eyeR", 0.64, 0.50, 0.12, 0.07, -20, FOX.k, 0.5, 6)
	part("nose", 0.5, 0.82, 0.11, 0.08, 0, FOX.k, 0.5, 7)
	return f, P
end
function F.blink(P)
	for _, n in ipairs({ "eyeL", "eyeR" }) do
		local e = P[n]
		local h = e.Size.Y.Scale
		F.tw(e, { Size = UDim2.fromScale(e.Size.X.Scale, 0.012) }, 0.08)
		task.delay(0.12, function() F.tw(e, { Size = UDim2.fromScale(e.Size.X.Scale, h) }, 0.12) end)
	end
end

