	local y = rel.Y + anchor.AbsoluteSize.Y / sc + 4
	if y + h > main.AbsoluteSize.Y / sc - 6 then y = math.max(6, rel.Y - h - 4) end
	ddFrame = F.new("Frame", { Size = U2o(w, h), Position = U2o(math.min(rel.X, W - w - 10), y), BackgroundColor3 = C.panel, BorderSizePixel = 0, ZIndex = 81, R = 14, S = 0.6 }, main)
	local pop = F.new("UIScale", { Scale = 0.92 }, ddFrame)
	F.tw(pop, { Scale = 1 }, 0.25, BACK)
	local fb = F.new("TextBox", { Size = U2(1, -16, 0, 30), Position = U2o(8, 8), BackgroundColor3 = C.item, Text = "", PlaceholderText = "🔍  Filtrar ações...", PlaceholderColor3 = C.muted,
		TextColor3 = C.white, Font = EF.GothamMedium, TextSize = 12, ClearTextOnFocus = false, TextXAlignment = EXA.Left, R = 9 }, ddFrame)
	F.new("UIPadding", { PaddingLeft = UDim.new(0, 10) }, fb)
	local sf = F.scroller(ddFrame, U2(1, -12, 1, -50), U2o(6, 44), 2)
	local function fill()
		for _, c in ipairs(sf:GetChildren()) do if c:IsA("TextButton") then c:Destroy() end end
		local q, n = F.norm(fb.Text), 0
		for _, e in ipairs(EntList) do
			if e.act and (q == "" or F.norm(e.name):find(q, 1, true) or F.norm(e.tab):find(q, 1, true)) then
