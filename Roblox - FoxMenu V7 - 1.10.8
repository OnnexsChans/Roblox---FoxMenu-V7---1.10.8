do -- gravar / repetir, cronômetro, trocar servidor, inspetor
	function F.setRec(on)
		V.recOn = on
		if on then V.rec = {} F.recReset() F.toast("Gravando movimento...")
		else F.toast("Gravação: " .. #V.rec .. " quadros") end
	end
	function F.replay()
		if #V.rec == 0 then return F.toast("Nada gravado") end
		if V.replay then return end
		V.replay = true
		F.toast("Reproduzindo...")
		task.spawn(function()
			repeat
				for i = 1, #V.rec do
					local r = F.root()
					if not V.replay or V.closing or not r then break end
					r.CFrame, r.AssemblyLinearVelocity = V.rec[i], Vector3.zero
					task.wait(0.05)
				end
			until not (st.loop and V.replay) or V.closing
			V.replay = false
		end)
	end
	V.swAcc, V.swRun, V.swStart = 0, false, 0
	function F.swElapsed() return V.swAcc + (V.swRun and (os.clock() - V.swStart) or 0) end
	function F.swToggle()
		if V.swRun then V.swAcc += os.clock() - V.swStart V.swRun = false else V.swStart, V.swRun = os.clock(), true end
	end
	function F.serverHop()
		F.toast("Procurando servidor...")
		task.spawn(function()
			local ok, res = pcall(function()
				return game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100")
			end)
			if not ok then return F.toast("Sem acesso à lista de servidores") end
			local ok2, data = pcall(function() return Http:JSONDecode(res) end)
			if not (ok2 and type(data) == "table" and data.data) then return F.toast("Falha ao ler servidores") end
			local l = {}
			for _, s in ipairs(data.data) do if s.id ~= game.JobId and s.playing < s.maxPlayers then l[#l + 1] = s end end
			if #l == 0 then return F.toast("Nenhum servidor disponível") end
			F.toast("Trocando de servidor...")
			pcall(function() TP:TeleportToPlaceInstance(game.PlaceId, l[math.random(#l)].id, player) end)
		end)
	end
	local box = F.new("SelectionBox", { LineThickness = 0.05, Color3 = C.white, Transparency = 0.2 }, gui)
	function F.setInspect(on) V.inspOn = on if not on then box.Adornee = nil end end
	function F.inspectAtMouse()
		local m = UIS:GetMouseLocation()
		local ray = F.CAM():ViewportPointToRay(m.X, m.Y)
		local hit = workspace:Raycast(ray.Origin, ray.Direction * 3000)
		if not hit then return end
		local p, I = hit.Instance, V.I
		box.Adornee = p
		I.i_name(p.Name) I.i_class(p.ClassName) I.i_path(p:GetFullName())
		I.i_size(string.format("%.1f, %.1f, %.1f", p.Size.X, p.Size.Y, p.Size.Z))
		I.i_mat(p.Material.Name .. (p.Anchored and " · ancorado" or ""))
		I.i_col(p.CanCollide and "sim" or "não")
	end
end
