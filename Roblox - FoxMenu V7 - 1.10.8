	["ó"] = "o", ["ô"] = "o", ["õ"] = "o", ["ú"] = "u", ["ü"] = "u", ["ç"] = "c", ["Á"] = "a", ["É"] = "e", ["Í"] = "i", ["Ó"] = "o",
	["Ú"] = "u", ["Ã"] = "a", ["Ç"] = "c", ["Õ"] = "o", ["Ê"] = "e", ["Ô"] = "o", ["Â"] = "a" }
