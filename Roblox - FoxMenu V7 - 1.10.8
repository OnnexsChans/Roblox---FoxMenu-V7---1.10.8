function F.addBlack(t)
	t = t:gsub("^%s+", ""):gsub("%s+$", ""):gsub("^@", "")
	if t == "" then return F.toast("Digite um ID ou @username") end
	task.spawn(function()
		local uid = tonumber(t)
		local ok, name
		if uid then ok, name = pcall(Players.GetNameFromUserIdAsync, Players, uid)
		else
			local ok2, id = pcall(Players.GetUserIdFromNameAsync, Players, t)
			if not ok2 then return F.toast("Usuário não encontrado") end
			uid, ok, name = id, pcall(Players.GetNameFromUserIdAsync, Players, id)
		end
		if not ok then return F.toast("Usuário não encontrado") end
		if uid == player.UserId then return F.toast("Você não pode se adicionar") end
		S.black[tostring(uid)] = name
		F.save() F.rebuildBlack()
		F.toast("Blacklist: " .. name)
	end)
end
function F.rebuildBlack()
	if not X.blBox then return end
	F.clearBox(X.blBox)
	local n = 0
	for id, name in pairs(S.black) do
		n += 1
		local row = F.new("Frame", { Size = U2(1, 0, 0, 44), BackgroundColor3 = C.item, LayoutOrder = n, R = 12 }, X.blBox)
		F.txt(row, "🚫  " .. name, { Size = U2(1, -200, 1, 0), Position = U2o(14, 0) })
		F.smallBtn(row, "ID", 138, 50, function() F.copyText(id, "ID") end)
		F.smallBtn(row, "×", 40, 32, function()
			S.black[id] = nil alerted[tonumber(id)] = nil
			for p, m in pairs(X.marks) do if tostring(p.UserId) == id and m.hl then m.hl:Destroy() m.bb:Destroy() X.marks[p] = nil end end
			F.save() F.rebuildBlack()
		end)
	end
	if n == 0 then F.note(X.blBox, "Nenhum alvo salvo.", 20) end
end

-- ===== ações em jogador: lado a lado, cabeça, arrasto =====
local ACT = {
	stand = { msg = "Ao lado de ", f = function(tr, r)
		local cf = tr.CFrame
		local pos = tr.Position + cf.RightVector * 1.95 - cf.LookVector * 0.35 + Vector3.new(0, 0.05, 0)
		r.CFrame = CFrame.lookAt(pos, pos + cf.LookVector)
	end },
	headsit = { msg = "Sentado na cabeça de ", f = function(tr, r, h, tc)
		local head = tc:FindFirstChild("Head") or tr
		h.Sit = true
		r.CFrame = head.CFrame * CFrame.new(0, 1.7, 0)
	end },
	drag = { msg = "Preso ao braço de ", f = function(tr, r, h, tc)
		local hand = tc:FindFirstChild("RightHand") or tc:FindFirstChild("Right Arm") or tr
		r.CFrame = hand.CFrame * CFrame.new(0, -0.6, -1.2)
	end },
	-- WORM: em pé nas costas do alvo, olhando para as costas dele, com animação em loop
	worm = { msg = "Worm em ", f = function(tr, r, h)
		h.Sit = false
		local a = F.wormAnim
		if not (a and a.hum == h) then
			F.wormPlay(h)
		elseif a.track and os.clock() >= (a.nextChk or 0) then
			a.nextChk = os.clock() + 0.2
			if not a.track.IsPlaying then pcall(function() a.track:Play(0.1) end) end
			pcall(function() a.track:AdjustWeight(1, 0) end)
			local an = h:FindFirstChildOfClass("Animator")
			if an then
				for _, t in ipairs(an:GetPlayingAnimationTracks()) do
					if t ~= a.track and not X.fbOwn[t] then pcall(function() t:Stop(0.05) end) end
				end
			end
		end
		-- mesma altura do alvo; Z positivo = atrás dele, virado para as costas dele
		r.CFrame = tr.CFrame * CFrame.new(0, 0, 1.4)
	end, stop = function() F.wormStop() end },
}

--==================== NOVO: ZOAR JOGADOR — AJUSTES MANUAIS (EDITE AQUI) ====================
-- (a altura é automática: a CINTURA do seu personagem fica sempre na altura da CABEÇA do alvo, sem ajuste manual)
local FACE_MIN_DIST = 1    -- distância mínima na frente do alvo (studs), ponto mais perto do vai-e-vem
local FACE_TRAVEL   = 1    -- <<< X studs: quanto você vai e volta (frente/trás). Ex.: 5 = oscila entre 4 e 9 studs de distância
local FACE_SPEED    = 36    -- velocidade do vai-e-vem (maior = mais rápido)
--==============================================================================================
-- distância vertical (studs) entre a raiz (HumanoidRootPart) e a cintura do SEU personagem, medida ao vivo
-- R15: usa o attachment da cintura (WaistRigAttachment); R6: o centro do torso/raiz é a cintura
local function faceWaistOffset(r)
	local c = player.Character
	local part = c and (c:FindFirstChild("LowerTorso") or c:FindFirstChild("UpperTorso"))
	local att = part and part:FindFirstChild("WaistRigAttachment")
	if att and att:IsA("Attachment") then
		local d = att.WorldPosition.Y - r.Position.Y
		if d == d and math.abs(d) < 20 then return d end -- descarta NaN/valores absurdos
	end
	return 0
end
-- altura da cabeça do alvo (centro da Head); se não existir, estima pelo topo da raiz
local function faceHeadY(tr, tc)
	local head = tc and tc:FindFirstChild("Head")
	if head and head:IsA("BasePart") then return head.Position.Y end
	return tr.Position.Y + tr.Size.Y / 2
end
-- sem animação de queda: enquanto zoa, bloqueia os estados de queda/pulo e mantém o personagem em "Running"
-- parado, então o Animate toca a pose normal em pé (braços para baixo, pernas retas). Tudo é restaurado ao parar.
local FACE_BLOCK = { Enum.HumanoidStateType.Freefall, Enum.HumanoidStateType.Jumping, Enum.HumanoidStateType.FallingDown }
local faceLock, faceNext = nil, 0
local function faceUnlock()
	local hh = faceLock
	faceLock = nil
	if hh and hh.Parent then
		for _, st in ipairs(FACE_BLOCK) do pcall(function() hh:SetStateEnabled(st, true) end) end
	end
end
local function faceStand(h)
	if faceLock ~= h then
		faceUnlock()
		faceLock, faceNext = h, 0
		for _, st in ipairs(FACE_BLOCK) do pcall(function() h:SetStateEnabled(st, false) end) end
		pcall(function() h:ChangeState(Enum.HumanoidStateType.Running) end)
	end
	local now = os.clock()
	if now < faceNext or h.Health <= 0 then return end
	faceNext = now + 0.1
	if h:GetState() ~= Enum.HumanoidStateType.Running then
		pcall(function() h:ChangeState(Enum.HumanoidStateType.Running) end)
	end
	-- garante que nenhuma animação de queda/pulo continue tocando
	local an = h:FindFirstChildOfClass("Animator")
	if an then
		for _, t in ipairs(an:GetPlayingAnimationTracks()) do
			local n = t.Animation and t.Animation.Name
			if n == "FallAnim" or n == "JumpAnim" then pcall(function() t:Stop(0.1) end) end
		end
	end
end
ACT.face = { msg = "Zoando ", stop = faceUnlock, f = function(tr, r, h, tc)
	h.Sit = false
	faceStand(h)
	-- 0..1 em loop suave (vai e volta)
	local k = (math.sin(os.clock() * FACE_SPEED) + 1) / 2
	local dist = FACE_MIN_DIST + k * FACE_TRAVEL
	-- na FRENTE do alvo (LookVector = para onde ele olha); cintura na altura da cabeça do alvo (automático)
	local flat = tr.CFrame.LookVector * dist
	local pos = Vector3.new(tr.Position.X + flat.X, faceHeadY(tr, tc) - faceWaistOffset(r), tr.Position.Z + flat.Z)
	-- olha para o alvo na horizontal (sem inclinar o corpo)
	r.CFrame = CFrame.lookAt(pos, Vector3.new(tr.Position.X, pos.Y, tr.Position.Z))
end }

F.WORM_ID = "rbxassetid://108172243817649"
function F.wormStop()
	local a = F.wormAnim
	F.wormAnim = nil
	if a then
		if a.track then pcall(function() a.track:Stop(0.1) a.track:Destroy() end) end
		if a.anim then pcall(function() a.anim:Destroy() end) end
		if a.animate and a.animate.Parent then pcall(function() a.animate.Disabled = a.animPrev == true end) end
	end
end
local function wormTry(animator, id, wait)
	local anim = Instance.new("Animation")
	anim.AnimationId = id
	local ok, track = pcall(function() return animator:LoadAnimation(anim) end)
	if not ok or not track then anim:Destroy() return end
	if wait then
		local t = os.clock()
		while track.Length == 0 and os.clock() - t < 2.5 do task.wait(0.1) end
		if track.Length == 0 then pcall(function() track:Destroy() end) anim:Destroy() return end
	end
	return anim, track
end
-- descobre qual ID realmente toca (direto ou dentro do modelo do mercado) e guarda em cache
function F.wormResolve(animator)
	local c = F.wormCache
	if c and c.src == F.WORM_ID then return wormTry(animator, c.id, false) end
	pcall(function()
		game:GetService("ContentProvider"):PreloadAsync({ F.WORM_ID })
	end)
	local anim, track = wormTry(animator, F.WORM_ID, true)
	if not anim then
		local num = tostring(F.WORM_ID):match("%d+")
		local ok, objs = pcall(function() return game:GetObjects("rbxassetid://" .. num) end)
		if ok and type(objs) == "table" then
			for _, o in ipairs(objs) do
				local a = o:IsA("Animation") and o or o:FindFirstChildWhichIsA("Animation", true)
				if a and a.AnimationId ~= "" then
					anim, track = wormTry(animator, a.AnimationId, true)
					if anim then break end
				end
			end
		end
	end
	if anim then F.wormCache = { src = F.WORM_ID, id = anim.AnimationId } end
	return anim, track
end
-- pré-carrega em segundo plano para o clique tocar na hora
function F.wormPreload()
	task.spawn(function()
		local t = os.clock()
		local h
		repeat h = F.hum() task.wait(0.3) until h or os.clock() - t > 15
		local animator = h and h:FindFirstChildOfClass("Animator")
		if not animator then return end
		local anim, track = F.wormResolve(animator)
		if track then pcall(function() track:Destroy() end) end
		if anim then anim:Destroy() end
	end)
end
function F.wormPlay(h)
	F.wormStop()
	local rec = { hum = h }
	F.wormAnim = rec
	local an = h.Parent and h.Parent:FindFirstChild("Animate")
	if an and an:IsA("LocalScript") then
		rec.animate, rec.animPrev = an, an.Disabled
		an.Disabled = true
	end
	local animator = h:FindFirstChildOfClass("Animator")
	if not animator then animator = Instance.new("Animator") animator.Parent = h end
	local function start(anim, track)
		track.Looped, track.Priority = true, Enum.AnimationPriority.Action4
		track:Play(0)
		rec.anim, rec.track = anim, track
	end
	-- caminho rápido: ID já resolvido no pré-carregamento, toca no mesmo frame
	local c = F.wormCache
	if c and c.src == F.WORM_ID then
		local anim, track = wormTry(animator, c.id, false)
		if anim then return start(anim, track) end
	end
	task.spawn(function()
		local anim, track = F.wormResolve(animator)
		if F.wormAnim ~= rec then
			if track then pcall(function() track:Stop() track:Destroy() end) end
			if anim then anim:Destroy() end
			return
		end
		if not anim then
			return F.toast("Animação não carregou: ID errado, privada ou de outro dono")
		end
		start(anim, track)
	end)
end
F.wormPreload()
local _start, _stop = F.startAction, F.stopAction
function F.startAction(mode)
	local a = ACT[mode]
	if not a then return _start(mode) end
	if not F.needTarget() then return end
	if not (F.targetRoot() and F.root()) then return F.toast("Personagem indisponível") end
	F.stopAction(true)
	V.mode = mode
	V.conn = RS.Heartbeat:Connect(function()
		local tr, r, h = F.targetRoot(), F.root(), F.hum()
		if not (tr and r and h) then return end
		r.AssemblyLinearVelocity, r.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
		a.f(tr, r, h, V.target.Character)
	end)
	F.refreshUI()
	F.toast(a.msg .. V.target.DisplayName)
end
function F.stopAction(silent)
	local a = ACT[V.mode]
	if a then
		local h = F.hum()
		if h then h.Sit = false end
		if a.stop then a.stop() end
	end
	_stop(silent)
end

-- ===== NOVO: ações da aba Jogadores viram alternâncias (clicar de novo para parar) =====
F.ACT_TOGGLES = { follow = "follow", orbitp = "orbit", attach = "attach", stand = "stand", headsit = "headsit", drag = "drag", worm = "worm", face = "face" }
function F.syncActs()
	for id, mode in pairs(F.ACT_TOGGLES) do
		local r = Reg[id]
		if r and r.get() ~= (V.mode == mode) then r.set(V.mode == mode, true) end
	end
	local sp = Reg.spectate
	if sp and sp.get() ~= (V.spec == true) then sp.set(V.spec == true, true) end
end
function F.actCB(mode)
	return function(on)
		if on then F.startAction(mode)
		elseif V.mode == mode then F.stopAction() end
		F.syncActs()
	end
end
function F.stopAll()
	local had = V.mode or V.spec
	F.stopAction(true)
	if V.spec then F.setSpectate(false) end
	F.syncActs()
	F.toast(had and "Ação parada" or "Nenhuma ação ativa")
end

-- ===== NOVO: Tecla Z = zoar o jogador mais próximo (toque = liga/desliga) =====
-- Z já é usada no zoom (Z + scroll). Por isso a ação dispara ao SOLTAR o Z,
-- e só se você não rolou o scroll enquanto segurava. Assim o zoom continua intacto.
function F.nearestPlayer()
	local r = F.root()
	if not r then return end
	local best, bd
	for _, p in ipairs(Players:GetPlayers()) do
		local c = p ~= player and p.Character
		local tr = c and c:FindFirstChild("HumanoidRootPart")
		local hm = c and c:FindFirstChildOfClass("Humanoid")
		if tr and hm and hm.Health > 0 then
			local d = (tr.Position - r.Position).Magnitude
			if not bd or d < bd then best, bd = p, d end
		end
	end
	return best
end
function F.toggleFaceNearest()
	if V.mode == "face" then
		F.stopAction()
		F.syncActs()
		return
	end
	local p = F.nearestPlayer()
	if not p then return F.toast("Nenhum jogador por perto") end
	F.selectTarget(p)
	F.startAction("face")
	F.syncActs()
end
F.track(UIS.InputBegan:Connect(function(i, gp)
	if i.KeyCode ~= KC.Z then return end
	X.zArmed = not (gp or UIS:GetFocusedTextBox() or (F.isListening and F.isListening()))
	X.zUsed = false
end))
F.track(UIS.InputChanged:Connect(function(i)
	if i.UserInputType == Enum.UserInputType.MouseWheel and UIS:IsKeyDown(KC.Z) then X.zUsed = true end
end))
F.track(UIS.InputEnded:Connect(function(i)
	if i.KeyCode ~= KC.Z then return end
	local go = X.zArmed and not X.zUsed
	X.zArmed = false
	if go and not V.closing then F.toggleFaceNearest() end
end))

