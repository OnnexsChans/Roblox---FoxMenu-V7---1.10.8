---------------------------------------------------------------- ASSISTÊNCIA DE MIRA (aba Câmera)
-- Gira a câmera suavemente até a cabeça do jogador mais próximo do centro da mira dentro do círculo.
-- Detecta sozinho: 1ª pessoa · 3ª pessoa com mouse livre · 3ª pessoa com Shift Lock (inclusive ao rolar o scroll).
do
	local A = { on = false, power = 60, mode = "Sempre ligado", key = "Botão direito", hotkey = "", part = "Cabeça",
		prio = "Mais perto do centro da mira", fov = 150, dist = 500, pred = 0, team = true, wall = true, alive = true,
		ignFr = false, sticky = false, fp = true, free = true, lock = true, showFov = true, showMark = true, hl = false,
		cur = nil, cap = false, fr = {}, cm = "free" }
	X.aim = A
	local DEF = { power = 60, mode = "Sempre ligado", key = "Botão direito", hotkey = "", part = "Cabeça", prio = "Mais perto do centro da mira",
		fov = 150, dist = 500, pred = 0, team = true, wall = true, alive = true, ignFr = false, sticky = false, fp = true, free = true,
		lock = true, showFov = true, showMark = true, hl = false }
	for k, v in pairs(S.aim or {}) do if DEF[k] ~= nil and type(v) == type(DEF[k]) then A[k] = v end end
	local MODES = { "Sempre ligado", "Segurar tecla" }
	local KEYS = {
		["Botão direito"] = { t = Enum.UserInputType.MouseButton2 }, ["Botão esquerdo"] = { t = Enum.UserInputType.MouseButton1 },
		["Shift esquerdo"] = { k = KC.LeftShift }, ["Alt esquerdo"] = { k = KC.LeftAlt }, ["E"] = { k = KC.E }, ["Q"] = { k = KC.Q } }
	local KEY_ORDER = { "Botão direito", "Botão esquerdo", "Shift esquerdo", "Alt esquerdo", "E", "Q" }
	local PARTS = { "Cabeça", "Peito", "Centro do corpo", "Parte mais próxima da mira" }
	local PRIOS = { "Mais perto do centro da mira", "Mais perto de você", "Menor vida" }
	local CM_NAME = { fp = "Primeira pessoa", lock = "3ª pessoa · Shift Lock", free = "3ª pessoa · mouse livre" }
	local function opt(k, v) A[k] = v S.aim = S.aim or {} S.aim[k] = v F.save() end
	local function slot(list, v) return table.find(list, v) or 1 end

	local rp = RaycastParams.new()
	rp.FilterType, rp.RespectCanCollide = Enum.RaycastFilterType.Exclude, true
	local ring, ringK, dot, mark, hlObj
	local function ui()
		if ring and ring.Parent then return end
		ring = F.new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, Visible = false, ZIndex = 5, R = UDim.new(1, 0), Name = "AimFov" }, gui)
		ringK = Instance.new("UIStroke", ring)
		ringK.Thickness = 2
		dot = F.new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = U2o(4, 4), BackgroundColor3 = C3(255, 255, 255), BorderSizePixel = 0, Visible = false, ZIndex = 5, R = 2, Name = "AimDot" }, gui)
		mark = F.new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = U2o(12, 12), BackgroundTransparency = 1, Visible = false, ZIndex = 6, R = 6, Name = "AimMark" }, gui)
		local mk = Instance.new("UIStroke", mark)
		mk.Color, mk.Thickness = C3(255, 70, 70), 2
	end
	local function hideUi()
		if ring then ring.Visible, dot.Visible, mark.Visible = false, false, false end
	end
	-- detecção automática do modo de câmera (reavaliada todo quadro: scroll e Shift Lock são pegos na hora)
	local function camMode(cam)
		if player.CameraMode == Enum.CameraMode.LockFirstPerson or (cam.CFrame.Position - cam.Focus.Position).Magnitude < 1.6 then return "fp" end
		if UIS.MouseBehavior == Enum.MouseBehavior.LockCenter then return "lock" end
		return "free"
	end
	local function center(cam)
		if UIS.MouseBehavior == Enum.MouseBehavior.LockCenter then
			return Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
		end
		return UIS:GetMouseLocation()
	end
	local function held()
		local s = KEYS[A.key]
		if not s then return false end
		if s.t then return UIS:IsMouseButtonPressed(s.t) end
		return UIS:IsKeyDown(s.k)
	end
	local function overMenu(c)
		if V.hidden or V.minimized or not main.Visible then return false end
		local p, s = main.AbsolutePosition, main.AbsoluteSize
		return c.X >= p.X and c.X <= p.X + s.X and c.Y >= p.Y and c.Y <= p.Y + s.Y
	end
	local function checkFriend(p)
		if A.fr[p.UserId] ~= nil then return A.fr[p.UserId] end
		A.fr[p.UserId] = false
		task.spawn(function()
			local ok, r = pcall(function() return player:IsFriendsWith(p.UserId) end)
			A.fr[p.UserId] = ok and r or false
		end)
		return false
	end
	local function pickPart(ch, cam, c)
		local n = A.part
		if n == "Cabeça" then return ch:FindFirstChild("Head") end
		if n == "Peito" then return ch:FindFirstChild("UpperTorso") or ch:FindFirstChild("Torso") end
		if n == "Centro do corpo" then return ch:FindFirstChild("HumanoidRootPart") end
		local best, bd
		for _, pn in ipairs({ "Head", "UpperTorso", "Torso", "LowerTorso", "HumanoidRootPart" }) do
			local pt = ch:FindFirstChild(pn)
			if pt then
				local sp, on = cam:WorldToViewportPoint(pt.Position)
				local d = on and (Vector2.new(sp.X, sp.Y) - c).Magnitude
				if d and (not bd or d < bd) then best, bd = pt, d end
			end
		end
		return best
	end
	-- devolve (pontuação, posição-alvo, personagem, ponto na tela) ou nil se não for um alvo válido dentro do círculo
	local function eval(p, cam, c)
		local ch = p.Character
		local hm = ch and ch:FindFirstChildOfClass("Humanoid")
		local root = ch and ch:FindFirstChild("HumanoidRootPart")
		if not (hm and root) or (A.alive and hm.Health <= 0) then return end
		if A.team and p.Team ~= nil and p.Team == player.Team then return end
		if A.ignFr and checkFriend(p) then return end
		local origin = cam.CFrame.Position
		local dist = (root.Position - origin).Magnitude
		if dist > A.dist then return end
		local pt = pickPart(ch, cam, c)
		if not pt then return end
		local pos = pt.Position + root.AssemblyLinearVelocity * (A.pred / 1000)
		local sp, on = cam:WorldToViewportPoint(pos)
		if not on then return end
		local sv = Vector2.new(sp.X, sp.Y)
		local d2 = (sv - c).Magnitude
		if d2 > A.fov then return end
		if A.wall then
			rp.FilterDescendantsInstances = { player.Character, ch }
			if workspace:Raycast(origin, pt.Position - origin, rp) then return end
		end
		local score = A.prio == "Mais perto de você" and dist or A.prio == "Menor vida" and hm.Health or d2
		return score, pos, ch, sv
	end
	local function setHl(ch)
		if not A.hl or not ch then if hlObj then hlObj.Adornee = nil end return end
		if not (hlObj and hlObj.Parent) then
			hlObj = Instance.new("Highlight")
			hlObj.FillTransparency, hlObj.OutlineTransparency, hlObj.DepthMode = 1, 0, Enum.HighlightDepthMode.AlwaysOnTop
			hlObj.OutlineColor, hlObj.Parent = C3(255, 70, 70), gui
		end
		hlObj.Adornee = ch
	end
	local lastCm
	local function step(dt)
		ui()
		local cam = F.CAM()
		if V.closing or not A.on or not cam then hideUi() setHl(nil) return end
		local cm = camMode(cam)
		if cm ~= lastCm then
			lastCm, A.cur = cm, nil
			if V.I.aim_cm then V.I.aim_cm(CM_NAME[cm]) end
		end
		A.cm = cm
		local c = center(cam)
		local modeOn = A[cm]
		ring.Visible, dot.Visible = A.showFov, A.showFov
		ring.Size, ring.Position, dot.Position = U2o(A.fov * 2, A.fov * 2), U2o(c.X, c.Y), U2o(c.X, c.Y)
		local active = modeOn and (A.mode == "Sempre ligado" or held())
			and not UIS:GetFocusedTextBox() and F.root() and not overMenu(c)
		-- procura o alvo: o jogador válido mais perto do centro da mira dentro do círculo
		local tp, tch, tsv
		if active then
			if A.sticky and A.cur and A.cur.Parent then
				local sc, pos, ch, sv = eval(A.cur, cam, c)
				if sc then tp, tch, tsv = pos, ch, sv end
			end
			if not tp then
				local bs, bp
				A.cur = nil
				for _, p in ipairs(Players:GetPlayers()) do
					if p ~= player then
						local sc, pos, ch, sv = eval(p, cam, c)
						if sc and (not bs or sc < bs) then bs, bp, tp, tch, tsv = sc, p, pos, ch, sv end
					end
				end
				A.cur = bp
			end
		else
			A.cur = nil
		end
		-- indicação visual: branco = parado · vermelho = alvo travado · apagado = modo de câmera desligado
		ringK.Color = tp and C3(255, 70, 70) or C3(255, 255, 255)
		ringK.Transparency = tp and 0.05 or (modeOn and 0.45 or 0.8)
		dot.BackgroundColor3 = tp and C3(255, 70, 70) or C3(255, 255, 255)
		mark.Visible = A.showMark and tp ~= nil
		if tsv then mark.Position = U2o(tsv.X, tsv.Y) end
		setHl(tp and tch or nil)
		if not tp then return end
		-- gira a câmera para que o ponto sob a mira vá até a cabeça do alvo (vale para mouse livre, Shift Lock e 1ª pessoa)
		local rate = math.clamp(A.power / 100, 0, 0.999)
		if rate <= 0 then return end
		local cf = cam.CFrame
		local ray = cam:ViewportPointToRay(c.X, c.Y).Direction
		local want = (tp - cf.Position).Unit
		local ang = math.acos(math.clamp(ray:Dot(want), -1, 1))
		local axis = ray:Cross(want)
		if ang < 1e-4 or axis.Magnitude < 1e-6 then return end
		local a = 1 - math.pow(1 - rate, dt * 60)
		cam.CFrame = CFrame.new(cf.Position) * CFrame.fromAxisAngle(axis.Unit, ang * a) * (cf - cf.Position)
	end
	function F.setAim(on)
		A.on, A.cur, lastCm = on, nil, nil
		pcall(function() RS:UnbindFromRenderStep("FoxAimAssist") end)
		if on then
			RS:BindToRenderStep("FoxAimAssist", Enum.RenderPriority.Camera.Value + 1, step)
		else
			hideUi() setHl(nil)
		end
	end
	local function hkText() return A.hotkey ~= "" and A.hotkey or "Nenhuma" end
	F.track(UIS.InputBegan:Connect(function(i, gp)
		if i.UserInputType ~= Enum.UserInputType.Keyboard or V.closing then return end
		if A.cap then -- capturando a nova tecla de atalho
			A.cap = false
			if i.KeyCode == KC.Escape then F.toast("Atalho cancelado") return end
			opt("hotkey", i.KeyCode.Name)
			if V.I.aim_hk then V.I.aim_hk(hkText()) end
			F.toast("Atalho da mira: " .. hkText(), "ok")
			return
		end
		if gp or A.hotkey == "" or i.KeyCode.Name ~= A.hotkey or UIS:GetFocusedTextBox() then return end
		local r = Reg.aim
		if r then
			r.set(not r.get())
			F.toast("Assistência de mira  ·  " .. (r.get() and "ligada" or "desligada"))
		end
	end))
	F.track(Players.PlayerRemoving:Connect(function(p) A.fr[p.UserId] = nil if A.cur == p then A.cur = nil end end))

