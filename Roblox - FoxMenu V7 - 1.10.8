-- ===== flashback (voltar no tempo) =====
-- Grava, a cada 0,02 s (até 120 s), a posição E as animações em execução (id · tempo · peso).
-- Ao rebobinar, a posição é restaurada e as MESMAS animações originais (andar, pular, cair...) são reproduzidas no tempo gravado.
X.fbT, X.fbOwn = {}, setmetatable({}, { __mode = "k" })
X.fbCur, X.fbFrac = nil, 0
-- <<< AJUSTE AQUI: velocidade da rebobinagem ao segurar V (1 = tempo real · antes era ~2,4x). Maior = mais rápido.
X.FB_SPEED = 1.5
function F.fbReset(force)
	if X.fbPlaying or force then
		X.fbPlaying = false
		for _, tk in pairs(X.fbT) do pcall(function() if tk.IsPlaying then tk:Stop(0.12) end end) end
	end
end
function F.fbSnap(r, hum)
	local a, n = {}, 0
	local an = hum:FindFirstChildOfClass("Animator")
	if an then
		for _, t in ipairs(an:GetPlayingAnimationTracks()) do
			if not X.fbOwn[t] then
				local w = t.WeightCurrent
				local id = t.Animation and t.Animation.AnimationId
				if w > 0.02 and id and id ~= "" then
					a[n + 1], a[n + 2], a[n + 3] = id, t.TimePosition, w
					n += 3
				end
			end
		end
	end
	return { cf = r.CFrame, a = a }
end
function F.fbAnim(hum, f)
	local an = hum:FindFirstChildOfClass("Animator")
	if not an then return end
	if X.fbAn ~= an then X.fbT, X.fbAn = {}, an end
	local used, a = {}, f.a
	for i = 1, #a, 3 do
		local id = a[i]
		local tk = X.fbT[id]
		if not tk then
			local anim = Instance.new("Animation")
			anim.AnimationId = id
			local ok, t = pcall(function() return an:LoadAnimation(anim) end)
			if ok and t then
				t.Priority = Enum.AnimationPriority.Action4
				X.fbOwn[t] = true
				X.fbT[id], tk = t, t
			end
		end
		if tk then
			used[tk] = true
			local w = math.max(a[i + 2], 0.01)
			if not tk.IsPlaying then tk:Play(0, w, 0) end
			tk:AdjustSpeed(0)
			local len = tk.Length
			tk.TimePosition = len > 0 and math.min(a[i + 1], len) or a[i + 1]
			tk:AdjustWeight(w, 0)
		end
	end
	for _, tk in pairs(X.fbT) do
		if not used[tk] and tk.IsPlaying then tk:Stop(0.08) end
	end
	X.fbPlaying = true
end
function F.setFlash(on)
	if X.fbC then X.fbC:Disconnect() X.fbC = nil end
	F.fbReset(true)
	X.fbT, X.fbAn = {}, nil
	X.fb, X.fbRew, X.fbChar = {}, false, nil
	X.fbCur, X.fbFrac = nil, 0
	local h = aliveHum()
	if h and X.fbAR then h.AutoRotate = true end
	X.fbAR = false
	if not on then return end
	local acc = 0
	X.fbC = RS.Heartbeat:Connect(function(dt)
		local r, hum = F.root(), aliveHum()
		if not (r and hum) then return end
		if X.fbChar ~= player.Character then -- personagem trocado (respawn): começa um buffer novo
			X.fbChar, X.fb = player.Character, {}
			X.fbCur, X.fbFrac = nil, 0
			F.fbReset(true)
		end
		local fr = X.fb
		if X.fbRew and #fr > 0 then
			-- avanço fracionado (velocidade × tempo) + interpolação entre dois quadros gravados = rebobinagem suave
			X.fbFrac += dt / 0.02 * X.FB_SPEED
			local steps = math.floor(X.fbFrac)
			X.fbFrac -= steps
			if not X.fbCur then X.fbCur = table.remove(fr) end
			for _ = 1, steps do
				local f = table.remove(fr)
				if not f then break end
				X.fbCur = f
			end
			local cur = X.fbCur
			if cur then
				local nxtF = fr[#fr]
				r.CFrame = nxtF and cur.cf:Lerp(nxtF.cf, X.fbFrac) or cur.cf
				r.AssemblyLinearVelocity, r.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
				F.fbAnim(hum, cur)
			end
			hum.AutoRotate, X.fbAR = false, true
		else
			X.fbCur, X.fbFrac = nil, 0
			if X.fbAR then hum.AutoRotate, X.fbAR = true, false end
			F.fbReset()
			if X.fbRew then X.fbRew = false if Reg.flashrew then Reg.flashrew.set(false, true) end end
			acc += dt
			while acc >= 0.02 do
				acc -= 0.02
				fr[#fr + 1] = F.fbSnap(r, hum)
				if #fr > 6000 then table.remove(fr, 1) end
			end
		end
	end)
end

