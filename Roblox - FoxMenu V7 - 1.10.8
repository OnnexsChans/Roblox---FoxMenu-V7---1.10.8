function F.tile(parent, id, order)
	local e = Ent[id]
	if not e then return end
	local b = F.new("TextButton", { BackgroundColor3 = C.item, Text = "", AutoButtonColor = false, LayoutOrder = order, R = 14, S = 1 }, parent)
	F.interactive(b, "item", "hover")
	local ic = F.txt(b, F.icon(e), { Size = U2o(32, 28), Position = U2o(10, 6), TextSize = 20, Font = EF.GothamBold })
	local nm = F.txt(b, e.short, { Size = U2(1, -16, 0, 28), Position = U2(0, 10, 1, -32), TextSize = 11, TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top, TextTruncate = Enum.TextTruncate.None })
	b.MouseEnter:Connect(function() F.tw(ic, { TextSize = 25 }, 0.18, BACK) end)
	b.MouseLeave:Connect(function() F.tw(ic, { TextSize = 20 }, 0.2) end)
	local dot = F.new("Frame", { Size = U2o(8, 8), Position = U2(1, -18, 0, 10), BackgroundColor3 = C.off, BorderSizePixel = 0, R = 4, Visible = e.kind == "toggle" }, b)
	b.MouseButton1Click:Connect(function() F.click() F.activate(id) end)
	b.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton2 then F.toggleFav(id) end end)
	V.tiles[#V.tiles + 1] = { btn = b, id = id, dot = dot, nm = nm, ic = ic }
end
F.rebuildHome = function()
	for _, t in ipairs(V.tiles) do t.btn:Destroy() end
	V.tiles = {}
	if not V.favGrid then return end
	local seen = {}
	for i, id in ipairs(S.favs) do F.tile(V.favGrid, id, i) seen[id] = true end
	local n = 0
	for _, id in ipairs(S.recent) do
		if not seen[id] and n < 6 then n += 1 F.tile(V.recGrid, id, n) end
	end
	if #S.favs == 0 and V.favHint == nil then
		V.favHint = F.note(pg["Início"], "Clique com o botão direito em qualquer opção (ou use ★ na busca) para fixá-la aqui.", 34)
		V.favHint.LayoutOrder = 3
	elseif V.favHint then
		V.favHint.Visible = #S.favs == 0
	end
end

