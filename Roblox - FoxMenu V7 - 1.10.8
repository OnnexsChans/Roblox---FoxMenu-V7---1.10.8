function F.hgHide(g)
	if not g:IsA("ScreenGui") or g == gui or g:IsDescendantOf(gui) or X.hgKeep[g.Name] or X.hg.orig[g] ~= nil then return end
	X.hg.orig[g] = g.Enabled
	X.hg.cn[g] = g:GetPropertyChangedSignal("Enabled"):Connect(function()
		if X.hg.on and g.Enabled then X.hg.orig[g] = true g.Enabled = false end -- o jogo reabriu: guarda e esconde de novo
	end)
	g.Enabled = false
end
function F.setHideGui(on)
	local h = X.hg
	if on == h.on then return end
	h.on = on
	if on then
		for _, g in ipairs(playerGui:GetChildren()) do F.hgHide(g) end
		h.add = playerGui.ChildAdded:Connect(F.hgHide)
	else
		if h.add then h.add:Disconnect() h.add = nil end
		for g, v in pairs(h.orig) do
			if h.cn[g] then h.cn[g]:Disconnect() end
			if g.Parent then g.Enabled = v end
		end
		h.orig, h.cn = {}, {}
	end
end
