	local t, prog, target, fcR, lastPct = 0, 0, 0, 0, -1
	local rot = RS.RenderStepped:Connect(function(dt)
		t += dt
		fcR += 1
		grad.Rotation = (grad.Rotation + dt * 240) % 360
		grad2.Rotation = (grad2.Rotation - dt * 150) % 360
		local g = 320 + math.sin(t * 2) * 18
		glow.Size = U2o(g, g)
		local mp, vs = UIS:GetMouseLocation(), F.CAM().ViewportSize
		fox.Position = at(FOXY + math.sin(t * 2.2) * 3 + (mp.Y / vs.Y - 0.5) * 10, (mp.X / vs.X - 0.5) * 16)
		if math.abs(target - prog) > 0.0004 then
			prog += (target - prog) * math.min(1, dt * 6)
			fill.Size = UDim2.fromScale(math.clamp(prog, 0, 1), 1)
			local pc = math.floor(prog * 100 + 0.5)
			if pc ~= lastPct then lastPct = pc pct.Text = pc .. "%" end -- antes: reescrevia o texto todo quadro
		end
		shim.Offset = Vector2.new(-1 + (t * 1.1) % 2, 0)
		for n, p in ipairs(ps) do
			p.y -= p.v * dt
			if p.y < -0.05 then p.y, p.x = 1.05, math.random() end
			p.f.Position = U2(p.x + math.sin(t + p.ph) * 0.01, 0, p.y, 0)
			if (fcR + n) % 3 == 0 then -- o brilho pisca devagar: basta atualizar a cada 3 quadros (cada brasa em um quadro diferente)
				p.f.BackgroundTransparency = 0.55 + 0.35 * math.abs(math.sin(t * 0.8 + p.ph))
			end
		end
	end)
	local sk
	local function finish()
		if over then return end
		over = true
		V.intro = false
		pcall(function() rot:Disconnect() end)
		pcall(function() bgc:Disconnect() end)
		pcall(function() boom() shock(FOX.l, 150, 1400, 2, 0.6) F.snd("whoosh", 1.2) end)
		if sk then pcall(function() sk:Disconnect() end) end
		pcall(function() F.chime(1, 1.26, 1.5) end)
		pcall(function()
			target, prog = 1, 1
			fill.Size = UDim2.fromScale(1, 1)
			F.tw(zoom, { Scale = 1.12 }, 0.65, QUINT)
			F.tw(cg, { GroupTransparency = 1 }, 0.5)
			F.tw(sp, { BackgroundTransparency = 1 }, 0.65)
			F.tw(skipB, { BackgroundTransparency = 1, TextTransparency = 1 }, 0.25)
		end)
		task.delay(0.2, function() if done then done() end end) -- o menu surge enquanto a abertura se dissolve
		task.delay(0.85, function() sp:Destroy() end)
	end
	sk = UIS.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.Keyboard and i.KeyCode ~= KC.Unknown then skip = true end
	end)
	task.delay(10, finish) -- seguro: se algo der errado, a tela de abertura some sozinha
	task.spawn(function()
		local ok, err = pcall(function()
			F.tw(sp, { BackgroundTransparency = 0 }, 0.45)
			F.tw(skipB, { BackgroundTransparency = 0.15, TextTransparency = 0 }, 0.5)
			wait2(0.55)
			F.tw(zoom, { Scale = 1 }, 1.2, QUINT)
			F.snd("whoosh", 0.8)
			F.snd("open", 0.9)
			F.tw(foxScale, { Scale = 1 }, 0.9, BACK)
			task.delay(0.35, function() boom() shock(FOX.o, 100, 760, 3, 0.9) shock(FOX.l, 80, 520, 1.5, 0.7) F.snd("pop", 0.6) end)
			F.tw(glow, { BackgroundTransparency = 0.93 }, 1)
			F.tw(stroke, { Transparency = 0 }, 0.6)
			F.tw(stroke2, { Transparency = 0.5 }, 0.9)
			wait2(0.7)
			F.blink(fp)
			F.tw(fp.earL, { Rotation = 36 }, 0.12) F.tw(fp.earR, { Rotation = 54 }, 0.12)
			task.delay(0.14, function() F.tw(fp.earL, { Rotation = 45 }, 0.22, BACK) F.tw(fp.earR, { Rotation = 45 }, 0.22, BACK) end)
			wait2(0.4)
			for n, l in ipairs(letters) do
				if skip then break end
				local base = l.Position
				l.Position = base + U2o(0, 22)
				F.tw(l, { TextTransparency = 0, Position = base }, 0.45, BACK)
				F.snd("ok", 0.7 + n * 0.08)
				wait2(0.07)
			end
			for n, l in ipairs(letters) do
				task.delay(n * 0.05, function()
					local c0 = l.TextColor3
					F.tw(l, { TextColor3 = C3(255, 236, 196) }, 0.12)
					task.delay(0.14, function() F.tw(l, { TextColor3 = c0 }, 0.3) end)
				end)
			end
			F.snd("whoosh", 1.5)
			F.tw(sub, { TextTransparency = 0 }, 0.4)
			F.tw(bar, { BackgroundTransparency = 0 }, 0.3)
			F.tw(stat, { TextTransparency = 0 }, 0.3) F.tw(pct, { TextTransparency = 0 }, 0.3)
			wait2(0.2)
			for _, stg in ipairs({ { "Acordando a raposa", 0.2 }, { "Carregando módulos", 0.45 }, { "Montando a interface", 0.72 }, { "Aplicando preferências", 0.92 }, { "Pronto", 1 } }) do
				if skip then break end
				stat.Text, target = stg[1], stg[2]
				wait2(0.42)
			end
			F.snd("on", 1.1)
			wait2(0.3)
		end)
		if not ok then warn("[FoxMenu] intro:", err) end
		finish()
	end)
end

---------------------------------------------------------------- MÚSICA (uma única lista de áudio que toca só para você)
-- Tudo dentro de "do ... end" e poucas variáveis locais, para não estourar o limite de 200 locals do script.
do
	local MU = { idx = 0, token = 0, active = false, snd = nil, cur = nil, q = {}, view = {}, pool = {}, seen = {}, filter = "",
		busy = {}, peers = {}, DIR = "FoxMenu_musicas", ROW = 40, POOL = 10 }
	S.music = type(S.music) == "table" and S.music or {}
	local MS = S.music
	MS.list = type(MS.list) == "table" and MS.list or {}
	MS.pls, MS.sel, MS.conv = nil, nil, nil -- sistema de playlists e conversor do YouTube removidos
	MS.nid = tonumber(MS.nid) or 0
	MS.vol = math.clamp(tonumber(MS.vol) or 0.5, 0, 1)
	if MS.chat == nil then MS.chat = true end
	if MS.hideTagSelf == nil then MS.hideTagSelf = (MS.tagSelf == false) end
	for _, k in ipairs({ "hideBubSelf", "hideChatSelf", "hideBubOthers", "hideChatOthers", "hideTagOthers" }) do
		MS[k] = MS[k] == true
	end
	if type(MS.fmt) ~= "string" or MS.fmt == "" or MS.fmt == "🎵 | Tocando: {nome} ▁▃▅▇▅▃▁" or MS.fmt == "🎵 | Tocando: {nome} ♪♫" then MS.fmt = "🎵 | Tocando: {nome}" end
	-- migração: músicas da versão antiga ganham um id
	for _, sg in ipairs(MS.list) do
		if type(sg.id) ~= "number" then MS.nid += 1 sg.id = MS.nid end
		sg.name, sg.link = tostring(sg.name or "Música"), tostring(sg.link or "")
		MS.nid = math.max(MS.nid, sg.id)
	end
	MU.getAsset = getcustomasset or getsynasset
	MU.req = request or http_request or (syn and syn.request) or (http and http.request)

	function MU.byId()
		if not MU._by then
			local by = {}
			for _, sg in ipairs(MS.list) do by[sg.id] = sg end
			MU._by = by
		end
		return MU._by
	end

	function MU.can() return (writefile and readfile and isfile and MU.getAsset) and true or false end
	function MU.hash(s)
		local h = 5381
		for i = 1, #s do h = (h * 33 + s:byte(i)) % 4294967296 end
		return string.format("%08x", h)
	end
	function MU.isWeb(l) return l:match("^https?://") ~= nil end
	function MU.isYT(l) return (l:find("youtube.com", 1, true) or l:find("youtu.be", 1, true)) ~= nil end -- só para avisar: link do YouTube não é áudio
	function MU.path(m)
		if MU.isWeb(m.link) then return MU.DIR .. "/" .. MU.hash(m.link) .. ".mp3" end
		local ok, has = pcall(isfile, MU.DIR .. "/" .. m.link)
		if ok and has then return MU.DIR .. "/" .. m.link end
		return m.link
	end
	function MU.cached(m)
		if not isfile then return false end
		local ok, r = pcall(isfile, MU.path(m))
		return ok and r and true or false
	end
	function MU.ft(t) t = math.floor(t or 0) return string.format("%d:%02d", t // 60, t % 60) end
	function MU.state() return (not MU.snd and "Parada") or (MU.snd.IsPaused and "Pausada") or "Tocando" end
	function MU.setStatus(s) if MU.statusL and MU.statusL.Parent then MU.statusL.Text = s end end
	function MU.refreshTags() if F.TG and F.TG.render then pcall(F.TG.render) end end

	-- devolve o caminho do arquivo pronto (baixando se precisar), ou nil + motivo
	function MU.fetch(m)
		if not MU.can() then return nil, "seu executor não tem writefile/getcustomasset" end
		pcall(function() if makefolder and isfolder and not isfolder(MU.DIR) then makefolder(MU.DIR) end end)
		local p = MU.path(m)
		if MU.cached(m) then return p end
		if not MU.isWeb(m.link) then return nil, "arquivo não encontrado: " .. m.link end
		if not MU.req then return nil, "seu executor não tem request()" end
		if MU.busy[p] then
			local t0 = os.clock()
			while MU.busy[p] and os.clock() - t0 < 60 do task.wait(0.2) end
			if MU.cached(m) then return p end
			return nil, "download falhou"
		end
		MU.busy[p] = true
		local bytes, why
		local okp, e = pcall(function()
			local url = m.link
			if MU.isYT(url) then why = "link do YouTube não toca: use o link direto de um .mp3" return end
			local r = MU.req({ Url = url, Method = "GET" })
			if not r or r.StatusCode ~= 200 or not r.Body then why = "download falhou (código " .. tostring(r and r.StatusCode) .. ")" return end
			bytes = r.Body
		end)
		if not okp then why = "erro: " .. tostring(e) end
		if bytes then
			local head = bytes:sub(1, 20):lower()
			if #bytes < 2048 then bytes, why = nil, "arquivo pequeno demais (o link não é áudio direto?)"
			elseif head:find("<!doctype", 1, true) or head:find("<html", 1, true) then bytes, why = nil, "o link abriu uma página, não um áudio" end
		end
		if bytes then
			local okw = pcall(writefile, p, bytes)
			if not okw then bytes, why = nil, "não consegui salvar o arquivo" end
		end
		MU.busy[p] = nil
		if bytes then return p end
		return nil, why or "download falhou"
	end

	function MU.say(name, dur)
		if not MS.chat then return end
		local n = utf8.len(name)
		if n and n > 60 then name = name:sub(1, utf8.offset(name, 61) - 1) .. "…" end
		local msg = (MS.fmt:gsub("{nome}", function() return name end))
		msg = (msg:gsub("{tempo}", function() return MU.ft(dur or 0) end))
		msg = msg .. F.musicEncode()
		pcall(function()
			local TCS = game:GetService("TextChatService")
			if TCS.ChatVersion == Enum.ChatVersion.TextChatService then
				local ch = TCS.TextChannels:FindFirstChild("RBXGeneral")
				if ch then ch:SendAsync(msg) return end
			end
			local ev = game:GetService("ReplicatedStorage"):FindFirstChild("DefaultChatSystemChatEvents")
			ev = ev and ev:FindFirstChild("SayMessageRequest")
			if ev then ev:FireServer(msg, "All") end
		end)
	end

	------------------------------------------------------------ lista virtual (só ~10 linhas existem, não importa o tamanho da lista)
	function MU.styleRow(row)
		local sg, f, nb, b = row.song, row.f, row.n, row.b
		if not sg then return end
		local cur = MU.active and MU.cur == sg
		local mv = MU.filter == ""
		nb.Size = U2(1, mv and -112 or -48, 1, 0)
		nb.Text = (cur and "▶ " or (MU.cached(sg) and "✓ " or "⬇ ")) .. row.ri .. ". " .. sg.name
		nb.TextColor3 = cur and C.white or C.text
		nb.Font = cur and EF.GothamBold or EF.GothamMedium
		f.BackgroundColor3 = cur and C.hover or C.panel
		b[1].Visible, b[2].Visible, b[3].Visible = true, mv, mv
		b[1].Text, row.armed = "X", nil
	end
	function MU.restyle() for _, row in ipairs(MU.pool) do if row.ri > 0 then MU.styleRow(row) end end end
	MU.mark = MU.restyle
	MU.markAll = MU.restyle

	function MU.bind(row, ri)
		row.ri, row.song = ri, MU.view[ri]
		row.f.Position = UDim2.fromOffset(0, (ri - 1) * MU.ROW)
		row.f.Visible = true
		MU.styleRow(row)
	end
	function MU.update()
		local sc = MU.sc
		if not (sc and sc.Parent) then return end
		local n, POOL = #MU.view, MU.POOL
		local first = math.max(1, math.floor(sc.CanvasPosition.Y / MU.ROW) + 1)
		local last = math.min(n, first + POOL - 1)
		for ri = first, last do
			local row = MU.pool[(ri - 1) % POOL + 1]
			if row.ri ~= ri then MU.bind(row, ri) end
		end
		for _, row in ipairs(MU.pool) do
			if row.ri > 0 and (row.ri < first or row.ri > last) then row.ri, row.song = 0, nil row.f.Visible = false end
		end
	end

	function MU.getView()
		local q = MU.filter
		if q == "" then return MS.list end
		local out = {}
		for _, sg in ipairs(MS.list) do if sg.name:lower():find(q, 1, true) then out[#out + 1] = sg end end
		return out
	end
	function MU.setHeader()
		if not (MU.hdrL and MU.hdrL.Parent) then return end
		MU.hdrL.Text = ("Sua lista · %d %s"):format(#MS.list, #MS.list == 1 and "música" or "músicas")
	end
	function MU.refreshView(top)
		MU.view = MU.getView()
		local sc = MU.sc
		if not (sc and sc.Parent) then return end
		local n = #MU.view
		sc.CanvasSize = UDim2.fromOffset(0, n * MU.ROW)
		if top then sc.CanvasPosition = Vector2.zero end
		for _, row in ipairs(MU.pool) do row.ri = 0 end
		MU.update()
		if MU.emptyL then
			MU.emptyL.Visible = n == 0
			if MU.filter ~= "" then MU.emptyL.Text = "Nenhuma música encontrada."
			else MU.emptyL.Text = "Lista vazia. Adicione uma música na seção abaixo." end
		end
		MU.setHeader()
	end

	------------------------------------------------------------ lista
	function MU.guessName(link)
		local s = link:gsub("%?.*$", ""):match("([^/\\]+)$") or link
		s = s:gsub("%.%w+$", ""):gsub("%%20", " "):gsub("_", " ")
		return s ~= "" and s or ("Música " .. (#MS.list + 1))
	end
	function MU.add(name, link)
		name, link = (name or ""):match("^%s*(.-)%s*$"), (link or ""):match("^%s*(.-)%s*$")
		if link == "" then F.toast("Cole o link (ou o nome do arquivo .mp3)", "err") return false end
		if MU.isYT(link) then F.toast("Link do YouTube não toca: use o link direto de um .mp3", "err") return false end
		for _, x in ipairs(MS.list) do
			if x.link == link then F.toast("Essa música já está na lista", "err") return false end -- mesmo link = mesma música
		end
		if name == "" then name = MU.guessName(link) end
		MS.nid += 1
		MS.list[#MS.list + 1] = { id = MS.nid, name = name, link = link }
		MU._by = nil
		F.toast("Adicionada: " .. name, "ok")
		F.save()
		MU.refreshView()
		if MU.sc and MU.filter == "" then MU.sc.CanvasPosition = Vector2.new(0, 1e6) end -- rola até a nova
		return true
	end
	function MU.deleteSong(sg)
		local i = table.find(MS.list, sg)
		if not i then return end
		if MU.cur == sg then MU.stop() MU.cur, MU.idx = nil, 0 end
		table.remove(MS.list, i)
		sg.del = true
		MU._by = nil
		F.save()
		MU.refreshView()
	end
	function MU.move(ri, d)
		if MU.filter ~= "" then return end
		local arr = MS.list
		local j = ri + d
		if j < 1 or j > #arr then return end
		arr[ri], arr[j] = arr[j], arr[ri]
		F.save()
		MU.refreshView()
	end
	function MU.rowClick(row)
		if row.song then MU.playView(row.ri) end
	end
	function MU.rowAct(row, which)
		local sg = row.song
		if not sg then return end
		if which == 1 then
			if not row.armed or os.clock() > row.armed then -- apagar pede um segundo toque
				row.armed = os.clock() + 2.5
				row.b[1].Text = "?"
				task.delay(2.6, function()
					if row.song == sg and row.armed and os.clock() > row.armed then row.armed = nil row.b[1].Text = "X" end
				end)
				return
			end
			row.armed = nil
			MU.deleteSong(sg)
		elseif which == 2 then MU.move(row.ri, 1)
		else MU.move(row.ri, -1) end
	end

	------------------------------------------------------------ player
	function MU.updPlayBtn() if MU.playB then MU.playB.Text = (MU.snd and not MU.snd.IsPaused) and "⏸" or "▶" end end
	function MU.resetBar()
		if MU.pfill then MU.pfill.Size = U2(0, 0, 1, 0) end
		if MU.t1 then MU.t1.Text, MU.t2.Text = "0:00", "0:00" end
	end
	function MU.stopSound()
		if MU.snd then pcall(function() MU.snd:Stop() MU.snd:Destroy() end) MU.snd = nil end
	end
	function MU.stop()
		MU.token += 1
		MU.stopSound()
		MU.active = false
		MU.setStatus("Parada") MU.resetBar() MU.updPlayBtn() MU.restyle() MU.refreshTags()
	end

	function MU.nextIndex(auto)
		local q = MU.q
		local n = #q
		if n == 0 then return nil end
		if MS.shuffle and n > 1 then -- aleatório sem repetir até todas tocarem
			local pool = {}
			for k, sg in ipairs(q) do if not sg.del and not MU.seen[sg] and k ~= MU.idx then pool[#pool + 1] = k end end
			if #pool == 0 then
				if auto and not MS.loop then return nil end
				MU.seen = {}
				for k, sg in ipairs(q) do if not sg.del and k ~= MU.idx then pool[#pool + 1] = k end end
				if #pool == 0 then return nil end
			end
			return pool[math.random(#pool)]
		end
		local j = MU.idx
		for _ = 1, n do
			j += 1
			if j > n then
				if MS.loop or not auto then j = 1 else return nil end
			end
			if not q[j].del then return j end
		end
		return nil
	end

	function MU.play(i)
		local m = MU.q[i]
		if not m or m.del then return end
		MU.token += 1
		local tk = MU.token
		MU.stopSound()
		MU.idx, MU.cur, MU.active = i, m, true
		MU.seen[m] = true
		MU.restyle()
		if MU.titleL then MU.titleL.Text = m.name end
		MU.setStatus(MU.cached(m) and "Abrindo…" or "Baixando…")
		MU.resetBar() MU.updPlayBtn()
		task.spawn(function()
			local function fail(msg)
				if tk ~= MU.token then return end
				F.toast("Música: " .. msg, "err")
				MU.active = false
				MU.stopSound()
				MU.setStatus("Erro: " .. msg) MU.updPlayBtn() MU.restyle()
			end
			local p, why = MU.fetch(m)
			if tk ~= MU.token then return end
			if not p then fail(why) return end
			local okA, asset = pcall(MU.getAsset, p)
			if not okA or not asset then fail("não consegui abrir o arquivo") return end
			local s = F.new("Sound", { SoundId = asset, Volume = MS.vol, Looped = false }, gui)
			MU.snd = s
			local t0 = os.clock()
			while not s.IsLoaded and os.clock() - t0 < 8 and tk == MU.token do task.wait(0.1) end
			if tk ~= MU.token then return end
			if not s.IsLoaded or s.TimeLength <= 0 then
				if MU.isWeb(m.link) and delfile then pcall(delfile, p) end -- arquivo ruim: apaga para baixar de novo
				fail("arquivo inválido ou corrompido")
				return
			end
			s:Play()
			MU.setStatus("Tocando") MU.updPlayBtn() MU.restyle() MU.refreshTags()
			s.Ended:Connect(function() if tk == MU.token then MU.next(true) end end)
			task.delay(1.5, function() if tk == MU.token and MU.snd == s then MU.say(m.name, s.TimeLength) end end) -- espera 1,5 s: pular rápido não vira spam no chat
			if not MS.shuffle then -- baixa a próxima enquanto esta toca
				local nx = MU.q[i + 1]
				if nx and not nx.del and MU.isWeb(nx.link) and not MU.cached(nx) then task.spawn(MU.fetch, nx) end
			end
		end)
	end
	-- toca a lista que está na tela (já filtrada) a partir da posição ri
	function MU.playView(ri)
		if #MU.view == 0 then F.toast("A lista está vazia", "err") return end
		MU.q, MU.seen = table.clone(MU.view), {}
		MU.play(ri or 1)
	end
	function MU.next(auto)
		local j = MU.nextIndex(auto)
		if j then MU.play(j) else MU.stop() F.toast("Fim da lista") end
	end
	function MU.prev()
		if MU.snd and MU.snd.TimePosition > 3 then MU.snd.TimePosition = 0 return end
		local n = #MU.q
		if n == 0 then return end
		MU.play(MU.idx <= 1 and n or MU.idx - 1)
	end
	function MU.toggle()
		if MU.snd and MU.snd.IsLoaded then
			if MU.snd.IsPaused then MU.snd:Resume() else MU.snd:Pause() end
			MU.setStatus(MU.state()) MU.updPlayBtn() MU.refreshTags()
		elseif MU.cur and MU.q[MU.idx] == MU.cur and not MU.cur.del then
			MU.play(MU.idx)
		else
			MU.playView(1)
		end
	end

	function MU.downloadAll()
		if MU.dlAll then F.toast("Já está baixando…") return end
		local list = table.clone(MU.view)
		if #list == 0 then F.toast("A lista está vazia", "err") return end
		MU.dlAll = true
		task.spawn(function()
			local total, ok, bad = #list, 0, 0
			for i, m in ipairs(list) do
				if V.closing then break end
				MU.setStatus(string.format("Baixando %d/%d", i, total))
				if MU.cached(m) then ok += 1 else
					if MU.fetch(m) then ok += 1 else bad += 1 end
				end
			end
			MU.dlAll = false
			F.toast(string.format("Download concluído: %d ok, %d com falha", ok, bad), bad > 0 and "err" or "ok")
			MU.setStatus(MU.state()) MU.restyle()
		end)
	end
	function MU.clearCache()
		if not delfile then F.toast("Seu executor não tem delfile", "err") return end
		local n = 0
		for _, m in ipairs(MS.list) do -- só apaga o que o menu baixou; seus arquivos locais nunca são tocados
			if MU.isWeb(m.link) and MU.cached(m) and pcall(delfile, MU.path(m)) then n += 1 end
		end
		F.toast(n .. " arquivo(s) apagado(s)")
		MU.restyle()
	end

	-- ===== tag de música sobre a cabeça =====
	-- Quem tem FoxMenu avisa a música no chat ("🎵 | Tocando: nome"); os outros FoxMenu leem essa mensagem e mostram a tag.
	-- Se o formato tiver {tempo}, a tag some quando a música acaba; senão some em 3min30.
	function MU.onChat(uid, text)
		if uid == player.UserId or type(text) ~= "string" then return end
		local fl
		text, fl = F.musicParse(text)
		local _, j = text:find("🎵 | Tocando: ", 1, true)
		if not j then return end
		if fl and fl.t then -- o jogador pediu para não mostrar a tag dele
			MU.peers[uid] = nil
			MU.refreshTags()
			return
		end
		local name = text:sub(j + 1)
		local dur = 210
		local a, b = name:match("%(%s*(%d+):(%d%d)%s*%)%s*$")
		if a then
			dur = tonumber(a) * 60 + tonumber(b) + 3
			name = name:gsub("%s*%(%s*%d+:%d%d%s*%)%s*$", "")
		end
		name = name:match("^%s*(.-)%s*$")
		if name == "" then return end
		MU.peers[uid] = { name = name, exp = os.clock() + dur }
		MU.refreshTags()
	end
	function F.musicFor(p)
		if p == player then
			if MS.hideTagSelf then return nil end
			local sn = MU.snd
			if sn and MU.active and sn.IsPlaying and not sn.IsPaused then return MU.cur and MU.cur.name or nil end
			return nil
		end
		if MS.tagOthers == false then return nil end
		local e = MU.peers[p.UserId]
		if e and os.clock() < e.exp then return e.name end
		return nil
	end
	function F.musicSnd() return MU.snd end
	pcall(function()
		local TCS = game:GetService("TextChatService")
		if TCS.ChatVersion == Enum.ChatVersion.TextChatService then
			F.track(TCS.MessageReceived:Connect(function(m)
				local src = m.TextSource
				if src then MU.onChat(src.UserId, m.Text) end
			end))
		end
	end)
	local function hookChat(p) F.track(p.Chatted:Connect(function(msg) MU.onChat(p.UserId, msg) end)) end
	for _, p in ipairs(Players:GetPlayers()) do if p ~= player then hookChat(p) end end
	F.track(Players.PlayerAdded:Connect(hookChat))
	F.track(Players.PlayerRemoving:Connect(function(p) MU.peers[p.UserId] = nil end))

	-- barra de progresso
	do
		local acc = 0
		F.track(RS.Heartbeat:Connect(function(dt)
			acc += dt
			if acc < 0.25 then return end
			acc = 0
			local s = MU.snd
			if not s or V.closing or not (MU.pfill and MU.pfill.Parent) then return end
			local L = s.TimeLength
			if L > 0 and not MU.seeking then MU.pfill.Size = U2(math.clamp(s.TimePosition / L, 0, 1), 0, 1, 0) end
			MU.t1.Text, MU.t2.Text = MU.ft(s.TimePosition), MU.ft(L)
		end))
	end

	local _fechar = F.fechar
	F.fechar = function() pcall(MU.stop) _fechar() end

