-- R = raio (número ou UDim) · S = transparência do contorno (cor de destaque)
function F.new(class, p, parent)
	local o, r, s = Instance.new(class), p.R, p.S
	p.R, p.S = nil, nil
	for k, v in pairs(p) do o[k] = v end
	if r then Instance.new("UICorner", o).CornerRadius = typeof(r) == "UDim" and r or UDim.new(0, r) end
	if s then
		local k = Instance.new("UIStroke", o)
		k.Color, k.Transparency, k.Thickness = C.white, s, 1.5
	end
	o.Parent = parent
	return o
end
function F.tw(o, props, t, style, dir)
	TS:Create(o, TweenInfo.new(t or 0.18, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props):Play()
end
function F.txt(parent, text, p)
	local d = { BackgroundTransparency = 1, Text = text, TextColor3 = C.text, Font = EF.GothamMedium, TextSize = 13,
		TextXAlignment = EXA.Left, TextTruncate = Enum.TextTruncate.AtEnd }
	for k, v in pairs(p or {}) do d[k] = v end
	return F.new("TextLabel", d, parent)
end
