---------------------------------------------------------------- CONFIG
-- BALÃO DO CHAT ACIMA DAS TAGS: sobe o balão das mensagens conforme a quantidade de tags empilhadas, para não ficar por cima delas
-- Também controla o que aparece do aviso de música (balão / mensagem no chat), por jogador, via sinalizadores invisíveis na própria mensagem.
do
	local TCS = game:GetService("TextChatService")
	S.bub = type(S.bub) == "table" and S.bub or {}
	if S.bub.on == nil then S.bub.on = true end
	S.bub.hideMusic, S.bub.hideChat = nil, nil -- substituídos pelas opções da aba Música
	S.bub.extra = math.clamp(tonumber(S.bub.extra) or 0, -6, 12)
	local BUB = { orig = nil, last = nil }
	local function cfg()
		local ok, c = pcall(function() return TCS:FindFirstChildOfClass("BubbleChatConfiguration") end)
		return ok and c or nil
	end
	-- quantas "linhas" de tag existem agora (o maior empilhamento entre todos os jogadores)
	local function rows()
		local n = 0
		for _, e in pairs(F.TG.bb) do
			if e.gui and e.gui.Parent then
				local r = (e.dev and 1 or 0) + (e.own and 1 or 0) + (e.mus and 1 or 0)
				if r > n then n = r end
			end
		end
		return n
	end
	function BUB.apply()
		local c = cfg()
		if not c then return end
		if BUB.orig == nil then BUB.orig = c.VerticalStudsOffset end
		local want = BUB.orig
		if S.bub.on and not V.closing then
			local r = rows()
			if r > 0 then want = math.max(BUB.orig, BUB.orig + 1.4 + 1.1 * r + S.bub.extra) end
		end
		if BUB.last ~= want then
			BUB.last = want
			pcall(function() c.VerticalStudsOffset = want end)
		end
	end

	-- Sinalizadores invisíveis: \u{200D} + 3 caracteres [balão][chat][tag]; \u{200C} = ocultar, \u{200B} = mostrar.
	-- Só clientes FoxMenu leem isso; quem não usa vê a mensagem normalmente.
	local MARK, HIDE, SHOW = "\u{200D}", "\u{200C}", "\u{200B}"
	local function M() return type(S.music) == "table" and S.music or {} end
	function F.musicEncode()
		local m = M()
		if not (m.hideBubOthers or m.hideChatOthers or m.hideTagOthers) then return "" end
		local function b(v) return v and HIDE or SHOW end
		return MARK .. b(m.hideBubOthers) .. b(m.hideChatOthers) .. b(m.hideTagOthers)
	end
	-- devolve o texto limpo e {balão, chat, tag} (true = ocultar) ou nil se não houver sinalizador
	function F.musicParse(text)
		if type(text) ~= "string" then return text, nil end
		local s = text:find(MARK, 1, true)
		if not s then return text, nil end
		local flags, n = {}, 0
		local rest = text:sub(s + #MARK)
		for _, cp in utf8.codes(rest) do
			n += 1
			flags[n] = (cp == 0x200C)
			if n >= 3 then break end
		end
		if n < 3 then return text, nil end
		return text:sub(1, s - 1), { b = flags[1], c = flags[2], t = flags[3] }
	end

	local MUSIC_PFX = "🎵 | Tocando: "
	-- decide o que ocultar numa mensagem de música: devolve hideBubble, hideChat (ou nil se não é aviso de música)
	local function musInfo(msg)
		local text = msg.Text
		if type(text) ~= "string" then return nil end
		local clean, fl = F.musicParse(text)
		if not clean:find(MUSIC_PFX, 1, true) then return nil end
		local src = msg.TextSource
		local m = M()
		if src and src.UserId == player.UserId then
			return m.hideBubSelf == true, m.hideChatSelf == true
		end
		if fl then return fl.b == true, fl.c == true end
		return false, false
	end
	function BUB.hook()
		pcall(function()
			if not V.closing then
				TCS.OnBubbleAdded = function(msg, adornee)
					local hb = musInfo(msg)
					if hb then
						local pr = Instance.new("BubbleChatMessageProperties")
						pr.BackgroundTransparency, pr.TailVisible, pr.TextSize = 1, false, 1
						pr.TextColor3 = Color3.new(0, 0, 0)
						return pr
					end
					return nil
				end
			else
				TCS.OnBubbleAdded = nil
			end
		end)
		pcall(function()
			if not V.closing then
				TCS.OnIncomingMessage = function(msg)
					local _, hc = musInfo(msg)
					if hc then
						local pr = Instance.new("TextChatMessageProperties")
						pr.Text, pr.PrefixText = "", ""
						return pr
					end
					return nil
				end
			else
				TCS.OnIncomingMessage = nil
			end
		end)
	end
	BUB.hook()
	function F.bubSetOn(on) S.bub.on = on and true or false F.save() BUB.apply() end
	function F.bubSetExtra(v) S.bub.extra = v F.save() BUB.apply() end
	do
		local acc = 0
		F.track(RS.Heartbeat:Connect(function(dt)
			acc += dt
			if acc < 0.4 then return end
			acc = 0
			BUB.apply()
		end))
	end
	local _fechar2 = F.fechar
	F.fechar = function()
		local c = cfg()
		if c and BUB.orig ~= nil then pcall(function() c.VerticalStudsOffset = BUB.orig end) end
		pcall(function() TCS.OnBubbleAdded = nil TCS.OnIncomingMessage = nil end)
		_fechar2()
	end
end

