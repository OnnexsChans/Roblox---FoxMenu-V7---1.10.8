function F.setMobileBoost(on)
	if on then
		if not X.mbOn then
			local ok, v = pcall(function() return (getfpscap or get_fps_cap)() end)
			if ok then X.fpsPrev = tonumber(v) end
		end
		local f = setfpscap or set_fps_cap
		if f then pcall(f, 0) else F.toast("Seu executor não suporta setfpscap") end
	else
		local f = setfpscap or set_fps_cap
		if f and X.fpsPrev and X.fpsPrev > 0 then pcall(f, X.fpsPrev) end
	end
	X.mbOn = on
end

