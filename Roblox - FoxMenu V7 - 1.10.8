local KIND_LABEL = { toggle = "liga/desliga", button = "executar", slider = "ajustar", choice = "alternar", input = "digitar" }

function F.search(q)
	local out = {}
	q = F.norm(q or "")
	if q == "" then
		local seen = {}
		for _, id in ipairs(S.recent) do if Ent[id] and not seen[id] then seen[id] = true out[#out + 1] = Ent[id] end end
		for _, id in ipairs(S.favs) do if Ent[id] and not seen[id] then seen[id] = true out[#out + 1] = Ent[id] end end
		return out
	end
	local toks = {}
	for t in q:gmatch("%S+") do toks[#toks + 1] = t end
	local sc = {}
	for _, e in ipairs(EntList) do
		local nm = F.norm(e.name)
		local hay = nm .. " " .. F.norm(e.tab .. " " .. e.sec .. " " .. (KIND_LABEL[e.kind] or ""))
		local s, ok = 0, true
		for _, t in ipairs(toks) do
			local p = nm:find(t, 1, true)
			if p then s += (p == 1 and 0) or (nm:sub(p - 1, p - 1) == " " and 2 or 6)
			elseif hay:find(t, 1, true) then s += 20
			else ok = false break end
		end
		if ok then sc[#sc + 1] = { e = e, s = s + #nm * 0.01 } end
	end
	table.sort(sc, function(a, b) return a.s < b.s end)
	for i = 1, math.min(#sc, 40) do out[i] = sc[i].e end
	return out
end
