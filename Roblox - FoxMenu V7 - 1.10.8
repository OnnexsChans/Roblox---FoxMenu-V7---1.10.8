function F.fetchServers()
	if not X.srvBox then return end
	F.toast("Buscando servidores...")
	task.spawn(function()
		local ok, data = pcall(function()
			local raw = game:HttpGet(("https://games.roblox.com/v1/games/%s/servers/Public?sortOrder=Asc&excludeFullGames=true&limit=100"):format(game.PlaceId))
			return Http:JSONDecode(raw).data
		end)
		if not ok or type(data) ~= "table" then return F.toast("Falha ao buscar servidores") end
		X.servers = data
		F.renderServers()
	end)
end
function F.renderServers()
	F.clearBox(X.srvBox)
	local l = {}
	for _, s in ipairs(X.servers) do if s.id ~= game.JobId then l[#l + 1] = s end end
	local m = X.srvSort
	table.sort(l, function(a, b)
		if m == "Melhor ping" then return (a.ping or 9e9) < (b.ping or 9e9)
		elseif m == "Mais cheio" then return (a.playing or 0) > (b.playing or 0) end
		return (a.playing or 0) < (b.playing or 0)
	end)
	for i = 1, math.min(10, #l) do
		local s = l[i]
		local row = F.new("Frame", { Size = U2(1, 0, 0, 44), BackgroundColor3 = C.item, LayoutOrder = i, R = 12 }, X.srvBox)
		F.txt(row, ("🌐  %d/%d jogadores  ·  %s ms"):format(s.playing or 0, s.maxPlayers or 0, s.ping and tostring(s.ping) or "?"), { Size = U2(1, -110, 1, 0), Position = U2o(14, 0) })
		F.smallBtn(row, "Entrar", 14 + 70, 70, function()
			F.toast("Entrando...")
			pcall(function() TP:TeleportToPlaceInstance(game.PlaceId, s.id, player) end)
		end)
	end
	if #l == 0 then F.note(X.srvBox, "Nenhum outro servidor encontrado.", 20) end
end

-- ===== executáveis: MM2 / Violent District / Bite by Night =====
local function tool(p, names)
	for _, cont in ipairs({ p.Character, p:FindFirstChildOfClass("Backpack") }) do
		if cont then
			for _, t in ipairs(cont:GetChildren()) do
				if t:IsA("Tool") then
					local n = t.Name:lower()
					for _, k in ipairs(names) do if n == k or n:find(k, 1, true) then return t end end
				end
			end
		end
	end
end
-- descobre quem é o assassino (faca) e o xerife (arma) agora
function F.mmRoles()
	local k, s
	for _, p in ipairs(Players:GetPlayers()) do
		if p.Character then
			if not k and tool(p, { "knife" }) then k = p end
			if not s and tool(p, { "gun", "revolver" }) then s = p end
		end
	end
	X.mmK, X.mmS = k, s
	return k, s
end
function F.setMM2(on)
	if X.mmC then X.mmC:Disconnect() X.mmC = nil end
	for p, h in pairs(X.mm) do h:Destroy() X.mm[p] = nil end
	if not on then return end
	local acc = 1
	X.mmC = RS.Heartbeat:Connect(function(dt)
		acc += dt
		if acc < 0.4 then return end
		acc = 0
		local k, s = F.mmRoles()
		for _, p in ipairs(Players:GetPlayers()) do
			local c = p ~= player and p.Character
			local h = X.mm[p]
			if c then
				if not h or h.Adornee ~= c then
					if h then h:Destroy() end
					h = mkHL(c, Color3.new(1, 1, 1), nil, 0.56)
					X.mm[p] = h
				end
				h.FillColor = (p == k and C3(255, 50, 50)) or (p == s and C3(60, 140, 255)) or C3(230, 230, 230)
				h.OutlineColor = h.FillColor
			elseif h then h:Destroy() X.mm[p] = nil end
		end
	end)
end
function F.mm2Shoot(quiet)
	local function fail(m) if not quiet then F.toast(m, "err") end end
	local k = F.mmRoles()
	local c, tc = player.Character, k and k.Character
	local tr = tc and (tc:FindFirstChild("HumanoidRootPart") or tc:FindFirstChild("Head"))
	if not (k and k ~= player and c and tr) then return fail("Assassino não encontrado") end
	local gun = c:FindFirstChildWhichIsA("Tool") and tool(player, { "gun", "revolver" })
	if not (gun and gun.Parent == c) then
		gun = tool(player, { "gun", "revolver" })
		if not gun then return fail("Você não tem a arma") end
		local h = aliveHum()
		if h then pcall(function() h:EquipTool(gun) end) end
	end
	if os.clock() < (X.mmLast or 0) then return end
	X.mmLast = os.clock() + 0.1
	local rem = gun:FindFirstChild("KnifeLocal")
	rem = rem and rem:FindFirstChild("CreateBeam")
	rem = rem and rem:FindFirstChild("RemoteFunction")
	local r = c:FindFirstChild("HumanoidRootPart")
	local from = r and r.Position or F.CAM().CFrame.Position
	local vel = tr.AssemblyLinearVelocity
	local pos = tr.Position + vel * ((tr.Position - from).Magnitude / 300) + Vector3.new(0, 0.05, 0)
	local ok = rem and rem:IsA("RemoteFunction") and pcall(function() rem:InvokeServer(1, pos, "AH2") end)
	if not ok then pcall(function() gun:Activate() end) F.doClick() end
end
-- ===== MM2: teleportes, auto-xerife e matar todos =====
local function mmRootOf(p)
	local c = p and p.Character
	return c and c:FindFirstChild("HumanoidRootPart")
end
local function mmHumOf(p)
	local c = p and p.Character
	return c and c:FindFirstChildOfClass("Humanoid")
end
local function mmBehind(tr, dist)
	return CFrame.lookAt((tr.CFrame * CFrame.new(0, 0, dist)).Position, tr.Position)
end
function F.mmTpBehind(role)
	local k, s = F.mmRoles()
	local p = role == "k" and k or s
	local label = role == "k" and "Assassino" or "Xerife"
	if not p then return F.toast(label .. " não encontrado", "err") end
	if p == player then return F.toast("Você é o " .. label:lower(), "err") end
	local tr = mmRootOf(p)
	if not (tr and F.root()) then return F.toast("Personagem indisponível") end
	F.tpCF(mmBehind(tr, 3), "Atrás do " .. label:lower() .. ": " .. p.DisplayName)
end
function F.mmGunDrop()
	local g = workspace:FindFirstChild("GunDrop", true)
	if not (g and g.Parent) then return nil end
	if g:IsA("BasePart") then return g end
	return g:IsA("Model") and (g.PrimaryPart or g:FindFirstChildWhichIsA("BasePart", true)) or nil
end
function F.mmGrabGun()
	local g, r = F.mmGunDrop(), F.root()
	if not (g and r) then return false end
	r.CFrame, r.AssemblyLinearVelocity = CFrame.new(g.Position + Vector3.new(0, 2, 0)), Vector3.zero
	pcall(function()
		if firetouchinterest then firetouchinterest(r, g, 0) firetouchinterest(r, g, 1) end
	end)
	return true
end
function F.mmTpGun()
	if not F.mmGunDrop() then return F.toast("Nenhuma arma dropada", "err") end
	local r = F.root()
	if r then V.prev = r.CFrame end
	if F.mmGrabGun() then F.toast("Teleportado até a arma") end
end
-- ===== MM2: automáticos (Auto Xerife · Auto Assassino · Auto Inocente · Auto Coin) + teclas de atalho próprias =====
do
	local function stopSelf(id) if Reg[id] then Reg[id].set(false, true) end end
	local function myGun() return tool(player, { "gun", "revolver" }) end

	-- trava a câmera numa parte: funciona em 1ª pessoa, 3ª pessoa livre e 3ª pessoa com Shift Lock
	-- (roda depois da assistência de mira, então esta trava sempre vence)
	local lockBound = false
	function F.mmLock(part)
		X.mmLockPart = part
		if part and not lockBound then
			lockBound = true
			RS:BindToRenderStep("FoxMMLock", Enum.RenderPriority.Camera.Value + 2, function()
				local p, cam = X.mmLockPart, F.CAM()
				if p and p.Parent and cam then cam.CFrame = CFrame.lookAt(cam.CFrame.Position, p.Position) end
			end)
		elseif not part and lockBound then
			lockBound = false
			pcall(function() RS:UnbindFromRenderStep("FoxMMLock") end)
		end
	end

	-- clique do mouse + disparo direto na cabeça (a câmera já está apontada para ela)
	function F.mmFire(head, tr)
		if os.clock() < (X.mmLast or 0) then return end
		X.mmLast = os.clock() + 0.1
		task.spawn(function()
			RS.RenderStepped:Wait()
			local c, gun = player.Character, myGun()
			if not (c and gun and head.Parent) then return end
			F.doClick()
			local rem = gun:FindFirstChild("KnifeLocal")
			rem = rem and rem:FindFirstChild("CreateBeam")
			rem = rem and rem:FindFirstChild("RemoteFunction")
			local pos = head.Position + tr.AssemblyLinearVelocity * 0.02
			if rem and rem:IsA("RemoteFunction") then pcall(function() rem:InvokeServer(1, pos, "AH2") end) end
		end)
	end

	-- 1) AUTO XERIFE: com a arma na mão, vai para trás do assassino, trava a mira na cabeça e atira
	function F.setMMAuto(on)
		X.mmAutoTok = (X.mmAutoTok or 0) + 1
		F.mmLock(nil)
		if not on then return end
		local tok = X.mmAutoTok
		task.spawn(function()
			local lastShot, announced = 0, false
			while X.mmAutoTok == tok and not V.closing do
				task.wait(0.1)
				local c, r, gun = player.Character, F.root(), myGun()
				local k = F.mmRoles()
				local kc = k and k ~= player and k.Character
				local kt, kh, head = mmRootOf(k), mmHumOf(k), kc and kc:FindFirstChild("Head")
				if c and r and aliveHum() and gun and gun.Parent == c and kt and kh and head and kh.Health > 0 then
					r.CFrame, r.AssemblyLinearVelocity = mmBehind(kt, 4), Vector3.zero
					F.mmLock(head)
					if not announced then announced = true F.toast("Auto Xerife: assassino na mira", "ok") end
					if os.clock() - lastShot >= 0.35 then
						lastShot = os.clock()
						F.mmFire(head, kt)
					end
				else
					F.mmLock(nil)
					announced = false
				end
			end
			if X.mmAutoTok == tok then F.mmLock(nil) end
		end)
	end

	-- 2) AUTO ASSASSINO: quando você é o assassino (tem a faca), vai para trás do xerife e ataca; sem xerife (ninguém com a arma),
	-- vai atrás de cada jogador vivo, um depois do outro (o mais perto primeiro). Se alguém pegar a arma no meio do caminho,
	-- ele vira o xerife e passa a ser o alvo prioritário. Alvo que não morre a tempo (lobby, escudo, invulnerável) é pulado.
	local function mmAlive(p)
		if p == player then return false end
		local h, r, c = mmHumOf(p), mmRootOf(p), p.Character
		return h ~= nil and r ~= nil and h.Health > 0 and not c:FindFirstChildOfClass("ForceField")
	end
	function F.setMMKillAll(on)
		X.mmKillTok = (X.mmKillTok or 0) + 1
		if not on then return end
		local tok = X.mmKillTok
		task.spawn(function()
			local cur, curSheriff, t0, lastToast = nil, false, 0, 0
			local skip = setmetatable({}, { __mode = "k" }) -- jogador -> até quando ele fica de fora
			local kills = 0
			while X.mmKillTok == tok and not V.closing do
				task.wait(0.08)
				local c, r, knife = player.Character, F.root(), tool(player, { "knife" })
				if not (c and r and aliveHum() and knife) then
					cur = nil -- você não é o assassino (ou morreu): espera
					kills = 0
				else
					if knife.Parent ~= c then -- faca ainda na mochila: equipa sozinho
						local h = aliveHum()
						if h then pcall(function() h:EquipTool(knife) end) end
					end
					local now = os.clock()
					local _, sheriff = F.mmRoles()
					local sheriffOk = sheriff and mmAlive(sheriff) and not (skip[sheriff] and skip[sheriff] > now)
					-- o alvo atual morreu / saiu / venceu o tempo? -> conta e escolhe outro
					if cur then
						if not mmAlive(cur) then
							if cur.Parent == Players and mmHumOf(cur) and mmHumOf(cur).Health <= 0 then kills += 1 end
							cur = nil
						elseif now - t0 > (curSheriff and 4 or 2.5) then
							skip[cur] = now + (curSheriff and 2 or 10)
							cur = nil
						elseif sheriffOk and not curSheriff then
							cur = nil -- apareceu um xerife: ele passa na frente
						end
					end
					if not cur then
						if sheriffOk then
							cur, curSheriff = sheriff, true
						else
							local best, bd
							for _, p in ipairs(Players:GetPlayers()) do
								if mmAlive(p) and not (skip[p] and skip[p] > now) then
									local d = (mmRootOf(p).Position - r.Position).Magnitude
									if not bd or d < bd then best, bd = p, d end
								end
							end
							cur, curSheriff = best, false
						end
						t0 = now
						if cur and now - lastToast > 0.8 then
							lastToast = now
							F.toast("Auto Assassino: " .. (curSheriff and "xerife " or "") .. (cur.DisplayName or cur.Name), "ok")
						end
					end
					local tr = cur and mmRootOf(cur)
					if tr then
						r.CFrame, r.AssemblyLinearVelocity = mmBehind(tr, 1.8), Vector3.zero
						pcall(function() knife:Activate() end)
						F.doClick()
					end
				end
			end
		end)
	end

	-- 3) AUTO INOCENTE: espera o xerife morrer e a arma cair no chão; teleporta até ela e pega
	function F.setMMInocente(on)
		X.mmInoTok = (X.mmInoTok or 0) + 1
		if not on then return end
		local tok = X.mmInoTok
		task.spawn(function()
			local cool = 0
			while X.mmInoTok == tok and not V.closing do
				task.wait(0.2)
				if os.clock() >= cool and F.mmGunDrop() and aliveHum() and not myGun() and not tool(player, { "knife" }) then
					F.toast("Xerife morreu: indo pegar a arma", "ok")
					local got = false
					for _ = 1, 15 do
						if X.mmInoTok ~= tok or V.closing then break end
						if not F.mmGrabGun() then break end
						task.wait(0.15)
						if myGun() then got = true break end
					end
					if X.mmInoTok == tok then
						F.toast(got and "Arma pega!" or "Não consegui pegar a arma", got and "ok" or "err")
					end
					cool = os.clock() + 3
				end
			end
		end)
	end

	-- 4) AUTO COIN: desliza de moeda em moeda (a mais próxima primeiro) e para sozinho quando a partida acaba
	local function isCoin(o)
		if not o:IsA("BasePart") then return false end
		local n = o.Name:lower()
		if n == "coin_server" then return true end
		if not n:find("coin", 1, true) then return false end
		local p = o.Parent
		while p and p ~= workspace do
			if p.Name == "CoinContainer" then return true end
			p = p.Parent
		end
		return false
	end
	local function coinList(visited)
		local list = {}
		local root = workspace:FindFirstChild("CoinContainer", true) or workspace
		for _, o in ipairs(root:GetDescendants()) do
			if not visited[o] and isCoin(o) and o.Transparency < 1 then list[#list + 1] = o end
		end
		return list, root ~= workspace
	end
	-- desliza (devagar, atravessando paredes) até a moeda em vez de teleportar
	local GLIDE_SPEED, GLIDE_TIMEOUT = 22, 40 -- studs por segundo · tempo máximo por moeda (s)
	function F.mmGlide(r, coin, live)
		local char, changed = r.Parent, {}
		local nc = RS.Stepped:Connect(function() -- atravessa paredes enquanto desliza
			if not char then return end
			for _, p in ipairs(char:GetDescendants()) do
				if p:IsA("BasePart") and p.CanCollide then p.CanCollide, changed[p] = false, true end
			end
		end)
		local t0 = os.clock()
		while live() and r.Parent and coin.Parent and coin.Transparency < 1 and os.clock() - t0 < GLIDE_TIMEOUT do
			local dt = RS.Heartbeat:Wait()
			local diff = coin.Position - r.Position
			local dist = diff.Magnitude
			if dist < 1.5 then break end
			r.CFrame = r.CFrame + diff.Unit * math.min(dist, GLIDE_SPEED * dt)
			r.AssemblyLinearVelocity, r.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
		end
		nc:Disconnect()
		for p in pairs(changed) do if p.Parent then p.CanCollide = true end end
		if coin.Parent and r.Parent then
			pcall(function()
				if firetouchinterest then firetouchinterest(r, coin, 0) firetouchinterest(r, coin, 1) end
			end)
		end
	end
	function F.setMMCoin(on)
		X.mmCoinTok = (X.mmCoinTok or 0) + 1
		if not on then return end
		local tok = X.mmCoinTok
		local function live() return X.mmCoinTok == tok and not V.closing end
		task.spawn(function()
			local visited, found, empty, waited, total = {}, false, 0, 0, 0
			F.toast("Auto Coin: procurando moedas", "ok")
			while live() do
				local r = F.root()
				if not (r and aliveHum()) then
					task.wait(0.5)
				else
					local list, hasBox = coinList(visited)
					if #list == 0 then
						if found then
							empty += 1
							if empty >= 4 or not hasBox then break end -- acabaram as moedas / partida terminou
						else
							waited += 0.5
							if waited > 90 then break end -- nenhuma partida começou
						end
						task.wait(0.5)
					else
						found, empty = true, 0
						local best, bd
						for _, o in ipairs(list) do
							local d = (o.Position - r.Position).Magnitude
							if not bd or d < bd then best, bd = o, d end
						end
						visited[best], total = true, total + 1
						F.mmGlide(r, best, live)
					end
				end
			end
			if live() then
				stopSelf("mm2coin")
				F.toast(found and ("Auto Coin: parou (" .. total .. " moeda(s))") or "Auto Coin: nenhuma moeda encontrada", found and "ok" or "err")
			end
		end)
	end

	-- teclas de atalho de cada opção (salvas; ligam/desligam a opção e atualizam o interruptor do menu)
	local BIND_IDS = { mm2auto = "Auto Xerife", mm2killall = "Auto Assassino", mm2inocente = "Auto Inocente", mm2coin = "Auto Coin" }
	S.mmb = type(S.mmb) == "table" and S.mmb or {}
	function F.mmBindRefresh()
		for id in pairs(BIND_IDS) do
			local f = V.I["mmb_" .. id]
			if f then f((S.mmb[id] and S.mmb[id] ~= "") and S.mmb[id] or "Nenhuma") end
		end
	end
	function F.mmBindSet(id)
		X.mmCap = id
		F.toast("Aperte a tecla para " .. BIND_IDS[id] .. " (Esc cancela)")
	end
	function F.mmBindClear(id)
		S.mmb[id] = nil
		F.save() F.mmBindRefresh()
		F.toast("Tecla removida: " .. BIND_IDS[id])
	end
	F.track(UIS.InputBegan:Connect(function(i, gp)
		if i.UserInputType ~= Enum.UserInputType.Keyboard or V.closing then return end
		local name = i.KeyCode.Name
		if X.mmCap then
			local id = X.mmCap
			X.mmCap = nil
			if i.KeyCode == KC.Escape then return F.toast("Atalho cancelado") end
			for o, k in pairs(S.mmb) do if k == name then S.mmb[o] = nil end end -- cada tecla serve a uma opção só
			S.mmb[id] = name
			F.save() F.mmBindRefresh()
			return F.toast(BIND_IDS[id] .. ": tecla " .. name, "ok")
		end
		if gp or UIS:GetFocusedTextBox() then return end
		for id, k in pairs(S.mmb) do
			local r = BIND_IDS[id] and Reg[id]
			if r and k == name then
				r.set(not r.get())
				F.toast(BIND_IDS[id] .. (r.get() and "  ·  ligado" or "  ·  desligado"))
			end
		end
	end))
end

function F.setVD(on)
	if X.vdC then X.vdC:Disconnect() X.vdC = nil end
	for o, h in pairs(X.vd) do h:Destroy() X.vd[o] = nil end
	if Reg.espall and Reg.espall.get() ~= on then Reg.espall.set(on) end
	if not on then return end
	local function scan(o)
		if o:IsA("Model") and o.Name:lower():find("generator", 1, true) and not X.vd[o] then X.vd[o] = mkHL(o, C3(255, 220, 60), nil, 0.5) end
	end
	for _, o in ipairs(workspace:GetDescendants()) do scan(o) end
	X.vdC = workspace.DescendantAdded:Connect(scan)
end
