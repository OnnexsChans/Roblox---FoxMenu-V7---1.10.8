function F.recolor(o, map)
	local function sw(p) local h = o[p]:ToHex() if map[h] then o[p] = map[h] end end
	if o:IsA("GuiObject") then sw("BackgroundColor3") end
	if o:IsA("TextLabel") or o:IsA("TextButton") or o:IsA("TextBox") then sw("TextColor3") end
	if o:IsA("TextBox") then sw("PlaceholderColor3") end
	if o:IsA("ScrollingFrame") then sw("ScrollBarImageColor3") end
	if o:IsA("UIStroke") then sw("Color") end
end
function F.applyPalette(np)
	local map = {}
	for k, v in pairs(C) do map[v:ToHex()] = np[k] end
	for _, o in ipairs(gui:GetDescendants()) do F.recolor(o, map) end
	for k, v in pairs(np) do C[k] = v end
end

---------------------------------------------------------------- sons / efeitos / toasts
local SND = {
	click = { CLICK, 1.00, 0.35 }, tab = { CLICK, 1.30, 0.22 }, hover = { CLICK, 1.90, 0.05 },
	on = { SWITCH, 1.25, 0.45 }, off = { SWITCH, 0.80, 0.40 }, ok = { CLICK, 1.40, 0.40 },
	err = { CLICK, 0.55, 0.50 }, open = { CLICK, 1.15, 0.30 }, close = { CLICK, 0.85, 0.30 },
	pop = { CLICK, 1.60, 0.28 }, whoosh = { SWITCH, 0.60, 0.30 }, soft = { CLICK, 2.10, 0.12 },
}
local lastSnd, SND_GAP = {}, { hover = 0.06, soft = 0.05, tab = 0.04 }
function F.snd(kind, mul)
	if not cfg.sounds then return end
	kind = kind or "click"
	local now = os.clock()
	if now - (lastSnd[kind] or 0) < (SND_GAP[kind] or 0.015) then return end -- evita estourar o áudio com spam
	lastSnd[kind] = now
	local d = SND[kind] or SND.click
	local jitter = (kind == "hover" or kind == "click" or kind == "tab") and (1 + (math.random() - 0.5) * 0.08) or 1 -- tom levemente variado = menos repetitivo
	local s = F.new("Sound", { SoundId = d[1], PlaybackSpeed = d[2] * (mul or 1) * jitter, Volume = d[3] * (SOUND_VOL / 0.5) }, gui)
	s:Play()
	Debris:AddItem(s, 3)
end
F.click = F.snd
function F.chime(...)
	local n = { ... }
	task.spawn(function() for _, m in ipairs(n) do F.snd("ok", m) task.wait(0.07) end end)
end

function F.ripple(b, colKey)
	local sc = scaleObj.Scale
	local rel = (UIS:GetMouseLocation() - b.AbsolutePosition) / sc
	local size = math.max(b.AbsoluteSize.X, b.AbsoluteSize.Y) / sc * 1.6
	local c = F.new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = U2o(rel.X, rel.Y), Size = U2(),
		BackgroundColor3 = C[colKey or "white"], BackgroundTransparency = 0.82, BorderSizePixel = 0, ZIndex = b.ZIndex + 5, R = 999 }, b)
	F.tw(c, { Size = U2o(size, size), BackgroundTransparency = 1 }, 0.55, QUINT)
	Debris:AddItem(c, 0.6)
end
function F.press(b, colKey)
	b.ClipsDescendants = true
	local sc = F.new("UIScale", {}, b)
	b.MouseButton1Down:Connect(function() F.tw(sc, { Scale = 0.96 }, 0.08) F.ripple(b, colKey) end)
	b.MouseButton1Up:Connect(function() F.tw(sc, { Scale = 1 }, 0.35, BACK) end)
	b.MouseLeave:Connect(function() F.tw(sc, { Scale = 1 }, 0.15) end)
end
function F.interactive(b, baseKey, hovKey, colKey, invert)
	F.press(b, colKey)
	local sk = b:FindFirstChildOfClass("UIStroke")
	b.MouseEnter:Connect(function()
		F.tw(b, { BackgroundColor3 = C[hovKey] }, 0.15)
		if invert then F.tw(b, { TextColor3 = C.black }, 0.15) end
		if sk then F.tw(sk, { Transparency = 0.6 }, 0.15) end
	end)
	b.MouseLeave:Connect(function()
		F.tw(b, { BackgroundColor3 = C[baseKey] }, 0.2)
		if invert then F.tw(b, { TextColor3 = C.text }, 0.2) end
		if sk then F.tw(sk, { Transparency = 1 }, 0.2) end
	end)
end

local toastBox = F.new("Frame", { AnchorPoint = Vector2.new(1, 1), Position = U2(1, -20, 1, -20), Size = U2o(310, 260), BackgroundTransparency = 1 }, gui)
F.new("UIListLayout", { VerticalAlignment = Enum.VerticalAlignment.Bottom, HorizontalAlignment = Enum.HorizontalAlignment.Right,
	Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, toastBox)
local logLines, toastN = {}, 0
V.logLabel = nil
function F.log(text)
	table.insert(logLines, 1, os.date("%H:%M:%S") .. "   " .. text)
	if #logLines > 30 then table.remove(logLines) end
	if V.logLabel then V.logLabel.Text = table.concat(logLines, "\n", 1, math.min(#logLines, 10)) end
end
local TOAST_ERR = { "sem ", "nenhum", "selecione", "indisponível", "digite", "falha", "não encontrada", "dê um nome", "nada " }
function F.toastKind(text)
	local l = text:lower()
	if l:find("desligado", 1, true) or l:find("parad", 1, true) or l:find("removid", 1, true) then return "off" end
	if l:find("ligado", 1, true) or l:find("ativado", 1, true) then return "on" end
	for _, w in ipairs(TOAST_ERR) do if l:find(w, 1, true) then return "err" end end
	return "ok"
end
local TOAST_STYLE = { on = { C3(60, 200, 120), "🟢" }, off = { C3(150, 150, 165), "⚪" }, ok = { C3(90, 150, 255), "✅" }, err = { C3(235, 80, 80), "⚠️" } }
function F.toast(text, kind)
	F.log(text)
	if V.closing or V.hidden then return end
	kind = kind or F.toastKind(text)
	F.snd(kind)
	if not cfg.toasts then return end
	if V.lastToast == text and os.clock() - (V.lastToastT or 0) < 0.35 then return end -- anti-duplicata
	V.lastToast, V.lastToastT = text, os.clock()
	local alive = {}
	for _, c in ipairs(toastBox:GetChildren()) do if c:IsA("CanvasGroup") then alive[#alive + 1] = c end end
	if #alive >= 4 then table.sort(alive, function(a, b) return a.LayoutOrder < b.LayoutOrder end) alive[1]:Destroy() end
	toastN += 1
	task.spawn(function()
		local sty = TOAST_STYLE[kind]
		local t = F.new("CanvasGroup", { Size = U2(1, 0, 0, 42), BackgroundColor3 = C.panel, GroupTransparency = 1, LayoutOrder = toastN, R = 14, S = 0.7 }, toastBox)
		local sc = F.new("UIScale", { Scale = 0.85 }, t)
		F.new("Frame", { Size = U2(0, 4, 1, 0), BackgroundColor3 = sty[1], BorderSizePixel = 0 }, t)
		F.txt(t, sty[2], { Size = U2o(26, 42), Position = U2o(12, 0), TextSize = 16, TextXAlignment = EXA.Center })
		F.txt(t, text, { Size = U2(1, -50, 1, 0), Position = U2o(42, 0), TextSize = 12 })
		local bar = F.new("Frame", { Size = U2(1, 0, 0, 2), Position = U2(0, 0, 1, -2), BackgroundColor3 = sty[1], BackgroundTransparency = 0.4, BorderSizePixel = 0 }, t)
		F.tw(t, { GroupTransparency = 0 }, 0.25)
		F.tw(sc, { Scale = 1 }, 0.4, BACK)
		F.tw(bar, { Size = U2(0, 0, 0, 2) }, 2.2, LIN)
		task.wait(2.2)
		F.tw(t, { GroupTransparency = 1 }, 0.3)
		F.tw(sc, { Scale = 0.9 }, 0.3)
		task.wait(0.35)
		t:Destroy()
	end)
end
local clip = setclipboard or toclipboard
function F.copyText(text, what)
	if clip then pcall(clip, text) F.toast((what or "Texto") .. " copiado")
	else F.toast("Copiar indisponível neste executor") end
end

