-- kind: nil = recurso normal · "set" = só configuração (não conta como ativo) · "act" = ação de jogador (sem toast ligado/desligado)
function F.toggle(parent, text, cb, default, id, kind)
	id = id or text
	local b = F.row(parent, 44, "TextButton")
	F.interactive(b, "item", "hover")
	F.txt(b, text, { Size = U2(1, -86, 1, 0), Position = U2(0, 18, 0, 0) })
	local tr = F.new("Frame", { Size = U2o(46, 24), Position = U2(1, -60, 0.5, -12), BackgroundColor3 = C.off, BorderSizePixel = 0, R = 12 }, b)
	local kn = F.new("Frame", { Size = U2o(18, 18), Position = U2(0, 3, 0.5, -9), BackgroundColor3 = C.muted, BorderSizePixel = 0, R = 9 }, tr)
	local on = false
	local mark = F.new("Frame", { Size = U2o(3, 0), Position = U2(0, 0, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), BackgroundColor3 = C.white, BorderSizePixel = 0, R = 2 }, b)
	local function set(v, silent)
		on = v
		F.tw(mark, { Size = U2o(3, on and 22 or 0) }, 0.3, BACK)
		F.tw(tr, { BackgroundColor3 = on and C.white or C.off }, 0.2)
		F.tw(kn, { Position = on and U2(1, -21, 0.5, -9) or U2(0, 3, 0.5, -9), BackgroundColor3 = on and C.black or C.muted }, 0.3, BACK)
		if not silent then
			F.tw(kn, { Size = U2o(24, 16) }, 0.08)
			task.delay(0.09, function() if kn.Parent then F.tw(kn, { Size = U2o(18, 18) }, 0.25, BACK) end end)
			cb(on)
		end
	end
	local short = (text:gsub("%s*%(.-%)", ""):gsub("%s+$", ""))
	local function flip()
		set(not on)
		if kind ~= "act" then F.toast(short .. (on and "  ·  ligado" or "  ·  desligado")) end
	end
	b.MouseButton1Click:Connect(function() F.click() F.used(id) flip() end)
	if default then set(true, true) end
	Reg[id] = { set = set, get = function() return on end, def = default or false, feat = kind ~= "set" }
	F.reg(id, text, "toggle", flip, function() return on end, b, true)
	F.favHook(b, id)
end
function F.button(parent, text, cb, id)
	id = id or ("b:" .. text)
	local b = F.row(parent, 44, "TextButton")
	b.Text, b.TextColor3, b.Font, b.TextSize = text, C.text, EF.GothamBold, 13
	F.interactive(b, "item", "white", "black", true)
	b.MouseButton1Click:Connect(function() F.click() F.used(id) cb() end)
	F.reg(id, text, "button", cb, nil, b, true)
	F.favHook(b, id)
end
function F.slider(parent, text, min, max, def, cb, suffix, id)
	id = id or text
	local function fmt(v) return type(suffix) == "function" and suffix(v) or (v .. (suffix or "")) end
	local cur = def
	local f = F.row(parent, 58)
	F.txt(f, text, { Size = U2(1, -96, 0, 24), Position = U2(0, 18, 0, 6) })
	local val = F.txt(f, fmt(def), { Size = U2o(76, 24), Position = U2(1, -90, 0, 6), TextColor3 = C.white, Font = EF.GothamBold, TextXAlignment = EXA.Right })
	local bar = F.new("Frame", { Size = U2(1, -36, 0, 6), Position = U2(0, 18, 0, 40), BackgroundColor3 = C.off, BorderSizePixel = 0, R = 3 }, f)
	local fill = F.new("Frame", { Size = U2((def - min) / (max - min), 0, 1, 0), BackgroundColor3 = C.white, BorderSizePixel = 0, R = 3 }, bar)
	local knob = F.new("Frame", { Size = U2o(14, 14), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(1, 0.5), BackgroundColor3 = C.white, BorderSizePixel = 0, R = 7 }, fill)
	local ks = F.new("UIScale", {}, knob)
	local drag = false
	local function setv(v)
		v = math.clamp(math.floor(v + 0.5), min, max)
		if v ~= cur and drag then F.snd("soft", 0.8 + 0.8 * (v - min) / math.max(1, max - min)) end
		cur = v
		fill.Size, val.Text = U2((v - min) / (max - min), 0, 1, 0), fmt(v)
		cb(v)
	end
	local function upd(x) setv(min + (max - min) * math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)) end
	local lastClk = 0
	f.InputBegan:Connect(function(i)
		if not F.isPtr(i) then return end
		local now = os.clock()
		if now - lastClk < 0.3 then -- clique duplo = volta ao valor padrão
			lastClk, drag = 0, false
			setv(def)
			F.snd("pop") F.toast(text .. " restaurado", "ok")
			return
		end
		lastClk = now
		drag = true F.tw(ks, { Scale = 1.4 }, 0.15, BACK) upd(i.Position.X)
	end)
	F.track(UIS.InputChanged:Connect(function(i) if drag and F.isMove(i) then upd(i.Position.X) end end))
	F.track(UIS.InputEnded:Connect(function(i) if drag and F.isPtr(i) then drag = false F.tw(ks, { Scale = 1 }, 0.2) end end))
	Reg[id] = { set = setv, get = function() return cur end, def = def }
	F.reg(id, text, "slider", function() F.goTo(id) end, nil, f)
	F.favHook(f, id)
end
function F.choice(parent, text, opts, cb, id, def)
	id = id or text
	local idx = def or 1
	local b = F.row(parent, 44, "TextButton")
	F.interactive(b, "item", "hover")
	F.txt(b, text, { Size = U2(0.5, -18, 1, 0), Position = U2(0, 18, 0, 0) })
	local v = F.txt(b, "", { Size = U2(0.5, -18, 1, 0), Position = U2(0.5, 0, 0, 0), TextColor3 = C.white, Font = EF.GothamBold, TextXAlignment = EXA.Right })
	local function show() v.Text = opts[idx] .. "  ›" end
	local function set(x, silent)
		if type(x) == "string" then idx = table.find(opts, x) or idx else idx = x end
		show()
		if not silent then cb(opts[idx], idx) end
	end
	b.MouseButton1Click:Connect(function() F.click() F.used(id) set(idx % #opts + 1) end)
	show()
	Reg[id] = { set = set, get = function() return opts[idx] end, def = opts[def or 1] }
	F.reg(id, text, "choice", function() set(idx % #opts + 1) F.toast(text .. ": " .. opts[idx]) end, nil, b, true)
	F.favHook(b, id)
end
function F.inputRow(parent, ph, btnText, cb, id)
	id = id or ("x:" .. ph)
	local f = F.row(parent, 46)
	local tb = F.new("TextBox", { Size = U2(1, -118, 0, 30), Position = U2o(8, 8), BackgroundColor3 = C.panel, Text = "", PlaceholderText = ph,
		PlaceholderColor3 = C.muted, TextColor3 = C.white, Font = EF.GothamMedium, TextSize = 12, ClearTextOnFocus = false, TextXAlignment = EXA.Left, ClipsDescendants = true, R = 9 }, f)
	F.new("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) }, tb)
	local function go() cb(tb.Text) tb.Text = "" end
	F.smallBtn(f, btnText, 100, 92, go)
	tb.FocusLost:Connect(function(enter) if enter then go() end end)
	F.reg(id, ph, "input", function() F.goTo(id) task.delay(0.4, function() tb:CaptureFocus() end) end, nil, f)
end
function F.info(parent, text)
	local r = F.new("Frame", { Size = U2(1, 0, 0, 38), BackgroundColor3 = C.item, LayoutOrder = F.nx(), R = 12 }, parent)
	F.txt(r, text, { Size = U2(0.4, 0, 1, 0), Position = U2(0, 18, 0, 0), TextColor3 = C.muted })
	local v = F.txt(r, "—", { Size = U2(0.6, -32, 1, 0), Position = U2(0.4, 14, 0, 0), TextColor3 = C.white, Font = EF.GothamBold, TextXAlignment = EXA.Right })
	return function(s) v.Text = s end
end
function F.graph(parent, title, maxV, unit)
	local f = F.new("Frame", { Size = U2(1, 0, 0, 100), BackgroundColor3 = C.item, LayoutOrder = F.nx(), R = 12 }, parent)
	F.txt(f, title, { Size = U2(1, -110, 0, 22), Position = U2o(14, 4), TextColor3 = C.muted, TextSize = 12 })
	local val = F.txt(f, "—", { Size = U2o(90, 22), Position = U2(1, -104, 0, 4), TextColor3 = C.white, Font = EF.GothamBold, TextXAlignment = EXA.Right })
	local area = F.new("Frame", { Size = U2(1, -28, 1, -36), Position = U2o(14, 30), BackgroundTransparency = 1 }, f)
	local N, bars, hist = 40, {}, {}
	for i = 1, N do
		bars[i] = F.new("Frame", { AnchorPoint = Vector2.new(0, 1), Position = U2((i - 1) / N, 1, 1, 0), Size = U2(1 / N, -2, 0, 0),
			BackgroundColor3 = C.white, BackgroundTransparency = 0.3, BorderSizePixel = 0, R = 2 }, area)
	end
	return function(v)
		hist[#hist + 1] = v
		if #hist > N then table.remove(hist, 1) end
		val.Text = math.floor(v + 0.5) .. unit
		for i = 1, N do
			local hv = hist[i - (N - #hist)]
			bars[i].Size = U2(1 / N, -2, hv and math.clamp(hv / maxV, 0.03, 1) or 0, 0)
		end
	end
end
function F.profileCard(parent, h, av)
	local f = F.new("Frame", { Size = U2(1, 0, 0, h), BackgroundColor3 = C.item, LayoutOrder = F.nx(), R = 14 }, parent)
	local a = F.new("ImageLabel", { Size = U2o(av, av), Position = U2(0, 12, 0.5, -av / 2), BackgroundColor3 = C.hover, BorderSizePixel = 0, R = av / 2, S = 0.6 }, f)
	local n = F.txt(f, "", { Size = U2(1, -av - 36, 0, 24), Position = U2(0, av + 24, 0.5, -24), TextColor3 = C.white, Font = EF.GothamBlack, TextSize = 16 })
	local s = F.txt(f, "", { Size = U2(1, -av - 36, 0, 18), Position = U2(0, av + 24, 0.5, 2), TextColor3 = C.muted, Font = EF.Gotham, TextSize = 12 })
	return a, n, s
