---------------------------------------------------------------- setas no menu nativo de emotes do Roblox (tecla ".")
E.nat = { gui = nil, conns = {}, wheel = nil }

-- procura o menu de emotes do Roblox no CoreGui (a estrutura muda de vez em quando, então procura por nome)
function E.natFind()
	local ok, core = pcall(function() return game:GetService("CoreGui") end)
	if not ok then return nil end
	local rg = core:FindFirstChild("RobloxGui")
	local menu = rg and rg:FindFirstChild("EmotesMenu")
	if not menu then return nil end
	local wheel = menu:FindFirstChild("EmotesWheel", true) or (menu:FindFirstChild("Main", true))
	return rg, menu, wheel
end
-- o menu está realmente na tela? (todos os ancestrais visíveis e com tamanho)
function E.natVisible(wheel, menu)
	if not (wheel and wheel.Parent) then return false end
	if wheel.AbsoluteSize.X < 50 then return false end
	local o = wheel
	while o and o ~= game do
		if o:IsA("GuiObject") and not o.Visible then return false end
		if o:IsA("LayerCollector") and not o.Enabled then return false end
		o = o.Parent
	end
	return true
end
function E.natStop()
	E.emoHookStop()
	for _, c in ipairs(E.nat.conns) do pcall(function() c:Disconnect() end) end
	E.nat.conns = {}
	if E.nat.gui then pcall(function() E.nat.gui:Destroy() end) end
	E.nat.gui, E.nat.wheel = nil, nil
end
function E.natStart()
	E.natStop()
	E.emoHook()
	local rg, menu, wheel = E.natFind()
	if not rg then
		return F.toast("Menu de emotes do Roblox não encontrado no CoreGui (executor sem acesso?)", "err")
	end
	E.nat.wheel = wheel
	-- apaga restos de execuções anteriores do script (contador/botões duplicados)
	for _, o in ipairs(rg:GetChildren()) do
		if o.Name == "FoxEmoteArrows" then pcall(function() o:Destroy() end) end
	end
	-- contêiner no RobloxGui: acompanha a posição do menu, sem ser cortado por ele
	local host = Instance.new("Frame")
	host.Name, host.BackgroundTransparency, host.BorderSizePixel = "FoxEmoteArrows", 1, 0
	host.Size, host.ZIndex, host.Visible = UDim2.fromOffset(10, 10), 50, false
	host.Parent = rg
	local dead = false -- o host foi destruído (outra execução do script limpou): para de tentar reparentar
	host.Destroying:Connect(function() dead = true end)
	E.nat.gui = host
	local function mk(txt, anchor, pos)
		local b = Instance.new("TextButton")
		b.AnchorPoint, b.Position, b.Size = anchor, pos, UDim2.fromOffset(46, 38)
		b.BackgroundColor3, b.BackgroundTransparency, b.BorderSizePixel = Color3.fromRGB(20, 20, 24), 0.25, 0
		b.Text, b.TextColor3, b.Font, b.TextSize, b.AutoButtonColor, b.ZIndex = txt, Color3.new(1, 1, 1), Enum.Font.GothamBold, 20, false, 51
		Instance.new("UICorner", b).CornerRadius = UDim.new(0, 12)
		b.Parent = host
		b.MouseEnter:Connect(function() b.BackgroundTransparency = 0.05 end)
		b.MouseLeave:Connect(function() b.BackgroundTransparency = 0.25 end)
		return b
	end
	local left = mk("◀", Vector2.new(0, 1), UDim2.fromOffset(0, 0))
	local right = mk("▶", Vector2.new(1, 1), UDim2.fromOffset(0, 0))
	local lbl = Instance.new("TextLabel")
	lbl.AnchorPoint, lbl.BackgroundTransparency, lbl.Size = Vector2.new(0.5, 1), 1, UDim2.fromOffset(140, 20)
	lbl.Font, lbl.TextSize, lbl.TextColor3, lbl.ZIndex = Enum.Font.GothamBold, 13, Color3.new(1, 1, 1), 51
	lbl.TextStrokeTransparency = 0.5
	lbl.Parent = host
	-- canto superior direito: emotes <-> packs · canto superior esquerdo: andar durante o emote
	local modeB = mk("💃 Emotes", Vector2.new(1, 0), UDim2.fromOffset(0, 0))
	modeB.Size, modeB.TextSize = UDim2.fromOffset(112, 30), 13
	local walkB = mk("🚶 Andar: não", Vector2.new(0, 0), UDim2.fromOffset(0, 0))
	walkB.Size, walkB.TextSize = UDim2.fromOffset(120, 30), 13
	modeB.MouseButton1Click:Connect(function()
		E.setWMode(E.wmode == "emote" and "pack" or (E.wmode == "pack" and "fly" or "emote")) -- emotes → packs → voo → emotes
	end)
	walkB.MouseButton1Click:Connect(function() E.setWalk(not E.walkEmote) end)
	left.MouseButton1Click:Connect(function() E.setPage(E.page - 1, -1) end)
	right.MouseButton1Click:Connect(function() E.setPage(E.page + 1, 1) end)

	-- acompanha o menu a cada quadro (posição, visibilidade e texto da página)
	local rsC
	rsC = RS.RenderStepped:Connect(function()
		if dead then rsC:Disconnect() return end
		local rg2, menu2, wheel2 = E.natFind()
		if not (rg2 and wheel2) then host.Visible = false return end
		E.nat.wheel = wheel2
		if host.Parent ~= rg2 then
			if not pcall(function() host.Parent = rg2 end) then dead = true return end
		end
		local show = E.sync and E.natVisible(wheel2, menu2)
		host.Visible = show
		if not show then return end
		local ap, as = wheel2.AbsolutePosition, wheel2.AbsoluteSize
		-- coordenadas do RobloxGui: desconta o deslocamento dele
		local base = rg2.AbsolutePosition
		local x0, y1 = ap.X - base.X, ap.Y - base.Y + as.Y
		local y0 = ap.Y - base.Y
		modeB.Position = UDim2.fromOffset(x0 + as.X + 40, y0 + 8)
		walkB.Position = UDim2.fromOffset(x0 - 40, y0 + 8)
		modeB.Text = E.wmode == "pack" and "📦 Packs" or (E.wmode == "fly" and "🕊️ Voo" or "💃 Emotes")
		walkB.Text = E.walkEmote and "🚶 Andar: sim" or "🚶 Andar: não"
		left.Position = UDim2.fromOffset(x0 + 8, y1 - 6)
		right.Position = UDim2.fromOffset(x0 + as.X - 8, y1 - 6)
		lbl.Position = UDim2.fromOffset(x0 + as.X / 2, y1 + 22)
		lbl.Text = (E.wmode == "fly" and "🕊️ " or "📦 ") .. ("Página %d / %d"):format(E.page, E.pageCount())
	end)
	table.insert(E.nat.conns, rsC)
	-- CLIQUE NO PACK (detecção direta no menu nativo, sem depender de hook): guarda o item sob o mouse (o menu mostra o nome
	-- dele) e, ao clicar/tocar/apertar A dentro da roda, equipa o pack mesmo que o Roblox recuse o "emote"
	E.natHover = nil
	local acc = 0
	table.insert(E.nat.conns, RS.Heartbeat:Connect(function(dt)
		if dead then return end
		acc = acc + dt
		if acc < 0.08 then return end
		acc = 0
		if V.closing or not E.sync or E.wmode == "emote" then E.natHover = nil return end
		local rg2, menu2, wheel2 = E.natFind()
		if not (menu2 and E.natVisible(wheel2, menu2)) then return end -- some o menu: mantém o último item por um instante
		local hit
		for _, d in ipairs(menu2:GetDescendants()) do
			if d:IsA("TextLabel") and d.Text ~= "" and d.Visible then
				local pk = E.wheelPNL and E.wheelPNL[d.Text:lower()]
				if pk then hit = pk break end
			end
		end
		E.natHover = hit and { pk = hit, t = os.clock() } or nil
	end))
	table.insert(E.nat.conns, UIS.InputBegan:Connect(function(i)
		if V.closing or not E.sync or E.wmode == "emote" then return end
		local ut = i.UserInputType
		local isClick = ut == Enum.UserInputType.MouseButton1 or ut == Enum.UserInputType.Touch
			or i.KeyCode == KC.ButtonA or i.KeyCode == KC.Return
		if not isClick then return end
		local h = E.natHover
		if not (h and os.clock() - h.t < 0.6) then return end
		local rg2, menu2, wheel2 = E.natFind()
		if not wheel2 then return end
		if ut == Enum.UserInputType.MouseButton1 or ut == Enum.UserInputType.Touch then
			local p, sz, pos = wheel2.AbsolutePosition, wheel2.AbsoluteSize, i.Position
			if pos.X < p.X or pos.X > p.X + sz.X or pos.Y < p.Y or pos.Y > p.Y + sz.Y then return end
		end
		E.triggerPack(h.pk)
	end))
	-- ← e → com o menu aberto
	table.insert(E.nat.conns, UIS.InputBegan:Connect(function(i, gp)
		if V.closing or not E.sync or UIS:GetFocusedTextBox() then return end
		if not (E.nat.gui and E.nat.gui.Visible) then return end
		if i.KeyCode == KC.Left then E.setPage(E.page - 1, -1)
		elseif i.KeyCode == KC.Right then E.setPage(E.page + 1, 1) end
	end))
end

