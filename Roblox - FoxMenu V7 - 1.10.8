		t.btn.TextXAlignment = v and EXA.Center or EXA.Left
		t.pad.PaddingLeft = UDim.new(0, v and 0 or 14)
	end
	F.colBtn.Text = v and "›" or "‹  Recolher"
	if Reg.sbcollapse then Reg.sbcollapse.set(v, true) end
	if not silent then S.collapsed = v F.save() F.snd(v and "close" or "open") end
end
F.colBtn = F.new("TextButton", { Size = U2(1, -16, 0, 30), Position = U2(0, 8, 1, -38), BackgroundTransparency = 1, BackgroundColor3 = C.item,
	Text = "‹  Recolher", TextColor3 = C.muted, Font = EF.GothamMedium, TextSize = 12, AutoButtonColor = false, R = 10 }, sidebar)
F.colBtn.MouseEnter:Connect(function() F.tw(F.colBtn, { BackgroundTransparency = 0, TextColor3 = C.text }, 0.15) end)
F.colBtn.MouseLeave:Connect(function() F.tw(F.colBtn, { BackgroundTransparency = 1, TextColor3 = C.muted }, 0.2) end)
F.colBtn.MouseButton1Click:Connect(function() F.setCollapsed(not F.collapsed) end)

function F.scroller(parent, size, pos, pad)
	local s = F.new("ScrollingFrame", { Size = size, Position = pos or U2(), BackgroundTransparency = 1, BorderSizePixel = 0,
		ScrollBarThickness = 3, ScrollBarImageColor3 = C.white, ScrollBarImageTransparency = 0.5, CanvasSize = U2(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y }, parent)
	F.new("UIListLayout", { Padding = UDim.new(0, pad), SortOrder = Enum.SortOrder.LayoutOrder }, s)
	F.new("UIPadding", { PaddingRight = UDim.new(0, 6), PaddingBottom = UDim.new(0, 8) }, s)
	return s
end
function F.createTab(name, raw)
	tabN += 1
	local btn = F.new("TextButton", { Size = U2(1, -16, 0, TABH), Position = U2(0, 8, 0, F.tabY(tabN)), BackgroundTransparency = 1, BackgroundColor3 = C.item,
		Text = F.tabLabel(name), TextColor3 = C.muted, Font = EF.GothamMedium, TextSize = 13, TextXAlignment = EXA.Left,
		AutoButtonColor = false, ZIndex = 3, R = 11 }, sidebar)
	local pad = F.new("UIPadding", { PaddingLeft = UDim.new(0, 14) }, btn)
	local group = F.new("CanvasGroup", { Size = U2(1, -24, 1, -GY - 12), Position = U2o(12, GY), BackgroundTransparency = 1, Visible = false }, content)
	local inner = raw and group or F.scroller(group, UDim2.fromScale(1, 1), nil, 8)
	V.tabs[name] = { btn = btn, group = group, i = tabN, pad = pad, scroll = inner }
	if not raw then
		local up = F.new("TextButton", { Size = U2o(36, 36), AnchorPoint = Vector2.new(1, 1), Position = U2(1, -14, 1, -8), BackgroundColor3 = C.white, Text = "↑",
			TextColor3 = C.black, Font = EF.GothamBlack, TextSize = 18, AutoButtonColor = false, ZIndex = 50, Visible = false, R = 18 }, group)
		local upS = F.new("UIScale", { Scale = 0 }, up)
		local shown = false
		inner:GetPropertyChangedSignal("CanvasPosition"):Connect(function()
			local want = inner.CanvasPosition.Y > 320
			if want == shown then return end
			shown = want
			if want then up.Visible = true F.tw(upS, { Scale = 1 }, 0.3, BACK)
			else F.tw(upS, { Scale = 0 }, 0.2) task.delay(0.22, function() if not shown then up.Visible = false end end) end
		end)
		up.MouseEnter:Connect(function() F.tw(upS, { Scale = 1.12 }, 0.15, BACK) end)
		up.MouseLeave:Connect(function() F.tw(upS, { Scale = 1 }, 0.2) end)
		up.MouseButton1Click:Connect(function() F.snd("whoosh", 1.4) F.tw(inner, { CanvasPosition = Vector2.new(0, 0) }, 0.5, QUINT) end)
	end
	btn.MouseEnter:Connect(function()
		if curTab ~= name then F.tw(btn, { TextColor3 = C.text, BackgroundTransparency = 0.55 }, 0.15) F.snd("hover") end
	end)
	btn.MouseLeave:Connect(function() F.tw(btn, { BackgroundTransparency = 1 }, 0.2) if curTab ~= name then F.tw(btn, { TextColor3 = C.muted }, 0.2) end end)
	btn.MouseButton1Click:Connect(function() F.selectTab(name) end)
	return inner
end

---------------------------------------------------------------- registro de opções (busca / favoritos / recentes / atalhos)
local Ent, EntList = {}, {}
V.ctx = { tab = "", sec = "", key = "", sub = nil }
local IC = { fly = "🕊️", smooth = "🌊", sprint = "🏃", inf = "🦘", glide = "🪂", water = "💧", climb = "🧗", noclip = "👻", sit = "🪑",
	god = "🛡️", dash = "💨", clicktp = "🖱️", tpmouse = "🎯", tpcam = "📷", tpback = "↩️", freecam = "🎥", orbit = "🔄", zoom = "🔭",
	fullbright = "💡", nofog = "🌫️", ambient = "🌈", collview = "🧱", afk = "⏰", autoclick = "👆", rec = "⏺️", inspect = "🔍",
	tags = "🏷️", attach = "🐒", worm = "🪱", face = "😳", follow = "🚶", orbitp = "🔄", spectate = "👁️", stop = "⏹️",
	tp = "📍", hop = "🌐", rejoin = "🔁", resetchar = "💀", shot = "📸", menu = "🪟", palette = "🔍", fpsboost = "🚀", clean = "🧼", hidegui = "🙈", closeall = "⛔", restart = "♻️",
	antivoid = "🕳️", antivoid2 = "🧱", ftf_player = "🧍", ftf_pods = "🧊", ftf_exits = "🚪", ftf_pc = "💻", ftf_bestpc = "🏆",
	ftf_neverfail = "✅", ftf_autoplay = "🤖", ftf_autointeract = "🖐️" }
local KIND_IC = { toggle = "🔘", button = "▶️", slider = "🎚️", choice = "🔁", input = "⌨️" }
function F.icon(e) return IC[e.id] or KIND_IC[e.kind] or "⚡" end

function F.reg(id, name, kind, run, get, frame, act)
	if Ent[id] then return end
	local e = { id = id, name = name, short = (name:gsub("%s*%(.-%)", ""):gsub("%s+$", "")), kind = kind, run = run, get = get, frame = frame,
		act = act, tab = V.ctx.tab, sec = V.ctx.sec, secKey = V.ctx.key, sub = V.ctx.sub }
	Ent[id], EntList[#EntList + 1] = e, e
end
function F.used(id)
	local r = S.recent
	local i = table.find(r, id)
	if i then table.remove(r, i) end
	table.insert(r, 1, id)
	while #r > 6 do table.remove(r) end
	F.save()
end
function F.activate(id)
	local e = Ent[id]
	if e and e.run then F.used(id) task.spawn(e.run) end
end
function F.toggleFav(id)
	local i = table.find(S.favs, id)
	if i then table.remove(S.favs, i) else S.favs[#S.favs + 1] = id end
	F.save()
	if V.marks[id] then V.marks[id].Visible = not i end
	F.rebuildHome() F.rebuildQuick()
	if V.pal.Visible then F.renderPal(true) end
	F.toast(i and "Removido dos favoritos" or "Fixado nos favoritos")
end
function F.favHook(o, id)
	V.marks[id] = F.txt(o, "★", { Size = U2o(14, 14), Position = U2o(4, 2), TextColor3 = C3(255, 200, 60), TextSize = 11, Font = EF.GothamBold,
		Visible = table.find(S.favs, id) ~= nil, ZIndex = o.ZIndex + 3, TextXAlignment = EXA.Center })
	o.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton2 then F.toggleFav(id) end end)
end

function F.setSection(key, open)
	local s = V.secs[key]
	if not s then return end
	local was = s.open
	s.open, s.frame.Visible = open, open
	F.tw(s.arrow, { Rotation = open and 90 or 0 }, 0.35, BACK)
	if open and not was then
		local n = 0
		for _, ch in ipairs(s.frame:GetChildren()) do
			if ch:IsA("GuiObject") and ch.BackgroundTransparency < 0.5 then
				n += 1
				local orig = ch.BackgroundTransparency
				ch.BackgroundTransparency = 1
				task.delay(math.min(n, 8) * 0.025, function()
					if ch.Parent then F.tw(ch, { BackgroundTransparency = orig }, 0.25) end
				end)
			end
		end
	end
	S.coll[key] = (not open) or nil
	F.save()
end
function F.section(parent, tab, title, icon)
	local key = tab .. "/" .. title
	local hdr = F.new("TextButton", { Size = U2(1, 0, 0, 30), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, LayoutOrder = F.nx() }, parent)
	local lbl = F.txt(hdr, (icon and (icon .. "  ") or "") .. title:upper(), { Size = U2(1, -30, 1, 0), TextColor3 = C.muted, Font = EF.GothamBold, TextSize = 11 })
	local arrow = F.txt(hdr, "›", { Size = U2o(24, 30), Position = U2(1, -24, 0, 0), TextColor3 = C.muted, TextXAlignment = EXA.Center, Font = EF.GothamBold, TextSize = 20, Rotation = 90 })
	local fr = F.new("Frame", { Size = U2(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = F.nx() }, parent)
	F.new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, fr)
	V.secs[key] = { frame = fr, arrow = arrow, open = true }
	hdr.MouseEnter:Connect(function() F.tw(lbl, { TextColor3 = C.text }, 0.12) F.tw(arrow, { TextColor3 = C.text }, 0.12) end)
	hdr.MouseLeave:Connect(function() F.tw(lbl, { TextColor3 = C.muted }, 0.15) F.tw(arrow, { TextColor3 = C.muted }, 0.15) end)
	hdr.MouseButton1Click:Connect(function() F.snd("tab", 1.2) F.setSection(key, not V.secs[key].open) end)
	hdr.InputBegan:Connect(function(i)
		if i.UserInputType ~= Enum.UserInputType.MouseButton2 then return end
		local pre, anyOpen = tab .. "/", false
		for k, sec in pairs(V.secs) do if k:sub(1, #pre) == pre and sec.open then anyOpen = true break end end
		for k in pairs(V.secs) do if k:sub(1, #pre) == pre then F.setSection(k, not anyOpen) end end
		F.snd("whoosh", 1.3)
		F.toast(anyOpen and "Seções recolhidas" or "Seções expandidas", "ok")
	end)
	if S.coll[key] then V.secs[key].open, fr.Visible, arrow.Rotation = false, false, 0 end
	V.ctx.sec, V.ctx.key = title, key
	return fr
end
function F.goTo(id)
	local e = Ent[id]
	if not e then return end
	if V.hidden then F.setVisible(true) end
	if V.minimized then F.setMinimized(false) end
	F.selectTab(e.tab)
	if e.sub then e.sub() end
	if e.secKey and S.coll[e.secKey] then F.setSection(e.secKey, true) end
	task.delay(0.2, function()
		local t, fr = V.tabs[e.tab], e.frame
		if not (t and fr and fr.Parent) then return end
		local sc = t.scroll
		local y = (fr.AbsolutePosition.Y - sc.AbsolutePosition.Y) / scaleObj.Scale + sc.CanvasPosition.Y - 10
		F.tw(sc, { CanvasPosition = Vector2.new(0, math.max(0, y)) }, 0.35, QUINT)
		local sk = fr:FindFirstChildOfClass("UIStroke")
		if sk then
			F.tw(sk, { Transparency = 0 }, 0.2)
			task.delay(0.9, function() if sk.Parent then F.tw(sk, { Transparency = 1 }, 0.5) end end)
		end
	end)
end

