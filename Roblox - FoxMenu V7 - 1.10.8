F.track(UIS.InputBegan:Connect(function(i, processed)
	if V.closing then return end
	if i.UserInputType == Enum.UserInputType.MouseButton1 then
		if not processed then
			if st.clickTp and UIS:IsKeyDown(Ctrl) and UIS:IsKeyDown(KC.Q) then F.tpMouse()
			elseif V.inspOn then F.inspectAtMouse() end
		end
		return
	end
	if i.UserInputType ~= Enum.UserInputType.Keyboard then return end
	local k = i.KeyCode
	if listening then
		local b = listening
		if k == KC.Escape then F.rebuildBinds()
		elseif k ~= KC.Unknown then
			-- CORREÇÃO: duas ações nunca ficam na mesma tecla (a antiga perde a tecla)
			local lost
			for _, ob in ipairs(binds) do
				if ob ~= b and ob.key == k then ob.key = nil lost = Ent[ob.id] and Ent[ob.id].short or ob.id end
			end
			b.key = k
			F.saveBinds()
			F.rebuildBinds()
			local msg = "Tecla definida: " .. k.Name
			if lost then msg ..= "  ·  tirada de " .. lost end
			if ({ [KC.W] = true, [KC.A] = true, [KC.S] = true, [KC.D] = true, [KC.Q] = true, [KC.E] = true, [KC.Z] = true,
				[KC.V] = true, [KC.B] = true, [KC.C] = true, [KC.Space] = true, [KC.LeftShift] = true, [KC.LeftControl] = true })[k] then
				msg ..= "  ·  atenção: usada por um recurso interno"
			end
			F.toast(msg)
		end
		return
	end
	if V.sBox:IsFocused() then
		if k == KC.Down then F.palMove(1) elseif k == KC.Up then F.palMove(-1)
		elseif k == KC.Escape then V.sBox.Text = "" V.sBox:ReleaseFocus() end
		return
	end
	if processed then return end
	if k == KC.K and UIS:IsKeyDown(Ctrl) then return F.focusSearch() end
	for _, b in ipairs(binds) do
		local e = b.key == k and Ent[b.id]
		if e and e.run then
			task.spawn(function()
				F.used(e.id)
				local ok, err = pcall(e.run)
				if not ok then warn("[FoxMenu] erro no atalho:", err) end
			end)
		end
	end
end))
