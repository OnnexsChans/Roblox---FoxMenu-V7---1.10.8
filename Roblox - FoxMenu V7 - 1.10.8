---------------------------------------------------------------- utilidades
-- cache em disco (FoxMenu_emocache.json): IDs de animação já resolvidos e detalhes de pacotes.
-- Depois da primeira vez, passar o mouse / equipar / testar o mesmo item não precisa baixar nada de novo.
E.CACHE_FILE = "FoxMenu_emocache.json"
do
	local okr, raw = pcall(function()
		if isfile and isfile(E.CACHE_FILE) then return readfile(E.CACHE_FILE) end
	end)
	if okr and raw then
		local ok2, d = pcall(function() return Http:JSONDecode(raw) end)
		if ok2 and type(d) == "table" then
			if type(d.a) == "table" then
				for k, v in pairs(d.a) do
					local n = tonumber(k)
					if n and type(v) == "table" and #v > 0 then E.anim[n] = v end
				end
			end
			if type(d.d) == "table" then
				for k, v in pairs(d.d) do
					if type(v) == "table" and type(v.bundled) == "table" then E.det[k] = v end
				end
			end
		end
	end
end
-- Antes: a cada item novo, o cache INTEIRO (900 + 400 itens) era recodificado em JSON de uma vez = travada, e itens além do limite
-- nunca eram salvos (por isso as páginas fundas sempre baixavam de novo). Agora: cada entrada é codificada UMA vez (e guardada em texto),
-- a codificação é fatiada com pausas entre os pedaços, e só grava quando você não está rolando nem com uma prévia aberta.
E.dcA, E.dcD = {}, {}
function E.dcIdle()
	local pv = E.pv
	return not (pv and pv.hb) and os.clock() - (E.lastScroll or 0) > 2 and os.clock() - ((pv and pv.lastUse) or 0) > 2
end
function E.dcSave()
	if not writefile or E.dcQ then return end
	E.dcQ = true
	task.delay(10, function() -- agrupa várias gravações numa só
		task.spawn(function()
			local t0 = os.clock()
			while not E.dcIdle() and not V.closing and os.clock() - t0 < 120 do task.wait(0.5) end -- espera o jogador parar
			if V.closing then E.dcQ = false return end
			pcall(function()
				local ap, dp, n = {}, {}, 0
				local aks, dks = {}, {} -- copia das chaves: outras threads podem adicionar itens enquanto esta pausa
				for k in pairs(E.anim) do aks[#aks + 1] = k end
				for k in pairs(E.det) do dks[#dks + 1] = k end
				for _, k in ipairs(aks) do
					local v = E.anim[k]
					local ks = string.format("%.0f", k)
					local s = v and E.dcA[ks]
					if v and not s then
						s = '"' .. ks .. '":' .. Http:JSONEncode(v)
						E.dcA[ks] = s
						n = n + 1
						if n % 25 == 0 then task.wait() end
					end
					if s then ap[#ap + 1] = s end
				end
				for _, k in ipairs(dks) do
					local v = E.det[k]
					local s = v and E.dcD[k]
					if v and not s then
						s = '"' .. tostring(k):gsub('[%c"\\]', "") .. '":' .. Http:JSONEncode(v)
						E.dcD[k] = s
						n = n + 1
						if n % 25 == 0 then task.wait() end
					end
					if s then dp[#dp + 1] = s end
				end
				task.wait()
				writefile(E.CACHE_FILE, '{"v":1,"a":{' .. table.concat(ap, ",") .. '},"d":{' .. table.concat(dp, ",") .. "}}")
			end)
			E.dcQ = false
		end)
	end)
end
function E.applyDet(it, d)
	it.name = it.name or d.name
	it.creator = it.creator or d.creator
	if d.price ~= nil then it.price = d.price end
	it.desc = d.desc
end
function E.g(t, ...)
	if type(t) ~= "table" then return nil end
	for _, k in ipairs({ ... }) do
		local v = t[k]
		if v ~= nil and v ~= "" then return v end
	end
	return nil
end
function E.clean(err)
	local s = tostring(err)
	s = s:gsub("^.-:%d+:%s*", "")
	if s:find("429", 1, true) then return "muitas requisições, aguarde alguns segundos" end
	if #s > 70 then s = s:sub(1, 70) .. "…" end
	return s
end
function E.thumb(kind, id, px)
	px = px or 150
	return ("rbxthumb://type=%s&id=%.0f&w=%d&h=%d"):format(kind == "pack" and "BundleThumbnail" or "Asset", id, px, px)
end
function E.fmtPrice(p)
	if p == nil then return "Preço indisponível" end
	if p == 0 then return "Grátis" end
	return "R$ " .. tostring(p)
end
-- um único objeto por item (evita duplicações e mantém nome/criador sincronizados entre buscas, favoritos e menu)
function E.mk(kind, id, name, creator)
	local key = kind .. ":" .. string.format("%.0f", id)
	local it = E.known[key]
	if not it then
		it = { kind = kind, id = id }
		E.known[key] = it
	end
	if name and name ~= "" and not it.name then it.name = name end
	if creator and creator ~= "" and not it.creator then it.creator = creator end
	return it
end
function E.slotOf(n)
	n = tostring(n):lower()
	if n:find("swim", 1, true) then return n:find("idle", 1, true) and "swimidle" or "swim" end
	for _, k in ipairs({ "climb", "fall", "jump", "run", "walk", "idle" }) do
		if n:find(k, 1, true) then return k end
	end
	if n:find("mood", 1, true) then return "mood" end
	return nil
end
function E.isFav(kind, id)
	local arr = kind == "pack" and D.favP or D.favE
	for i, e in ipairs(arr) do
		if e.id == id then return true, i end
	end
	return false
end
function E.libIdx(id)
	for i, e in ipairs(D.lib) do
		if e.id == id then return i end
	end
	return nil
end
-- packs de voo (salvos na aba Movimento) viram itens da roda: { n = nome, a = animação "parado" do pack, fly = true }
function E.flyList()
	local out = {}
	for i, n in ipairs(F.faNames()) do
		local d = S.flyPacks[n]
		local a = tonumber(type(d) == "table" and type(d.ids) == "table" and d.ids.idle) or tonumber(F.FA_DEF_IDS.idle)
		out[#out + 1] = { id = -i, n = n, c = "", a = a, fly = true }
	end
	return out
end
function E.wl() -- lista que a roda mostra agora (emotes, packs de animação ou packs de voo)
	if E.wmode == "pack" then return D.libP end
	if E.wmode == "fly" then return E.flyList() end
	return D.lib
end
---------------------------------------------------------------- EMOTES ORIGINAIS DA PESSOA + os do FoxMenu na mesma roda
-- A roda do Roblox só tem 8 slots por vez. Para NÃO apagar os emotes que a pessoa já tinha, montamos uma lista virtual:
--   [ emotes originais (na ordem dos slots) ] + [ itens do FoxMenu ]
-- e cada página da roda mostra 8 posições dessa lista. Ex.: 3 originais -> a página 1 tem os 3 + 5 do FoxMenu, e o resto
-- do FoxMenu segue nas páginas 2, 3, 4... Com 8 originais a página 1 fica só com eles e o FoxMenu começa na página 2.
-- Com 0 originais tudo funciona como antes. Packs de animação e de voo ficam em rodas limpas (mude abaixo para misturar).
E.ORIG_ALL = false -- true = os originais também aparecem na frente das rodas de packs e de voo
function E.origExtract(eq, emo)
	local ours = {}
	for _, e in ipairs(D.lib) do ours[tonumber(e.id) or 0] = true end
	for _, e in ipairs(D.libP) do if e.a then ours[tonumber(e.a) or 0] = true end end
	local arr = {}
	if type(eq) == "table" then
		for _, v in ipairs(eq) do
			if type(v) == "table" and type(v.Name) == "string" and not E.wheelAdded[v.Name] then arr[#arr + 1] = v end
		end
	end
	table.sort(arr, function(x, y) return (x.Slot or 0) < (y.Slot or 0) end)
	local haveEmo = type(emo) == "table" and next(emo) ~= nil
	local out = {}
	for _, v in ipairs(arr) do
		local n = v.Name
		local ids = haveEmo and emo[n] or nil
		local aid = type(ids) == "table" and tonumber(ids[1]) or nil
		-- ignora restos do próprio FoxMenu (script executado de novo sem fechar o anterior)
		local mine = string.find(n, "📦 ", 1, true) == 1 or string.find(n, "🕊️ ", 1, true) == 1 or (aid ~= nil and ours[aid] == true)
		if not mine and (not haveEmo or ids ~= nil) then out[#out + 1] = n end
	end
	return out
end
function E.origNames()
	local b = E.wheelBackup
	if b then
		if E.origB == b and E.origL then return E.origL end
		E.origB, E.origL = b, E.origExtract(b.equipped, b.emotes)
		return E.origL
	end
	local c = E.origLive
	if c and os.clock() - c.t < 2 then return c.l end
	local eq, emo
	local desc = E.descObj()
	if desc then
		local ok1, e1 = pcall(function() return desc:GetEquippedEmotes() end)
		local ok2, e2 = pcall(function() return desc:GetEmotes() end)
		eq, emo = ok1 and e1 or {}, ok2 and e2 or {}
	end
	local l = E.origExtract(eq or {}, emo or {})
	E.origLive = { t = os.clock(), l = l }
	return l
end
function E.off(mode) -- quantos slots do começo são dos emotes originais da pessoa
	mode = mode or E.wmode
	if mode ~= "emote" and not E.ORIG_ALL then return 0 end
	return #E.origNames()
end
function E.pageOf(i, mode) return math.ceil((E.off(mode) + i) / PER_PAGE) end -- página da roda onde o item i (da lista do FoxMenu) cai
function E.pageCount() return math.max(1, math.ceil((E.off() + #E.wl()) / PER_PAGE)) end
function E.pageCountE() return math.max(1, math.ceil((E.off("emote") + #D.lib) / PER_PAGE)) end
-- grava nome/criador descobertos depois nos favoritos e no menu
function E.patch(it)
	local arrs = it.kind == "pack" and { D.favP, D.libP } or { D.favE, D.lib }
	local changed = false
	for _, arr in ipairs(arrs) do
		for _, e in ipairs(arr) do
			if e.id == it.id then
				if (e.n == nil or e.n == "") and it.name then e.n = it.name changed = true end
				if (e.c == nil or e.c == "") and it.creator then e.c = it.creator changed = true end
			end
		end
	end
	if changed then F.save() end -- antes gravava o arquivo de configurações a cada item consultado, mesmo sem nada novo
end
-- um único vigia compartilhado (antes: uma thread acordando 10x/s para CADA imagem)
E.imgW = {}
function E.imgWatch()
	if E.imgRun then return end
	E.imgRun = true
	task.spawn(function()
		while next(E.imgW) and not V.closing do
			task.wait(0.25)
			local now = os.clock()
			for img, w in pairs(E.imgW) do
				if not img.Parent or img:GetAttribute("src") ~= w.url then
					E.imgW[img] = nil
				elseif img.IsLoaded then
					if w.ph then w.ph.Visible = false end
					E.imgW[img] = nil
				elseif now - w.t0 > 8 then
					if w.ph then w.ph.Text = "🖼" end
					E.imgW[img] = nil
				end
			end
		end
		E.imgRun = false
	end)
end
function E.loadImg(img, url, ph)
	if img:GetAttribute("src") == url then return end
	img:SetAttribute("src", url)
	img.ImageTransparency = 0 -- sempre visível: o Roblox desenha a imagem assim que ela chega (IsLoaded não é confiável em rbxthumb)
	if ph then
		ph.Visible, ph.Text = true, "⏳"
		E.imgW[img] = { url = url, ph = ph, t0 = os.clock() }
		E.imgWatch()
	end
	img.Image = url
end

---------------------------------------------------------------- rede: detalhes, busca, resolução de animações
function E.fetchDetails(it)
	local key = it.kind .. ":" .. string.format("%.0f", it.id)
	if E.det[key] then
		E.applyDet(it, E.det[key])
		return E.det[key]
	end
	if E.detBusy[key] then
		local t0 = os.clock()
		while E.detBusy[key] and os.clock() - t0 < 20 do task.wait(0.1) end
		return E.det[key]
	end
	E.detBusy[key] = true
	local isPack = it.kind == "pack"
	local d = { bundled = {} }
	local function absorb(t)
		if type(t) ~= "table" then return end
		d.name = d.name or E.g(t, "Name", "name")
		d.desc = d.desc or E.g(t, "Description", "description")
		local c = E.g(t, "CreatorName", "creatorName")
		if not c and type(t.Creator) == "table" then c = t.Creator.Name end
		if not c and type(t.creator) == "table" then c = t.creator.name end
		d.creator = d.creator or c
		local p = E.g(t, "Price", "price", "PriceInRobux", "lowestPrice")
		if p == nil and type(t.product) == "table" then p = t.product.priceInRobux end
		if d.price == nil and p ~= nil then d.price = tonumber(p) end
		if #d.bundled == 0 then
			local bi = E.g(t, "BundledItems", "bundledItems", "Items", "items")
			if type(bi) == "table" then
				for _, b in ipairs(bi) do
					local ty = E.g(b, "Type", "type", "ItemType", "itemType")
					local bid = tonumber(E.g(b, "Id", "id"))
					if bid and (ty == nil or ty == "Asset") then
						d.bundled[#d.bundled + 1] = { id = bid, name = E.g(b, "Name", "name") or "" }
					end
				end
			end
		end
	end
	local function enough() return d.name ~= nil and (not isPack or #d.bundled > 0) end
	pcall(function()
		absorb(AES:GetItemDetails(it.id, isPack and Enum.AvatarItemType.Bundle or Enum.AvatarItemType.Asset))
	end)
	if not enough() then
		pcall(function()
			absorb(MPS:GetProductInfo(it.id, isPack and Enum.InfoType.Bundle or Enum.InfoType.Asset))
		end)
	end
	if not enough() then
		pcall(function()
			local url = isPack and ("https://catalog.roblox.com/v1/bundles/" .. string.format("%.0f", it.id) .. "/details")
				or ("https://catalog.roblox.com/v1/catalog/items/" .. string.format("%.0f", it.id) .. "/details?itemType=Asset")
			absorb(Http:JSONDecode(game:HttpGet(url)))
		end)
	end
	E.detBusy[key] = nil
	if not d.name and not d.desc and #d.bundled == 0 then return nil end
	it.name = it.name or d.name
	it.creator = it.creator or d.creator
	if d.price ~= nil then it.price = d.price end
	it.desc = d.desc
	E.det[key] = d
	E.patch(it)
	E.dcSave()
	return d
end

function E.params(kind, kw, creator)
	local p = CatalogSearchParams.new()
	p.SearchKeyword = kw or ""
	if creator and creator ~= "" then p.CreatorName = creator end
	local idx = E.sort
	if (kw or "") == "" and not creator and idx == 1 then idx = 3 end -- sem texto: mostra os mais populares
	local ok, en = pcall(function() return Enum.CatalogSortType[E.SORTS[idx][2]] end)
	if ok and en then p.SortType = en end
	p.IncludeOffSale = true
	if kind == "pack" then
		p.BundleTypes = { Enum.BundleType.Animations }
	else
		p.AssetTypes = { Enum.AvatarAssetType.EmoteAnimation }
	end
	p.Limit = 30
	return p
end
function E.eat(ctx, pages, kind)
	local n = 0
	for _, e in ipairs(pages:GetCurrentPage()) do
		local id = tonumber(E.g(e, "Id", "id"))
		if id and not ctx.seen[id] then
			ctx.seen[id] = true
			local it = E.mk(kind, id, E.g(e, "Name", "name"), E.g(e, "CreatorName", "creatorName"))
			local pr = tonumber(E.g(e, "Price", "price"))
			if pr then it.price = pr end
			ctx.items[#ctx.items + 1] = it
			n = n + 1
		end
	end
	return n
end
function E.query()
	E.token = E.token + 1
	local tok, kind = E.token, E.mode
	local q = (E.q:gsub("^%s+", ""):gsub("%s+$", ""))
	local ctx = { items = {}, seen = {} }
	E.ctx, E.items, E.pages, E.shown = ctx, ctx.items, nil, 0
	E.finished, E.loadingMore, E.err, E.loading, E.autoOff, E.searched = false, false, nil, true, false, true
	E.renderGrid()
	task.spawn(function()
		local ok, err = pcall(function()
			if not AES then error("AvatarEditorService indisponível neste executor") end
			if q ~= "" then -- busca também pelo NOME DO CRIADOR (os resultados dele aparecem primeiro)
				local okc, cp = pcall(function() return AES:SearchCatalog(E.params(kind, "", q)) end)
				if okc and cp then pcall(E.eat, ctx, cp, kind) end
			end
			local pages = AES:SearchCatalog(E.params(kind, q))
			if tok ~= E.token then return end
			E.pages = pages
			E.eat(ctx, pages, kind)
			E.finished = pages.IsFinished
		end)
		if tok ~= E.token then return end
		E.loading = false
		if not ok then E.err = E.clean(err) end
		E.renderGrid()
		E.fillMissing()
	end)
end
function E.more()
	if E.loadingMore or E.loading or E.finished or not E.pages or E.view ~= "search" then return end
	E.loadingMore = true
	E.renderGrid(true)
	local tok, kind, ctx, pages = E.token, E.mode, E.ctx, E.pages
	task.spawn(function()
		local ok, err = pcall(function()
			pages:AdvanceToNextPageAsync()
			if tok ~= E.token then return end
			E.eat(ctx, pages, kind)
			E.finished = pages.IsFinished
		end)
		if tok ~= E.token then return end
		E.loadingMore = false
		if not ok then
			E.autoOff = true
			F.toast("Falha ao carregar mais: " .. E.clean(err), "err")
		end
		E.renderGrid(true)
		E.fillMissing()
	end)
end
-- preenche nome/criador que a busca não trouxe (no máximo 3 requisições ao mesmo tempo)
function E.fillMissing()
	for _, it in ipairs(E.curList()) do
		if (not it.name or not it.creator) and not it.tried then
			it.tried = true
			task.spawn(function()
				while E.inflight >= 2 do task.wait(0.2) end
				E.inflight = E.inflight + 1
				pcall(E.fetchDetails, it)
				E.inflight = E.inflight - 1
				task.wait(0.05)
				E.updateCards(it)
			end)
		end
	end
end
-- ID do catálogo -> lista de AnimationIds reais (o asset do catálogo costuma ser um contêiner).
-- GetObjects é a parte pesada (baixa e interpreta o asset). Antes, vários pedidos rodavam colados e travavam o jogo.
-- Agora: UMA fila com um único trabalhador, cache em memória + disco, pedidos urgentes (equipar/testar/prévia) furam a fila,
-- pedidos de fundo respiram entre si, e pedidos cancelados (mouse saiu do card) são descartados sem baixar nada.
E.rq = { list = {}, run = false, pend = {}, fail = {} }
function E.rFetch(aid)
	local list, found = {}, {}
	local ok, objs = pcall(function() return game:GetObjects("rbxassetid://" .. string.format("%.0f", aid)) end)
	if ok and type(objs) == "table" then
		local function scan(o)
			if o:IsA("Animation") and o.AnimationId ~= "" then found[#found + 1] = { n = o.Name, id = o.AnimationId } end
		end
		for _, o in ipairs(objs) do
			scan(o)
			for _, dsc in ipairs(o:GetDescendants()) do scan(dsc) end
		end
		table.sort(found, function(a, b) return a.n < b.n end)
		for _, f in ipairs(found) do list[#list + 1] = f.id end
		for _, o in ipairs(objs) do pcall(function() o:Destroy() end) end
	end
	return list
end
function E.rWorker()
	local q = E.rq
	if q.run then return end
	q.run = true
	task.spawn(function()
		while #q.list > 0 and not V.closing do
			local job = table.remove(q.list, 1)
			local aid = job.aid
			if not job.hi then -- pedido de fundo: não baixa/interpreta nada enquanto você rola a lista
				while os.clock() - (E.lastScroll or 0) < 0.6 and not V.closing do task.wait(0.1) end
			end
			if not E.anim[aid] and not (job.alive and not job.alive()) then
				local ok, res = pcall(E.rFetch, aid)
				if ok and res and #res > 0 then
					E.anim[aid] = res
					E.dcSave()
				else
					q.fail[aid] = os.clock()
				end
				task.wait(job.hi and 0.05 or 0.3) -- respira entre downloads para não segurar nenhum quadro
			end
			q.pend[aid] = nil
		end
		q.run = false
	end)
end
-- hi = urgente (fura a fila) · alive = função opcional: se devolver false o pedido é descartado
function E.resolve(aid, hi, alive)
	local c = E.anim[aid]
	if c then return c end
	local direct = { "rbxassetid://" .. string.format("%.0f", aid) } -- tentativa direta (não fica em cache)
	local q = E.rq
	local f = q.fail[aid]
	if f and os.clock() - f < 60 then return direct end
	local p = q.pend[aid]
	if not p then
		p = { aid = aid, hi = hi, alive = alive }
		q.pend[aid] = p
		if hi then table.insert(q.list, 1, p) else q.list[#q.list + 1] = p end
		E.rWorker()
	else
		if not alive then p.alive = nil end
		if hi and not p.hi then
			p.hi = true
			local i = table.find(q.list, p)
			if i then table.remove(q.list, i) table.insert(q.list, 1, p) end
		end
	end
	while q.pend[aid] == p and not V.closing do task.wait(0.03) end
	return E.anim[aid] or direct
end

---------------------------------------------------------------- PACOTES DE ANIMAÇÃO (Equipar / Desequipar)
function E.captureOrig(an)
	if E.origChar ~= an.Parent then
		E.orig, E.origChar = setmetatable({}, { __mode = "k" }), an.Parent
	end
	for _, d in ipairs(an:GetDescendants()) do
		if d:IsA("Animation") and E.orig[d] == nil then E.orig[d] = d.AnimationId end
	end
end
function E.restoreOrig()
	for inst, id in pairs(E.orig) do
		if inst.Parent then inst.AnimationId = id end
	end
	E.orig = setmetatable({}, { __mode = "k" })
end
function E.setFolder(an, name, ids)
	local f = an:FindFirstChild(name)
	if not f then return false end
	local anims = {}
	for _, c in ipairs(f:GetChildren()) do
		if c:IsA("Animation") then anims[#anims + 1] = c end
	end
	table.sort(anims, function(a, b) return a.Name < b.Name end)
	if #anims == 0 then return false end
	for i, a in ipairs(anims) do a.AnimationId = ids[math.min(i, #ids)] end
	return true
end
-- troca as animações com o Animate DESLIGADO: desliga -> para tudo -> (troca os IDs) -> religa -> vigia sobras.
-- Trocar os IDs com o Animate ligado deixava a animação do pacote antigo tocando junto com a nova (os outros jogadores
-- viam as duas misturadas). "fn" (opcional) roda enquanto o Animate está desligado.
function E.idNum(id) return tostring(id or ""):match("%d+%s*$") end
function E.idSet(an)
	local set = {}
	for _, d in ipairs(an:GetDescendants()) do
		if d:IsA("Animation") then
			local n = E.idNum(d.AnimationId)
			if n then set[n] = true end
		end
	end
	return set
end
function E.reanimate(an, hum, fn)
	if F.wormAnim then
		if fn then fn() end
		return
	end
	local animator = hum:FindFirstChildOfClass("Animator")
	local oldIds = E.idSet(an)
	an.Disabled = true
	local function clearTracks()
		if not animator then return end
		for _, t in ipairs(animator:GetPlayingAnimationTracks()) do
			if t ~= E.track and not X.fbOwn[t] then pcall(function() t:Stop(0.1) end) end
		end
	end
	clearTracks()
	task.wait(0.35) -- dá tempo do "parar" chegar nos outros jogadores antes das animações novas começarem
	clearTracks()
	if fn then fn() end
	task.wait(0.05)
	if an.Parent then an.Disabled = false end
	-- vigia por 4 s: qualquer animação do pacote antigo que ainda esteja tocando é parada
	local newIds = E.idSet(an)
	E.guardTok = (E.guardTok or 0) + 1
	local tok = E.guardTok
	task.spawn(function()
		local t0 = os.clock()
		while E.guardTok == tok and os.clock() - t0 < 4 and an.Parent and not V.closing do
			task.wait(0.1)
			if animator and animator.Parent then
				for _, t in ipairs(animator:GetPlayingAnimationTracks()) do
					local n = E.idNum(t.Animation and t.Animation.AnimationId)
					if n and oldIds[n] and not newIds[n] and t ~= E.track and not X.fbOwn[t] then
						pcall(function() t:Stop(0) end)
					end
				end
			end
		end
	end)
end
function E.doEquip(it)
	E.pvStop()
	E.stopEmote() -- um emote tocando junto com a troca de pacote também mistura as animações
	local hum = aliveHum()
	if not hum then return F.toast("Sem personagem vivo", "err") end
	if hum.RigType ~= Enum.HumanoidRigType.R15 then
		return F.toast("Pacotes de animação só funcionam em personagens R15", "err")
	end
	local an = hum.Parent:FindFirstChild("Animate")
	if not (an and an:IsA("LocalScript")) then
		return F.toast("Este jogo não usa o script Animate padrão: não dá para trocar as animações", "err")
	end
	local det = E.fetchDetails(it)
	if not det or #det.bundled == 0 then return F.toast("Não consegui ler o conteúdo do pacote", "err") end
	local bySlot, total = {}, 0
	for _, b in ipairs(det.bundled) do
		local s = E.slotOf(b.name)
		if s and s ~= "mood" then
			bySlot[s] = bySlot[s] or {}
			table.insert(bySlot[s], b.id)
			total = total + 1
		end
	end
	if total == 0 then return F.toast("Este pacote não tem animações de movimento aplicáveis", "err") end
	local res, pending = {}, 0
	for slot, ids in pairs(bySlot) do
		for _, aid in ipairs(ids) do
			pending = pending + 1
			task.spawn(function()
				local list = E.resolve(aid, true)
				res[slot] = res[slot] or {}
				for _, v in ipairs(list) do table.insert(res[slot], v) end
				pending = pending - 1
			end)
		end
	end
	local t0 = os.clock()
	while pending > 0 and os.clock() - t0 < 20 and not V.closing do task.wait(0.1) end
	if aliveHum() ~= hum then return F.toast("O personagem mudou durante a aplicação", "err") end
	local applied = 0
	E.reanimate(an, hum, function()
		E.restoreOrig()
		E.captureOrig(an)
		for slot, ids in pairs(res) do
			if #ids > 0 and E.setFolder(an, slot, ids) then applied = applied + 1 end
		end
	end)
	if applied == 0 then return F.toast("Nenhuma animação do pacote pôde ser aplicada", "err") end
	E.eq = { id = it.id, n = it.name or "Pacote", c = it.creator }
	E.applied = res
	F.toast(("Pacote equipado: %s (%d animações)"):format(it.name or "pacote", applied), "on")
end
function E.togglePack(it)
	if E.eq and E.eq.id == it.id then return E.unequipPack() end
	if E.busy then return F.toast("Aguarde: ainda aplicando outro pacote", "err") end
	E.busy, E.busyId = true, it.id
	E.refreshStates()
	F.toast("Aplicando: " .. (it.name or "pacote") .. "...", "ok")
	task.spawn(function()
		local ok, err = pcall(E.doEquip, it)
		E.busy, E.busyId = false, nil
		if not ok then F.toast("Falha ao equipar: " .. E.clean(err), "err") end
		E.refreshStates()
	end)
end
function E.unequipPack(silent)
	if not E.eq then
		if not silent then F.toast("Nenhum pacote equipado", "err") end
		return
	end
	E.eq, E.applied = nil, nil
	local hum = aliveHum()
	local an = hum and hum.Parent:FindFirstChild("Animate")
	if an and an:IsA("LocalScript") then task.spawn(E.reanimate, an, hum, E.restoreOrig)
	else E.restoreOrig() end
	E.refreshStates()
	if not silent then F.toast("Animações originais restauradas", "off") end
end

---------------------------------------------------------------- EMOTES: tocar, biblioteca (Meu menu), menu oficial do Roblox (.)
function E.stopEmote()
	if E.emoteC then E.emoteC:Disconnect() E.emoteC = nil end
	local t = E.track
	E.track, E.playingId, E.loadingId = nil, nil, nil
	if t then pcall(function() t:Stop(0.2) end) end
	E.refreshStates()
end
function E.playEmote(it)
	if E.playingId == it.id then return E.stopEmote() end
	local hum = aliveHum()
	local animator = hum and hum:FindFirstChildOfClass("Animator")
	if not animator then return F.toast("Sem personagem para tocar o emote", "err") end
	E.stopEmote()
	E.loadingId = it.id
	task.spawn(function()
		local track
		for _, id in ipairs(E.resolve(it.id, true)) do
			local anim = Instance.new("Animation")
			anim.AnimationId = id
			local ok, t = pcall(function() return animator:LoadAnimation(anim) end)
			if ok and t then
				local t0 = os.clock()
				while t.Length == 0 and os.clock() - t0 < 3 do task.wait(0.1) end
				if t.Length > 0 then track = t break end
				pcall(function() t:Destroy() end)
			end
		end
		if E.loadingId ~= it.id then
			if track then pcall(function() track:Destroy() end) end
			return
		end
		E.loadingId = nil
		if not track then
			F.toast("O emote não carregou (animação privada, sem permissão ou removida)", "err")
			return E.refreshStates()
		end
		track.Priority = Enum.AnimationPriority.Action4
		if it.loop then track.Looped = true end
		E.track, E.playingId = track, it.id
		track:Play(0.2)
		track.Stopped:Connect(function()
			if E.track == track then
				if E.emoteC then E.emoteC:Disconnect() E.emoteC = nil end
				E.track, E.playingId = nil, nil
				E.refreshStates()
			end
		end)
		E.emoteC = RS.Heartbeat:Connect(function() -- qualquer movimento cancela o emote
			local h = aliveHum()
			if h ~= hum or (h.MoveDirection.Magnitude > 0.1 and not E.walkEmote) or h.Jump then E.stopEmote() end
		end)
		E.refreshStates()
	end)
end

function E.libAdd(it)
	if E.libIdx(it.id) then return F.toast("Já está no seu menu: " .. (it.name or "emote"), "err") end
	if #D.lib >= LIB_MAX then return F.toast("Menu cheio (máximo de " .. LIB_MAX .. " emotes)", "err") end
	D.lib[#D.lib + 1] = { id = it.id, n = it.name or "", c = it.creator or "" }
	if E.wmode == "emote" then E.page = E.pageOf(#D.lib, "emote") end
	F.save()
	F.toast("Adicionado ao menu: " .. (it.name or "emote") .. "  ·  página " .. E.page, "on")
	if not it.name then
		task.spawn(function()
			pcall(E.fetchDetails, it)
			E.updateCards(it)
			E.renderMenu()
		end)
	end
	E.afterLib(true)
end
function E.libRemove(idx)
	local e = D.lib[idx]
	if not e then return end
	table.remove(D.lib, idx)
	if E.selIdx then
		if E.selIdx == idx then E.selIdx = nil elseif E.selIdx > idx then E.selIdx = E.selIdx - 1 end
	end
	if E.wmode == "emote" then E.page = math.clamp(E.page, 1, E.pageCount()) end
	F.save()
	F.toast("Removido do menu: " .. (e.n ~= "" and e.n or "emote"), "off")
	E.afterLib(false)
end
function E.libMove(idx, delta)
	local to = math.clamp(idx + delta, 1, #D.lib)
	if to == idx then return F.toast("Já está no limite do menu", "err") end
	table.insert(D.lib, to, table.remove(D.lib, idx))
	E.selIdx = to
	if E.wmode == "emote" then E.page = E.pageOf(to, "emote") end
	F.save()
	E.afterLib(false)
	F.snd("tab", 1.3)
end
function E.libToggle(it)
	local i = E.libIdx(it.id)
	if i then E.libRemove(i) else E.libAdd(it) end
end
function E.afterLib(added)
	E.renderMenu()
	E.refreshStates()
	if E.sync then
		E.pushWheel(true)
	elseif E.auto and not E.manualOff and #E.wl() > 0 then -- envio automático: liga a sincronização com o menu do Roblox sozinho
		E.setSync(true, true)
	end
end
function E.setPage(p, dir)
	E.page = (p - 1) % E.pageCount() + 1
	E.renderMenu(dir)
	if E.sync then E.pushWheel(true) end
	F.snd("tab", 1.2)
end

-- menu oficial (tecla "."): usa o HumanoidDescription local; o que não for permitido pelo jogo vira aviso, não simulação
function E.descObj()
	local hum = aliveHum()
	return hum and hum:FindFirstChildOfClass("HumanoidDescription"), hum
end
function E.wheelName(it, used)
	local n = tostring(it.n ~= nil and it.n or ""):gsub("%c", "")
	n = n:sub(1, 28)
	if n == "" then n = "Emote " .. string.format("%.0f", it.id) end
	if used[n] and used[n] ~= it.id then n = n:sub(1, 20) .. " #" .. string.format("%.0f", it.id):sub(-4) end
	used[n] = it.id
	return n
end
---------------------------------------------------------------- packs na roda, alternar emotes/packs, andar durante o emote
function E.libIdxP(id)
	for i, e in ipairs(D.libP) do
		if e.id == id then return i end
	end
	return nil
end
function E.libAddP(it)
	if E.libIdxP(it.id) then return F.toast("Este pack já está na roda: " .. (it.name or "pack"), "err") end
	if #D.libP >= LIB_MAX then return F.toast("Roda cheia (máximo de " .. LIB_MAX .. " packs)", "err") end
	local e = { id = it.id, n = it.name or "", c = it.creator or "" }
	D.libP[#D.libP + 1] = e -- sempre no fim: a ordem das abas nunca muda
	if E.wmode == "pack" then E.page = E.pageOf(#D.libP, "pack") end
	F.save()
	F.toast("Pack salvo na roda: " .. (it.name or "pack"), "on")
	task.spawn(function()
		-- descobre a animação "parado" do pack: é ela que vira o item da roda nativa
		local ok, det = pcall(E.fetchDetails, it)
		if ok and det then
			local pick
			for _, b in ipairs(det.bundled) do
				if E.slotOf(b.name) == "idle" then pick = b.id break end
			end
			if not pick then
				for _, b in ipairs(det.bundled) do
					local sl = E.slotOf(b.name)
					if sl and sl ~= "mood" then pick = b.id break end
				end
			end
			e.a = pick
			if (not e.n or e.n == "") and it.name then e.n = it.name end
		end
		F.save()
		E.afterLib(false)
		E.refreshStates()
	end)
	E.afterLib(false)
end
function E.libRemoveP(idx)
	local e = D.libP[idx]
	if not e then return end
	table.remove(D.libP, idx)
	if E.wmode == "pack" then E.page = math.clamp(E.page, 1, E.pageCount()) end
	F.save()
	F.toast("Pack removido da roda: " .. (e.n ~= "" and e.n or "pack"), "off")
	E.afterLib(false)
	E.refreshStates()
end
function E.libToggleP(it)
	local i = E.libIdxP(it.id)
	if i then E.libRemoveP(i) else E.libAddP(it) end
end
-- pack de voo salvo/importado/apagado: manda para a roda automaticamente e mostra a página dele
function E.afterFly(name)
	if name and E.wmode ~= "fly" then E.setWMode("fly") end
	local l = E.wl()
	if E.wmode == "fly" then
		if name then
			for i, e in ipairs(l) do
				if e.n == name then E.page = E.pageOf(i, "fly") break end
			end
		end
		E.page = math.clamp(E.page, 1, E.pageCount())
	end
	E.renderMenu()
	if E.sync then
		E.pushWheel(true)
	elseif E.auto and not E.manualOff and #l > 0 then
		E.setSync(true, true)
	end
	if name then F.toast("🕊️ Pack de voo enviado à roda: " .. name, "on") end
end
function E.setWMode(m)
	if m == E.wmode then return end
	E.pgW[E.wmode] = E.page
	E.wmode = m
	E.page = math.clamp(E.pgW[m] or 1, 1, E.pageCount())
	if E.sync then E.pushWheel(true) end
	E.renderMenu()
	F.toast(m == "pack" and "Roda: packs de animação (escolher um pack o equipa)"
		or m == "fly" and "Roda: packs de voo (escolher um pack aplica o voo dele)" or "Roda: emotes", "on")
	if m == "fly" and #E.wl() == 0 then F.toast("Nenhum pack de voo salvo ainda (aba Movimento → Packs de voo)", "err") end
	F.snd("tab", 1.2)
end
function E.setWalk(on)
	E.walkEmote = on and true or false
	D.walk = E.walkEmote
	F.save()
	if not E.walkEmote and E.wk then pcall(function() E.wk:Stop(0.2) end) E.wk = nil end
	F.toast(E.walkEmote and "Andar durante o emote: ligado" or "Andar durante o emote: desligado (mover cancela o emote)", E.walkEmote and "on" or "off")
end
E.own = setmetatable({}, { __mode = "k" })
function E.emoHookStop()
	if E.emoC then E.emoC:Disconnect() E.emoC = nil end
	if E.wk then pcall(function() E.wk:Stop(0.2) end) E.wk = nil end
end
-- mantém o emote tocando mesmo andando: o Animate do Roblox para o emote nativo ao se mover, então tocamos uma cópia com prioridade maior
function E.keepEmote(orig, hum, an)
	if E.wk then pcall(function() E.wk:Stop(0.1) end) E.wk = nil end
	-- CORREÇÃO (outros jogadores não viam o emote ao andar): antes, uma cópia da animação tocava JUNTO com a original
	-- (duas faixas com o mesmo ID), o que quebrava a replicação. Agora a original toca sozinha e a cópia só começa
	-- no instante em que o Animate para a original porque você começou a andar.
	local animId, looped = orig.Animation.AnimationId, orig.Looped
	local lastPos, len = 0, orig.Length
	local hb = RS.Heartbeat:Connect(function()
		if orig.IsPlaying then lastPos = orig.TimePosition end
	end)
	orig.Stopped:Connect(function()
		hb:Disconnect()
		if not E.walkEmote or E.wk or V.closing then return end
		local h = aliveHum()
		if h ~= hum or h.Health <= 0 or h.Jump then return end
		if h.MoveDirection.Magnitude < 0.1 then return end -- parou por outro motivo
		if not looped and len > 0 and lastPos >= len - 0.15 then return end -- terminou sozinho
		local anim = Instance.new("Animation")
		anim.AnimationId = animId
		local ok, t = pcall(function() return an:LoadAnimation(anim) end)
		if not (ok and t) then return end
		E.own[t] = true
		t.Priority, t.Looped = Enum.AnimationPriority.Action4, looped
		t:Play(0.15)
		pcall(function() t.TimePosition = lastPos end)
		E.wk = t
		t.Stopped:Connect(function() if E.wk == t then E.wk = nil end end)
		local c
		c = hum.StateChanged:Connect(function(_, new)
			if E.wk ~= t then c:Disconnect() return end
			if new == Enum.HumanoidStateType.Jumping then t:Stop(0.2) end -- pular encerra o emote
		end)
	end)
end
-- CORREÇÃO ("Você não pode usar emotes no momento"):
-- A animação de um pack (idle etc.) não é um asset de Emote, então o Humanoid:PlayEmote nativo recusa tocá-la e o Roblox
-- mostra o aviso sem tocar nada (por isso o AnimationPlayed nunca disparava e o pack não era equipado).
-- Agora interceptamos a chamada PlayEmote / PlayEmoteAndGetAnimTrackById feita pelo menu nativo: se o item escolhido for um
-- pack da roda, o Roblox recebe "true" (sem aviso) e o pack é equipado/desequipado pelo mesmo caminho do Meu menu (E.togglePack).
function E.packFromEmote(method, arg)
	if V.closing or not E.sync then return nil end
	if method == "PlayEmote" then
		return type(arg) == "string" and E.wheelPN and E.wheelPN[arg] or nil
	end
	local n = tonumber(arg)
	return n and E.wheelPI and E.wheelPI[n] or nil
end
-- dispara o pack (com trava: o mesmo pack não é acionado duas vezes em 1,2 s por caminhos diferentes)
function E.triggerPack(pk)
	local now = os.clock()
	local key = pk.fly and ("fly:" .. pk.n) or pk.id
	if E.lastTrig and E.lastTrig.id == key and now - E.lastTrig.t < 1.2 then return end
	E.lastTrig = { id = key, t = now }
	if pk.fly then return task.defer(F.faApplyWheel, pk) end
	task.defer(E.togglePack, E.mk("pack", pk.id, pk.n, pk.c))
end
function E.installEmoteHook()
	local genv = (getgenv and getgenv()) or _G
	-- o handler sempre aponta para a execução mais recente do script (reexecutar não empilha comportamento antigo)
	genv.__FoxPackIntercept = function(self, method, arg)
		if typeof(self) ~= "Instance" or self.ClassName ~= "Humanoid" then return false end
		if E.sync and E.wmode ~= "emote" then warn("[FoxMenu] menu nativo chamou " .. method .. "(" .. tostring(arg) .. ")") end
		local pk = E.packFromEmote(method, arg)
		if not pk then return false end
		E.triggerPack(pk)
		return true
	end
	local any = false
	-- (A) hookfunction nos métodos (pega a chamada mesmo quando não passa pelo __namecall)
	if hookfunction and not genv.__FoxPackHookedFn then
		local okf = pcall(function()
			local dummy = Instance.new("Humanoid")
			for _, name in ipairs({ "PlayEmote", "PlayEmoteAndGetAnimTrackById" }) do
				local fn = dummy[name]
				local orig
				orig = hookfunction(fn, newcclosure(function(self, ...)
					local h = genv.__FoxPackIntercept
					if h then
						local okh, handled = pcall(h, self, name, (...))
						if okh and handled then return true end
					end
					return orig(self, ...)
				end))
			end
			dummy:Destroy()
		end)
		if okf then genv.__FoxPackHookedFn, any = true, true end
	elseif genv.__FoxPackHookedFn then any = true end
	-- (B) __namecall (mesmo padrão do Never Fail)
	if not genv.__FoxPackHooked then
		local ok = pcall(function()
			local mt = getrawmetatable(game)
			local old = mt.__namecall
			setreadonly(mt, false)
			mt.__namecall = newcclosure(function(self, ...)
				local m = getnamecallmethod()
				if m == "PlayEmote" or m == "PlayEmoteAndGetAnimTrackById" then
					local h = genv.__FoxPackIntercept
					if h then
						local okh, handled = pcall(h, self, m, (...))
						if okh and handled then return true end
					end
					if setnamecallmethod then setnamecallmethod(m) end
				end
				return old(self, ...)
			end)
			setreadonly(mt, true)
		end)
		if ok then genv.__FoxPackHooked, any = true, true end
	else any = true end
	return any
end
function E.emoHook()
	if E.emoC then E.emoC:Disconnect() E.emoC = nil end
	if not E.hookTried then
		E.hookTried = true
		if not E.installEmoteHook() then
			F.toast("Seu executor não permite interceptar o menu nativo: para equipar packs use a aba Free Emotes", "err")
		end
	end
	local hum = aliveHum()
	local an = hum and hum:FindFirstChildOfClass("Animator")
	if not an then return end
	E.emoC = an.AnimationPlayed:Connect(function(tr)
		if E.own[tr] or X.fbOwn[tr] or tr == E.track or not E.sync then return end
		local id = tonumber(E.idNum(tr.Animation and tr.Animation.AnimationId))
		local hit = id and E.idMap[id]
		if not hit then return end
		if hit.kind == "pack" then
			-- CORREÇÃO: depois de equipar, o próprio Animate toca a animação "parado" do pack (o mesmo ID que está na roda).
			-- Isso NÃO é um clique: antes o script parava a animação e desequipava o pack logo em seguida.
			if E.busy or (E.eq and E.eq.id == hit.e.id) then return end
			if E.lastTrig and os.clock() - E.lastTrig.t < 8 then return end
			pcall(function() tr:Stop(0) end)
			E.triggerPack(hit.e)
		elseif hit.kind == "fly" then
			if E.lastTrig and os.clock() - E.lastTrig.t < 8 then return end
			pcall(function() tr:Stop(0) end)
			E.triggerPack(hit.e)
		elseif E.walkEmote then
			task.defer(E.keepEmote, tr, hum, an)
		end
	end)
end
function E.pushWheel(silent)
	local desc, hum = E.descObj()
	if not desc then
		if not silent then F.toast("Este jogo não expõe o HumanoidDescription (o menu nativo não pode ser alterado aqui)", "err") end
		return false
	end
	if hum.RigType ~= Enum.HumanoidRigType.R15 then
		if not silent then F.toast("O menu de emotes do Roblox só funciona em personagens R15", "err") end
		return false
	end
	if E.wheelDesc ~= desc then E.wheelDesc, E.wheelBackup, E.wheelAdded = desc, nil, {} end
	if not E.wheelBackup then
		local ok1, e1 = pcall(function() return desc:GetEmotes() end)
		local ok2, e2 = pcall(function() return desc:GetEquippedEmotes() end)
		E.wheelBackup = { emotes = ok1 and e1 or {}, equipped = ok2 and e2 or {} }
	end
	local emotes = {}
	local okc, cur = pcall(function() return desc:GetEmotes() end)
	if okc and type(cur) == "table" then
		for k, v in pairs(cur) do
			if not E.wheelAdded[k] then emotes[k] = v end -- mantém os emotes originais; os nossos são regravados sem duplicar
		end
	end
	local used, pageNames = {}, {}
	E.wheelAdded = {}
	for k in pairs(E.wheelBackup.emotes or {}) do used[k] = "orig" end -- nomes que já existem na roda original: os nossos nunca os sobrescrevem
	local K, origList = E.off(E.wmode), E.origNames()
	E.wheelPN, E.wheelPI, E.wheelPNL = {}, {}, {} -- nome na roda -> pack · id da animação -> pack (usados pelo interceptador de PlayEmote)
	local isPack, isFly = E.wmode == "pack", E.wmode == "fly"
	local special = isPack or isFly
	local items = {}
	local list, cnt = E.wl(), {}
	if isFly then for _, e in ipairs(list) do cnt[e.a] = (cnt[e.a] or 0) + 1 end end
	for i, e in ipairs(list) do
		local aid = special and e.a or e.id
		if aid then
			local nm
			if isFly then nm = E.wheelName({ n = "🕊️ " .. e.n, id = i }, used)
			elseif isPack then nm = E.wheelName({ n = "📦 " .. (e.n ~= "" and e.n or "Pack"), id = e.id }, used)
			else nm = E.wheelName(e, used) end
			emotes[nm] = { aid }
			E.wheelAdded[nm] = true
			-- packs de voo costumam compartilhar a mesma animação "parado": só mapeia por ID quando ela é única (o nome sempre mapeia)
			local unique = not isFly or cnt[aid] == 1
			if special then
				E.wheelPN[nm] = e
				E.wheelPNL[nm:lower()] = e
				if unique then E.wheelPI[tonumber(aid) or 0] = e end
			end
			local v = K + i -- posição na lista virtual (originais primeiro)
			if v > (E.page - 1) * PER_PAGE and v <= E.page * PER_PAGE then
				pageNames[#pageNames + 1] = nm
				items[#items + 1] = { e = e, aid = aid, kind = isFly and "fly" or (isPack and "pack" or "emote"), skip = not unique }
			end
		end
	end
	-- slots da página atual = emotes ORIGINAIS que caem nesta página + itens do FoxMenu desta página (nunca passa de 8)
	local finalNames = {}
	for j = 1, K do
		if j > (E.page - 1) * PER_PAGE and j <= E.page * PER_PAGE and origList[j] then finalNames[#finalNames + 1] = origList[j] end
	end
	for _, n in ipairs(pageNames) do finalNames[#finalNames + 1] = n end
	local ok, err = pcall(function()
		desc:SetEmotes(emotes)
		desc:SetEquippedEmotes(finalNames)
	end)
	if not ok then
		if not silent then F.toast("O jogo bloqueou a alteração do menu: " .. E.clean(err), "err") end
		return false
	end
	-- ordem fixa: confere como o Roblox guardou os slots e, se vierem invertidos, regrava invertido
	if #finalNames > 1 then
		local okg, got = pcall(function() return desc:GetEquippedEmotes() end)
		if okg and type(got) == "table" then
			table.sort(got, function(a, b) return (a.Slot or 0) < (b.Slot or 0) end)
			if got[1] and got[1].Name ~= finalNames[1] then
				local rev = {}
				for i = #finalNames, 1, -1 do rev[#rev + 1] = finalNames[i] end
				pcall(function() desc:SetEquippedEmotes(rev) end)
			end
		end
	end
	-- mapa animação -> item da roda (para reconhecer qual emote/pack foi escolhido no menu nativo)
	E.mapTok = (E.mapTok or 0) + 1
	local mtok = E.mapTok
	task.spawn(function()
		local map = {}
		for _, p in ipairs(items) do
			if not p.skip then
				map[tonumber(p.aid)] = p
				if p.kind ~= "fly" then map[tonumber(p.e.id)] = map[tonumber(p.e.id)] or p end
				for _, rid in ipairs(E.resolve(p.aid)) do
					local n = tonumber(E.idNum(rid))
					if n then map[n] = p end
				end
			end
		end
		if E.mapTok == mtok then E.idMap = map end
	end)
	pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.EmotesMenu, true) end)
	return true
end
function E.restoreWheel()
	E.origB, E.origL, E.origLive = nil, nil, nil
	local desc, b = E.wheelDesc, E.wheelBackup
	E.wheelDesc, E.wheelBackup, E.wheelAdded = nil, nil, {}
	E.wheelPN, E.wheelPI, E.wheelPNL = {}, {}, {}
	if not (desc and desc.Parent and b) then return end
	pcall(function()
		desc:SetEmotes(b.emotes)
		local arr = {}
		for _, v in ipairs(b.equipped) do arr[#arr + 1] = v end
		table.sort(arr, function(x, y) return (x.Slot or 0) < (y.Slot or 0) end)
		local names = {}
		for _, v in ipairs(arr) do names[#names + 1] = v.Name end
		desc:SetEquippedEmotes(names)
	end)
end
function E.setSync(on, silent)
	if on then
		E.sync = E.pushWheel(false)
		if E.sync then E.natStart() end
		if E.sync and not silent then
			F.toast("Menu do Roblox (.) sincronizado com a página " .. E.page .. " · seus emotes originais ficam no começo da roda", "on")
		end
	else
		E.sync = false
		E.natStop()
		E.restoreWheel()
		if not silent then F.toast("Menu do Roblox (.) restaurado ao original", "off") end
	end
	E.refreshMenuBar()
end

---------------------------------------------------------------- componentes visuais
function E.paintBtn(b)
	local on = b:GetAttribute("on")
	F.tw(b, { BackgroundColor3 = on and C.white or C.panel, TextColor3 = on and C.black or C.text }, 0.15)
end
function E.setOn(b, on, text)
	on = on and true or false
	if b:GetAttribute("on") == on and (text == nil or b.Text == text) then return end
	b:SetAttribute("on", on)
	if text then b.Text = text end
	E.paintBtn(b)
end
function E.btn(parent, text, size, pos, cb, order)
	local b = F.new("TextButton", { Size = size, Position = pos or U2(), BackgroundColor3 = C.panel, Text = text, TextColor3 = C.text,
		Font = EF.GothamBold, TextSize = 11, AutoButtonColor = false, LayoutOrder = order or 0, BorderSizePixel = 0, R = 9 }, parent)
	F.press(b, "white")
	b:SetAttribute("on", false)
	b.MouseEnter:Connect(function() if not b:GetAttribute("on") then F.tw(b, { BackgroundColor3 = C.hover }, 0.12) end end)
	b.MouseLeave:Connect(function() E.paintBtn(b) end)
	b.MouseButton1Click:Connect(function() F.click() cb() end)
	return b
end
function E.primary(it)
	if it.kind == "pack" then E.togglePack(it) else E.libToggle(it) end
end
function E.skeleton(parent, n)
	for i = 1, n do
		local f = F.new("Frame", { BackgroundColor3 = C.item, LayoutOrder = i, BorderSizePixel = 0, R = 12 }, parent)
		F.new("Frame", { Size = U2(1, -16, 0, 118), Position = U2o(8, 8), BackgroundColor3 = C.panel, BorderSizePixel = 0, R = 10 }, f)
		F.new("Frame", { Size = U2(0.7, 0, 0, 12), Position = U2o(8, 135), BackgroundColor3 = C.panel, BorderSizePixel = 0, R = 6 }, f)
		F.new("Frame", { Size = U2(0.45, 0, 0, 10), Position = U2o(8, 153), BackgroundColor3 = C.panel, BorderSizePixel = 0, R = 5 }, f)
		F.new("Frame", { Size = U2(1, -16, 0, 28), Position = U2o(8, 170), BackgroundColor3 = C.panel, BorderSizePixel = 0, R = 8 }, f)
		TS:Create(f, TweenInfo.new(0.7, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { BackgroundTransparency = 0.55 }):Play()
	end
end
---------------------------------------------------------------- prévia ao passar o mouse sobre um pacote de animação
-- (emotes: toca o emote em loop)  toca no seu boneco: parado -> andando -> correndo -> pulando -> caindo -> escalando -> nadando (sem equipar nada)
E.pv = { tok = 0, tracks = {}, cache = {}, hb = nil }
E.PV_ORDER = {
	{ "idle", "Parado", 2.6 }, { "walk", "Andando", 2.4 }, { "run", "Correndo", 2.4 }, { "jump", "Pulando", 1.3 },
	{ "fall", "Caindo", 1.3 }, { "climb", "Escalando", 2.2 }, { "swim", "Nadando", 2.2 }, { "swimidle", "Boiando", 2.2 },
}
-- O boneco da prévia é montado UMA vez por personagem (antes: personagem.Clone() a cada passada de mouse = trava)
-- e reaproveitado: só o ViewportFrame troca de card. As faixas de animação também ficam em cache no boneco.
function E.pvRig()
	local hum = aliveHum()
	if not hum then return nil end
	local char = hum.Parent
	local sig = 0 -- só visual (acessórios/roupas): equipar uma ferramenta não força refazer o boneco
	for _, c in ipairs(char:GetChildren()) do
		if not c:IsA("Tool") then sig = sig + 1 end
	end
	local r = E.pv.rig
	if r and r.char == char and r.sig == sig then return r end
	if r then pcall(function() r.vp:Destroy() end) E.pv.rig = nil end
	if hum.RigType ~= Enum.HumanoidRigType.R15 then return nil, "rig" end
	local wasArch = char.Archivable
	char.Archivable = true
	local okc, clone = pcall(function() return char:Clone() end)
	char.Archivable = wasArch
	local root = okc and clone and clone:FindFirstChild("HumanoidRootPart")
	local chum = okc and clone and clone:FindFirstChildOfClass("Humanoid")
	if not (root and chum) then
		if clone then pcall(function() clone:Destroy() end) end
		return nil, "clone"
	end
	for _, d in ipairs(clone:GetDescendants()) do
		if d:IsA("LuaSourceContainer") or d:IsA("Sound") or d:IsA("ForceField") or d:IsA("BillboardGui") then
			pcall(function() d:Destroy() end)
		end
	end
	chum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	root.Anchored = true
	local vp = Instance.new("ViewportFrame")
	vp.Size, vp.BackgroundTransparency, vp.BorderSizePixel, vp.ZIndex = UDim2.fromScale(1, 1), 1, 0, 2
	vp.Active = false
	local cam = Instance.new("Camera")
	cam.FieldOfView = 38
	local rc = root.CFrame
	cam.CFrame = CFrame.lookAt(rc.Position + rc.LookVector * 8.5 + Vector3.new(0, 0.9, 0), rc.Position + Vector3.new(0, 0.3, 0))
	cam.Parent = vp
	vp.CurrentCamera = cam
	local wm = Instance.new("WorldModel")
	wm.Parent = vp
	clone.Parent = wm
	local animator = chum:FindFirstChildOfClass("Animator")
	if not animator then animator = Instance.new("Animator") animator.Parent = chum end
	r = { char = char, sig = sig, vp = vp, animator = animator, tc = {}, ntc = 0 }
	E.pv.rig = r
	return r
end
-- monta o boneco em segundo plano (fora do gesto do usuário) assim que a aba abre ou o personagem muda
function E.pvPrep()
	if E.pv.prepping then return end
	E.pv.prepping = true
	task.delay(0.6, function()
		E.pv.prepping = false
		if not V.closing then pcall(E.pvRig) end
	end)
end
-- libera a prévia (ViewportFrame + faixas em cache) depois de um tempo sem uso: evita acumular memória de GPU em sessões longas navegando por muitas páginas
E.pv.idleWatch = false
function E.pvIdleWatch()
	if E.pv.idleWatch then return end
	E.pv.idleWatch = true
	task.spawn(function()
		while not V.closing do
			task.wait(5)
			local r = E.pv.rig
			if r and not E.pv.hb then
				local idle = os.clock() - (E.pv.lastUse or 0)
				if idle > 30 and r.ntc > 0 then -- só esvazia as faixas de animação (leve); o boneco continua pronto
					pcall(function() for _, t in pairs(r.tc) do t:Stop(0) t:Destroy() end end)
					r.tc, r.ntc = {}, 0
				end
				if idle > 600 then -- 10 min sem usar: aí sim libera o boneco
					pcall(function() r.vp:Destroy() end)
					E.pv.rig = nil
				end
			end
		end
		E.pv.idleWatch = false
	end)
end
E.pvIdleWatch()
function E.pvStop()
	E.pv.lastUse = os.clock()
	E.pv.tok = E.pv.tok + 1
	for _, t in ipairs(E.pv.tracks) do pcall(function() t:Stop(0.1) end) end
	E.pv.tracks = {}
	if E.pv.hb then E.pv.hb:Disconnect() E.pv.hb = nil end
	if E.pv.lbl then pcall(function() E.pv.lbl.Visible = false end) E.pv.lbl = nil end
	if E.pv.img then pcall(function() E.pv.img.Visible = true end) E.pv.img = nil end
	if E.pv.step then E.pv.step:Disconnect() E.pv.step = nil end
	local r = E.pv.rig
	if r and r.vp then pcall(function() r.vp.Parent = nil end) end -- não destrói: o boneco fica pronto para o próximo card
end
function E.pvTrack(r, animId, dead)
	local t = r.tc[animId]
	if t then return t end
	local anim = Instance.new("Animation")
	anim.AnimationId = animId
	local ok, tr = pcall(function() return r.animator:LoadAnimation(anim) end)
	if not (ok and tr) then return nil end
	local t0 = os.clock()
	while tr.Length == 0 and os.clock() - t0 < 3 and not dead() do task.wait(0.05) end
	if tr.Length <= 0 then pcall(function() tr:Destroy() end) return nil end
	tr.Priority, tr.Looped = Enum.AnimationPriority.Action4, true
	if r.ntc >= 24 then -- limite de memória: esvazia o cache de faixas
		for _, x in pairs(r.tc) do pcall(function() x:Stop(0) x:Destroy() end) end
		r.tc, r.ntc = {}, 0
	end
	r.tc[animId] = tr
	r.ntc = r.ntc + 1
	return tr
end
function E.pvStart(it, th, lbl, img)
	E.pvStop()
	local tok = E.pv.tok
	E.pv.lbl, E.pv.img = lbl, img
	task.spawn(function()
		local function dead() return E.pv.tok ~= tok or V.closing or not th.Parent end
		local known = E.pv.cache[it.id] or E.det[it.kind .. ":" .. string.format("%.0f", it.id)]
		task.wait(known and 0.3 or 0.6) -- só começa se o mouse ficar parado em cima (itens ainda não baixados esperam mais: passar o mouse rápido não baixa nada)
		-- rolando a lista? espera parar (evita disparar prévia em todo card que passa sob o mouse)
		while os.clock() - (E.lastScroll or 0) < 0.45 and not dead() do task.wait(0.05) end
		if dead() then return end
		local r, why = E.pvRig()
		if not r then
			if why == "rig" then F.toast("A prévia só funciona em personagens R15", "err")
			elseif why == "clone" then F.toast("Não consegui copiar o seu boneco para a prévia", "err") end
			return
		end
		local vp = r.vp
		vp.Parent = th
		img.Visible = false -- some a foto enquanto a prévia roda; volta quando o mouse sai
		lbl.Text, lbl.Visible = "⏳ carregando prévia...", true
		-- animação fora do Workspace não anda sozinha: avança o Animator a cada quadro
		local anm = r.animator
		E.pv.step = RS.RenderStepped:Connect(function(dt) pcall(function() anm:StepAnimations(dt) end) end)
		E.pv.hb = RS.Heartbeat:Connect(function()
			local h = aliveHum()
			if not h or h.Parent ~= r.char or not th.Parent then E.pvStop() end
		end)
		-- quais animações existem (do cache em disco quando possível)
		local bySlot = E.pv.cache[it.id]
		if not bySlot then
			bySlot = {}
			if it.kind == "pack" then
				local det = E.fetchDetails(it)
				if dead() then return end
				if not det or #det.bundled == 0 then lbl.Visible, img.Visible = false, true return end
				for _, b in ipairs(det.bundled) do
					local sl = E.slotOf(b.name)
					if sl and sl ~= "mood" and not bySlot[sl] then bySlot[sl] = b.id end
				end
			else
				bySlot.emote = it.id
			end
			E.pv.cache[it.id] = bySlot
		end
		-- carrega em segundo plano, um slot por vez; a prévia começa assim que o PRIMEIRO fica pronto
		local seq, loaded = {}, false
		task.spawn(function()
			local first = true
			for _, d in ipairs(it.kind ~= "pack" and { { "emote", "Emote", 0.5 } } or E.PV_ORDER) do
				if dead() then return end
				local aid = bySlot[d[1]]
				if aid then
					local cached = E.anim[aid] ~= nil
					local list = E.resolve(aid, first, function() return not dead() end)
					if dead() then return end
					local id1 = list[1]
					if id1 then
						local t = E.pvTrack(r, id1, dead)
						if dead() then return end
						if t then
							seq[#seq + 1] = { t = t, name = d[2], dur = d[3] }
							first = false
						end
					end
					if not cached then task.wait(0.15) end
				end
			end
			loaded = true
		end)
		local idx = 1
		while not dead() do
			local e = seq[idx]
			if not e then
				if loaded then
					lbl.Visible, img.Visible = false, true
					return F.toast("Não consegui carregar a prévia deste pacote", "err")
				end
				task.wait(0.05)
			else
				for _, o in ipairs(E.pv.tracks) do if o ~= e.t and o.IsPlaying then o:Stop(0.15) end end
				E.pv.tracks = { e.t }
				lbl.Text, lbl.Visible = e.name, true
				if not e.t.IsPlaying then e.t:Play(0.15) end
				local t0 = os.clock()
				while os.clock() - t0 < e.dur and not dead() do task.wait(0.05) end
				idx = idx % #seq + 1
				if #seq == 1 and loaded then idx = 1 end
			end
		end
	end)
end
function E.card(parent, it, order)
	local f = F.new("Frame", { BackgroundColor3 = C.item, LayoutOrder = order, BorderSizePixel = 0, R = 12, S = 1 }, parent)
	if order <= 18 then -- listas grandes (muitas páginas/favoritos) não acumulam tween por item: só os primeiros entram animados
		local sc = F.new("UIScale", { Scale = 0.92 }, f)
		task.delay(((order - 1) % 6) * 0.03, function() if f.Parent then F.tw(sc, { Scale = 1 }, 0.3, BACK) end end)
	end
	f.MouseEnter:Connect(function() F.tw(f, { BackgroundColor3 = C.hover }, 0.12) end)
	f.MouseLeave:Connect(function() F.tw(f, { BackgroundColor3 = C.item }, 0.18) end)
	local th = F.new("TextButton", { Size = U2(1, -16, 0, 118), Position = U2o(8, 8), BackgroundColor3 = C.panel, Text = "", AutoButtonColor = false, BorderSizePixel = 0, R = 10 }, f)
	local ph = F.txt(th, "⏳", { Size = U2(1, 0, 1, 0), TextXAlignment = EXA.Center, TextSize = 26, TextColor3 = C.muted })
	local img = F.new("ImageLabel", { Size = U2(1, 0, 1, 0), BackgroundTransparency = 1, ScaleType = Enum.ScaleType.Fit, ImageTransparency = 1, BorderSizePixel = 0, R = 10 }, th)
	local thumbUrl = E.thumb(it.kind, it.id, 150)
	local near = E.isNear(order)
	if near then E.loadImg(img, thumbUrl, ph) end
	local star = F.new("TextButton", { Size = U2o(26, 26), Position = U2(1, -32, 0, 6), BackgroundColor3 = C.bg, BackgroundTransparency = 0.35, Text = "☆",
		TextColor3 = C.white, Font = EF.GothamBold, TextSize = 16, AutoButtonColor = false, ZIndex = 3, BorderSizePixel = 0, R = 13 }, th)
	local badge = F.txt(th, "", { Size = U2o(88, 18), Position = U2o(6, 6), BackgroundTransparency = 0, BackgroundColor3 = GREEN, TextColor3 = WHITE,
		Font = EF.GothamBold, TextSize = 10, TextXAlignment = EXA.Center, Visible = false, ZIndex = 3, R = 9 })
	local nm = F.txt(f, it.name or "Carregando...", { Size = U2(1, -16, 0, 16), Position = U2o(8, 132), Font = EF.GothamBold, TextSize = 12 })
	local cr = F.txt(f, it.creator and ("por @" .. it.creator) or "por ...", { Size = U2(1, -16, 0, 14), Position = U2o(8, 149), TextColor3 = C.muted, Font = EF.Gotham, TextSize = 11 })
	E.btn(f, "ℹ Ver", U2o(62, 28), U2o(8, 170), function() E.openDetails(it) end)
	local prim = E.btn(f, "...", U2(1, -80, 0, 28), U2o(74, 170), function() E.primary(it) end)
	do
		local pvl = F.txt(th, "", { Size = U2(1, -12, 0, 20), Position = U2(0, 6, 1, -26), BackgroundTransparency = 0.25, BackgroundColor3 = C.bg, TextColor3 = C.white,
			Font = EF.GothamBold, TextSize = 11, TextXAlignment = EXA.Center, Visible = false, ZIndex = 6, R = 9 })
		th.MouseEnter:Connect(function() E.pvStart(it, th, pvl, img) end)
		th.MouseLeave:Connect(function() E.pvStop() end)
	end
	th.MouseButton1Click:Connect(function() F.click() E.pvStop() E.openDetails(it) end)
	star.MouseButton1Click:Connect(function() F.click() E.toggleFav(it) end)
	E.cards[#E.cards + 1] = { f = f, it = it, nm = nm, cr = cr, star = star, badge = badge, prim = prim, sk = f:FindFirstChildOfClass("UIStroke"),
		img = img, ph = ph, url = thumbUrl, order = order, loaded = near }
	return f
end
-- Descarrega as miniaturas dos cards que estão longe da tela e recarrega quando voltam perto.
-- Usa só conta de linhas (3 colunas x 214px), sem ler propriedade nenhuma de cada card.
E.ROW_H, E.COLS = 214, 3
function E.isNear(order)
	local ui = E.ui
	if not (ui and ui.grid) then return true end
	local g = ui.grid
	local h = math.max(g.AbsoluteWindowSize.Y, 300)
	local y = math.floor((order - 1) / E.COLS) * E.ROW_H
	local cp = g.CanvasPosition.Y
	return y > cp - h * 1.5 - E.ROW_H and y < cp + h * 2.5
end
function E.cull()
	local ui = E.ui
	if not (ui and ui.grid) or E.view == nil then return end
	local n = 0
	for _, c in ipairs(E.cards) do
		if c.img and c.img.Parent then
			local near = E.isNear(c.order)
			if near and not c.loaded then
				c.loaded = true
				E.loadImg(c.img, c.url, c.ph)
				n = n + 1
				if n % 8 == 0 then task.wait() end -- recarrega aos poucos
			elseif not near and c.loaded then
				c.loaded = false
				c.img:SetAttribute("src", nil)
				c.img.Image = ""
				if c.ph then c.ph.Visible, c.ph.Text = true, "⏳" end
			end
		end
	end
end
function E.cullSoon()
	if E.cullQ then return end
	E.cullQ = true
	task.delay(0.25, function()
		E.cullQ = false
		if not V.closing then pcall(E.cull) end
	end)
end
function E.updateCards(it)
	for _, c in ipairs(E.cards) do
		if c.it == it and c.f.Parent then
			c.nm.Text = it.name or "Sem nome"
			c.cr.Text = it.creator and ("por @" .. it.creator) or "por criador desconhecido"
		end
	end
	if E.dsel == it then E.fillDetailsHeader() end
end
function E.toggleFav(it)
	local arr = it.kind == "pack" and D.favP or D.favE
	local isF, idx = E.isFav(it.kind, it.id)
	if isF then
		table.remove(arr, idx)
		F.toast("Removido dos favoritos: " .. (it.name or "item"), "off")
	else
		arr[#arr + 1] = { id = it.id, n = it.name or "", c = it.creator or "" }
		F.toast("Favoritado: " .. (it.name or "item"), "on")
		if not it.name then
			task.spawn(function() pcall(E.fetchDetails, it) E.updateCards(it) end)
		end
	end
	F.save()
	if E.view == "favs" then E.renderGrid() end
	E.refreshStates()
end

function E.refreshStates()
	local ui = E.ui
	if not ui then return end
	local alive = {}
	for _, c in ipairs(E.cards) do
		if c.f.Parent then
			alive[#alive + 1] = c
			local it = c.it
			local fav = E.isFav(it.kind, it.id)
			c.star.Text = fav and "★" or "☆"
			c.star.TextColor3 = fav and GOLD or C.white
			if it.kind == "pack" then
				local eq = E.eq ~= nil and E.eq.id == it.id
				c.badge.Text, c.badge.Visible = "✔ Equipado", eq
				if E.busy and E.busyId == it.id then E.setOn(c.prim, false, "Aplicando...")
				else E.setOn(c.prim, eq, eq and "Desequipar" or "Equipar") end
			else
				local inLib = E.libIdx(it.id) ~= nil
				c.badge.Text, c.badge.Visible = "● No menu", inLib
				E.setOn(c.prim, inLib, inLib and "✓ No menu" or "＋ Menu")
			end
			if c.sk then
				local want = (E.dsel == it) and 0.25 or 1
				if c.skT ~= want then c.skT = want F.tw(c.sk, { Transparency = want }, 0.15) end
			end
		end
	end
	E.cards = alive
	ui.vb.favs.Text = "⭐  Favoritos (" .. (#D.favP + #D.favE) .. ")"
	ui.vb.menu.Text = "🎭  Meu menu (" .. #D.lib .. ")"
	E.refreshCP()
	E.refreshMenuBar()
	E.refreshDetails()
end

---------------------------------------------------------------- grade de resultados / favoritos
function E.favItems()
	local arr = E.mode == "pack" and D.favP or D.favE
	local q = F.norm(E.q or "")
	local out = {}
	for _, e in ipairs(arr) do
		if q == "" or F.norm(e.n or ""):find(q, 1, true) or F.norm(e.c or ""):find(q, 1, true) then
			out[#out + 1] = E.mk(E.mode, e.id, e.n, e.c)
		end
	end
	return out
end
function E.curList()
	if E.view == "favs" then return E.favItems() end
	return E.items
end
function E.showMsg(icon, title, sub, btnText, cb)
	local ui = E.ui
	ui.grid.Visible, ui.msg.Visible = false, true
	ui.msgIcon.Text, ui.msgT.Text, ui.msgS.Text = icon, title, sub or ""
	ui.msgB.Visible = btnText ~= nil
	ui.msgCb = cb
	if btnText then ui.msgB.Text = btnText end
end
function E.renderGrid(append)
	local ui = E.ui
	if not ui then return end
	if not append then pcall(E.pvStop) end -- troca de lista: mata prévia em andamento antes de destruir os cards
	E.rtok = (E.rtok or 0) + 1 -- cancela qualquer criação de cards em andamento
	local rtok = E.rtok
	local searching = E.view == "search"
	local list = E.curList()
	local what = E.mode == "pack" and "pacotes de animação" or "emotes"
	if not append then
		for _, c in ipairs(ui.grid:GetChildren()) do
			if c:IsA("GuiObject") then c:Destroy() end
		end
		E.cards, E.shown = {}, 0
		ui.grid.CanvasPosition = Vector2.zero
	elseif ui.more then
		ui.more:Destroy()
		ui.more = nil
	end
	if searching and E.loading and #list == 0 then
		ui.msg.Visible, ui.grid.Visible = false, true
		E.skeleton(ui.grid, 6)
		ui.status.Text = "Buscando " .. what .. "..."
		return
	end
	if searching and E.err and #list == 0 then
		ui.status.Text = "Erro na busca"
		return E.showMsg("⚠️", "Não foi possível buscar", E.err, "Tentar novamente", function() E.query() end)
	end
	if #list == 0 then
		if searching then
			local q = (E.q:gsub("^%s+", ""):gsub("%s+$", ""))
			ui.status.Text = "0 resultados"
			return E.showMsg("🔎", q ~= "" and ("Nenhum resultado para “" .. q .. "”") or "Nada encontrado",
				"Tente outro nome, outro criador ou alterne entre Pacotes e Emotes.")
		end
		ui.status.Text = "0 favoritos"
		local q = (E.q:gsub("^%s+", ""):gsub("%s+$", ""))
		return E.showMsg("⭐", q ~= "" and "Nenhum favorito com esse filtro" or "Você ainda não favoritou " .. what,
			q ~= "" and "Limpe o filtro para ver todos." or "Toque na ☆ de qualquer item para guardá-lo aqui.")
	end
	ui.msg.Visible, ui.grid.Visible = false, true
	-- cards criados em lotes (antes: todos de uma vez no mesmo quadro = engasgo ao buscar / carregar mais)
	local total = #list
	local from = E.shown + 1
	local FIRST, BATCH = 6, 4
	local function build(a, b)
		for i = a, b do
			if rtok ~= E.rtok or not ui.grid.Parent then return false end
			E.card(ui.grid, list[i], i)
			E.shown = i
		end
		return true
	end
	local firstEnd = math.min(total, from + FIRST - 1)
	build(from, firstEnd)
	if firstEnd < total then
		task.spawn(function()
			local n = firstEnd + 1
			while n <= total do
				task.wait()
				if not build(n, math.min(total, n + BATCH - 1)) then return end
				n = n + BATCH
			end
			if rtok == E.rtok then E.refreshStates() end
		end)
	end
	local function pulseStatus()
		local c0 = ui.status.TextColor3
		ui.status.TextColor3 = C.white
		F.tw(ui.status, { TextColor3 = c0 }, 0.4)
	end
	if searching then
		if ui.status.Text ~= "" and not append then pulseStatus() end
		ui.status.Text = #list .. " resultado(s)" .. (E.finished and "" or "+") .. "  ·  " .. what
		if not E.finished then
			local mb = F.new("TextButton", { BackgroundColor3 = C.panel, Text = E.loadingMore and "Carregando..." or "＋  Carregar mais", TextColor3 = C.text,
				Font = EF.GothamBold, TextSize = 12, AutoButtonColor = false, LayoutOrder = 100000, BorderSizePixel = 0, R = 12 }, ui.grid)
			F.press(mb, "white")
