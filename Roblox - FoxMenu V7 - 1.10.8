-- L=seção N=nota T=toggle S=slider B=botão I=info C=escolha X=campo G=gráfico R=função
function F.build(parent, items, tab)
	V.ctx.tab, V.ctx.sec, V.ctx.key = tab, "", ""
	local cur = parent
	for _, it in ipairs(items) do
		local k = it[1]
		if k == "L" then cur = F.section(parent, tab, it[2], it[3])
		elseif k == "N" then F.note(cur, it[2], it[3])
		elseif k == "T" then F.toggle(cur, it[2], it[3], it[4], it[5], it[6])
		elseif k == "S" then F.slider(cur, table.unpack(it, 2))
		elseif k == "B" then F.button(cur, it[2], it[3], it[4])
		elseif k == "I" then V.I[it[3]] = F.info(cur, it[2])
		elseif k == "C" then F.choice(cur, it[2], it[3], it[4], it[5], it[6])
		elseif k == "X" then F.inputRow(cur, it[2], it[3], it[4], it[5])
		elseif k == "G" then V.G = V.G or {} V.G[it[5]] = F.graph(cur, it[2], it[3], it[4])
		elseif k == "R" then it[2](cur) end
	end
end
