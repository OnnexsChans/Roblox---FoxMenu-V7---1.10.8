F.rebuildHist = function()
	F.clearBox(V.histBox)
	local n = 0
	for _, name in ipairs(S.hist) do
		local p = Players:FindFirstChild(name)
		if p and p ~= player then
			n += 1
			local b = F.new("TextButton", { Size = U2(1, 0, 0, 34), BackgroundColor3 = C.item, Text = "  " .. p.DisplayName .. "  (@" .. p.Name .. ")", TextColor3 = C.text,
				Font = EF.GothamMedium, TextSize = 12, TextXAlignment = EXA.Left, AutoButtonColor = false, LayoutOrder = n, R = 10 }, V.histBox)
			F.interactive(b, "item", "hover")
			b.MouseButton1Click:Connect(function() F.click() F.selectTarget(p) end)
		end
	end
	if n == 0 then F.note(V.histBox, "Sem recentes neste servidor.", 20) end
end

local rows = {}
function F.paint(p, hov)
	local r = rows[p]
	if not r then return end
	local sel = p == V.target
	F.tw(r.btn, { BackgroundColor3 = sel and C.white or (hov and C.hover or C.item) }, 0.18)
	F.tw(r.name, { TextColor3 = sel and C.black or C.white }, 0.18)
	F.tw(r.sub, { TextColor3 = sel and C.black or C.muted, TextTransparency = sel and 0.35 or 0 }, 0.18)
end
function F.fillTargetInfo()
	local t = V.target
	if t then
		I.p_id(tostring(t.UserId))
		I.p_age(t.AccountAge .. " dias")
		local ok, m = pcall(function() return t.MembershipType.Name end)
		I.p_mem(ok and (m == "None" and "Nenhuma" or m) or "—")
		local d = F.dist(t)
		I.p_dist(d and (d .. " m") or "—")
	else
		I.p_id("—") I.p_age("—") I.p_mem("—") I.p_dist("—")
	end
end
F.refreshUI = function()
	for p in pairs(rows) do F.paint(p, false) end
	local t = V.target
	if t then
		tName.Text, tSub.Text = t.DisplayName, "@" .. t.Name
		F.setAvatar(tAv, t.UserId)
	else
		tName.Text, tSub.Text, tAv.Image = "Ninguém selecionado", "Escolha alguém na lista", ""
		tAv:SetAttribute("uid", 0)
	end
	local names = { attach = "Grudado nas costas", follow = "Seguindo", orbit = "Orbitando", stand = "Ao lado", headsit = "Na cabeça", drag = "Preso ao braço", worm = "Worm", face = "Zoando" }
	local txt = V.mode and names[V.mode] or "nenhuma"
	if V.spec then txt = (V.mode and txt .. " + " or "") .. "Espectando" end
	status.Text = "Ação ativa: " .. txt
	F.fillTargetInfo()
	F.syncActs()
end
F.rebuildList = function()
	for _, r in pairs(rows) do r.btn:Destroy() end
	rows = {}
	local q, n = F.norm(search.Text), 0
	for _, p in ipairs(F.others()) do
		if q == "" or F.norm(p.DisplayName):find(q, 1, true) or F.norm(p.Name):find(q, 1, true) then
			n += 1
			local b = F.new("TextButton", { Size = U2(1, 0, 0, 50), BackgroundColor3 = C.item, Text = "", AutoButtonColor = false, LayoutOrder = n, R = 12 }, list)
			local av = F.new("ImageLabel", { Size = U2o(34, 34), Position = U2o(8, 8), BackgroundColor3 = C.hover, BorderSizePixel = 0, ZIndex = 2, R = 17 }, b)
			F.setAvatar(av, p.UserId)
			rows[p] = {
				btn = b,
				name = F.txt(b, p.DisplayName, { Size = U2(1, -86, 0, 20), Position = U2o(50, 7), TextColor3 = C.white, Font = EF.GothamBold, ZIndex = 2 }),
				sub = F.txt(b, "@" .. p.Name, { Size = U2(1, -86, 0, 16), Position = U2o(50, 27), TextColor3 = C.muted, Font = EF.Gotham, TextSize = 11, ZIndex = 2 }),
			}
			local star = F.new("TextButton", { Size = U2o(24, 24), Position = U2(1, -30, 0, 5), BackgroundTransparency = 1, Text = S.pfav[p.Name] and "★" or "☆",
				TextColor3 = S.pfav[p.Name] and C3(255, 200, 60) or C.white, Font = EF.GothamBold, TextSize = 16, ZIndex = 3 }, b)
			star.MouseButton1Click:Connect(function() S.pfav[p.Name] = (not S.pfav[p.Name]) or nil F.save() F.rebuildList() end)
			F.press(b, "white")
			b.MouseEnter:Connect(function() F.paint(p, true) end)
			b.MouseLeave:Connect(function() F.paint(p, false) end)
			b.MouseButton1Click:Connect(function() F.click() F.selectTarget(V.target ~= p and p or nil) end)
		end
	end
	emptyL.Visible = n == 0
	F.refreshUI()
end
search:GetPropertyChangedSignal("Text"):Connect(function() F.rebuildList() end)
function F.notify(p, joined)
	task.spawn(function()
		local all = Reg.notifall and Reg.notifall.get()
		local fr = false
		if Reg.notiffriends and Reg.notiffriends.get() then
			local ok, r = pcall(function() return player:IsFriendsWith(p.UserId) end)
			fr = ok and r
		end
		if all then F.toast(p.DisplayName .. (joined and " entrou" or " saiu"))
		elseif fr then F.toast("Amigo " .. p.DisplayName .. (joined and " entrou" or " saiu")) end
	end)
end
F.track(Players.PlayerAdded:Connect(function(p) F.notify(p, true) task.defer(F.rebuildList) end))
F.track(Players.PlayerRemoving:Connect(function(p)
	F.notify(p, false)
	if V.tags[p] then V.tags[p]:Destroy() V.tags[p] = nil end
	if p == V.target then
		F.stopAction(true)
		if V.spec then F.setSpectate(false) end
		V.target = nil
		F.toast(p.DisplayName .. " saiu do jogo")
	end
	task.defer(function() F.rebuildList() F.rebuildHist() end)
end))

