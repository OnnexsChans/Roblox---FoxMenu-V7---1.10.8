function F.rebuildFriends()
	if not X.frBox then return end
	F.clearBox(X.frBox)
	local n = 0
	for _, p in ipairs(F.others()) do
		if X.frCache[p.UserId] and (X.frQ == "" or F.norm(p.DisplayName):find(X.frQ, 1, true) or F.norm(p.Name):find(X.frQ, 1, true)) then
			n += 1
			local row = F.new("Frame", { Size = U2(1, 0, 0, 50), BackgroundColor3 = C.item, LayoutOrder = n, R = 12 }, X.frBox)
			local av = F.new("ImageLabel", { Size = U2o(34, 34), Position = U2o(8, 8), BackgroundColor3 = C.hover, BorderSizePixel = 0, R = 17 }, row)
			F.setAvatar(av, p.UserId)
			F.txt(row, p.DisplayName, { Size = U2(1, -230, 0, 20), Position = U2o(50, 7), TextColor3 = C.white, Font = EF.GothamBold })
			F.txt(row, "@" .. p.Name, { Size = U2(1, -230, 0, 16), Position = U2o(50, 27), TextColor3 = C.muted, Font = EF.Gotham, TextSize = 11 })
			F.smallBtn(row, "Ir", 150, 44, function() F.selectTarget(p) F.tpToTarget() end)
			F.smallBtn(row, "👁", 100, 40, function() F.selectTarget(p) F.setSpectate(true) end)
			F.smallBtn(row, "🎯", 52, 40, function() F.selectTarget(p) F.toast("Selecionado: " .. p.DisplayName) end)
		end
	end
	if n == 0 then F.note(X.frBox, "Nenhum amigo encontrado neste servidor.", 20) end
	if V.I.fr_n then V.I.fr_n(tostring(n)) end
end
function F.scanFriends()
	task.spawn(function()
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= player and X.frCache[p.UserId] == nil then
				local ok, r = pcall(player.IsFriendsWith, player, p.UserId)
				X.frCache[p.UserId] = ok and r or false
			end
		end
		F.rebuildFriends()
	end)
end
F.track(Players.PlayerAdded:Connect(function() task.defer(F.scanFriends) end))
F.track(Players.PlayerRemoving:Connect(function() task.defer(F.rebuildFriends) end))

