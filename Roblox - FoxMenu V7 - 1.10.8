-- ===== diagnóstico =====
function F.diagnostics()
	local checks = {
		{ "loadstring", loadstring ~= nil }, { "game:HttpGet", pcall(function() return game.HttpGet end) },
		{ "writefile/readfile", writefile ~= nil and readfile ~= nil }, { "gethui", gethui ~= nil },
		{ "setfpscap", (setfpscap or set_fps_cap) ~= nil }, { "mouse1click / VIM", mouse1click ~= nil or pcall(game.GetService, game, "VirtualInputManager") },
		{ "setclipboard", (setclipboard or toclipboard) ~= nil }, { "Personagem", F.root() ~= nil }, { "Humanoid", aliveHum() ~= nil },
		{ "Câmera", workspace.CurrentCamera ~= nil },
	}
	local fail = 0
	for _, c in ipairs(checks) do
		if not c[2] then fail += 1 end
		F.log((c[2] and "✔ " or "✘ ") .. c[1])
	end
	F.toast(fail == 0 and "Diagnóstico: tudo OK" or ("Diagnóstico: " .. fail .. " falha(s) — veja o registro em Utilidades"))
end

