function E.fillDetailsHeader()
	local d, it = E.ui.det, E.dsel
	if not it then return end
	d.name.Text = it.name or "Carregando..."
	d.creator.Text = it.creator and ("por @" .. it.creator) or "por ..."
	d.meta.Text = E.fmtPrice(it.price) .. "  ·  ID " .. string.format("%.0f", it.id) .. "  ·  " .. (it.kind == "pack" and "📦 Pacote de animações" or "💃 Emote")
end
---------------------------------------------------------------- IDs de cada animação (painel de detalhes)
E.CP_ORDER = { { "idle", "Parado", "🧍" }, { "walk", "Andar", "🚶" }, { "run", "Correr", "🏃" }, { "jump", "Pular", "🦘" },
	{ "fall", "Cair", "🍂" }, { "climb", "Escalar", "🧗" }, { "swim", "Nadar", "🏊" }, { "swimidle", "Boiar", "🛟" } }
E.SLOT_IC = { mood = "🙂" }
for _, r in ipairs(E.CP_ORDER) do E.SLOT_IC[r[1]] = r[3] end
function E.fillRows(it, det, tok)
	local d = E.ui.det
	for _, c in ipairs(d.rows:GetChildren()) do
		if c:IsA("GuiObject") then c:Destroy() end
	end
	local isPack = it.kind == "pack"
	local items = isPack and det.bundled or { { id = it.id, name = "Emote" } }
	local order, infos = 0, {}
	if isPack then
		order = order + 1
		local hb = F.new("Frame", { Size = U2(1, 0, 0, 32), BackgroundTransparency = 1, LayoutOrder = order }, d.rows)
		E.btn(hb, "🛠  Criar meu pack a partir deste pacote", U2(1, 0, 1, 0), nil, function() E.cpFromPack(it, det) end)
	end
	for _, b in ipairs(items) do
		order = order + 1
		local slot = isPack and E.slotOf(b.name) or nil
		local usable = slot ~= nil and slot ~= "mood"
		local row = F.new("Frame", { Size = U2(1, 0, 0, 34), BackgroundColor3 = C.item, LayoutOrder = order, BorderSizePixel = 0, R = 9 }, d.rows)
		local lbl = F.txt(row, "", { Size = U2(1, -204, 1, 0), Position = U2o(10, 0), TextSize = 12 })
		local slotName = isPack and (slot and E.SLOT_PT[slot] or "Outro") or "Emote"
		local inf = { b = b }
		function inf.upd()
			local l = E.anim[b.id]
			local num = l and E.idNum(l[1])
			local idt = num or (E.rq.fail[b.id] and "indisponível") or "carregando..."
			lbl.Text = (isPack and ((E.SLOT_IC[slot or ""] or "❔") .. " ") or "💃 ") .. slotName .. "  ·  " .. idt
				.. ((isPack and not usable) and "  (não aplicável)" or "")
			lbl.TextColor3 = num and C.text or C.muted
		end
		inf.upd()
		-- resolve o ID real da animação (o do catálogo costuma ser só um contêiner) e devolve o número
		local function animId(hi)
			local list = E.resolve(b.id, hi)
			inf.upd()
			local num = E.idNum(list[1])
			if not (num and E.anim[b.id]) then
				F.toast("Não consegui resolver o ID real desta animação (animação privada?)", "err")
			end
			return num
		end
		E.btn(row, "📋 ID anim.", U2o(70, 24), U2(1, -194, 0, 5), function()
			task.spawn(function()
				local num = animId(true)
				if num then F.copyText(num, "ID da animação (" .. slotName .. ")") end
			end)
		end)
		E.btn(row, "📋 Catálogo", U2o(70, 24), U2(1, -120, 0, 5), function()
			F.copyText(string.format("%.0f", b.id), "ID do catálogo (" .. slotName .. ")")
		end)
		if isPack and usable then
			E.btn(row, "＋ Pack", U2o(44, 24), U2(1, -46, 0, 5), function()
				task.spawn(function()
					local num = animId(true)
					if num then E.cpSetSlot(slot, num) end
				end)
			end)
		end
		inf.want = (not isPack) or usable
		infos[#infos + 1] = inf
	end
	-- descobre os IDs reais em segundo plano (um por vez, cancela se o painel fechar)
	task.spawn(function()
		for _, inf in ipairs(infos) do
			if E.dtok ~= tok then return end
			if inf.want and not E.anim[inf.b.id] then
				E.resolve(inf.b.id, not isPack, function() return E.dtok == tok end)
			end
			if E.dtok ~= tok then return end
			inf.upd()
		end
	end)
end

---------------------------------------------------------------- MEU PACK (criar um pack do zero, com IDs à sua escolha)
function E.cpCur()
	local n = #D.cp.list
	if n == 0 then return nil end
	D.cp.sel = math.clamp(D.cp.sel, 1, n)
	return D.cp.list[D.cp.sel]
end
function E.cpNew(name, slots, silent)
	if #D.cp.list >= 30 then F.toast("Limite de 30 packs", "err") return nil end
	local cp = { n = name or ("Meu pack " .. (#D.cp.list + 1)), s = slots or {} }
	D.cp.list[#D.cp.list + 1] = cp
	D.cp.sel = #D.cp.list
	F.save()
	if not silent then F.toast("Pack criado: " .. cp.n, "on") end
	E.refreshStates()
	return cp
end
function E.cpStep(d)
	local n = #D.cp.list
	if n < 2 then return end
	D.cp.sel = (D.cp.sel - 1 + d) % n + 1
	F.save()
	F.snd("tab", 1.2)
	E.refreshCP()
end
function E.cpSetSlot(slot, num)
	local cp = E.cpCur() or E.cpNew(nil, nil, true)
	if not cp then return end
	cp.s[slot] = tostring(num)
	if cp.m then cp.m[slot] = nil end
	F.save()
	E.refreshStates()
	F.toast((E.SLOT_PT[slot] or slot) .. " → " .. cp.n .. "  ·  ID " .. tostring(num), "on")
end
function E.cpCommit(slot, text)
	local cp = E.cpCur()
	if not cp then return end
	local num = tostring(text or ""):match("%d+")
	if num and #num < 5 then
		F.toast("Esse ID parece curto demais", "err")
		num = nil
	end
	cp.s[slot] = num
	if cp.m then cp.m[slot] = nil end
	F.save()
	E.refreshCP()
end
function E.cpFromPack(it, det)
	local bySlot = {}
	for _, b in ipairs(det.bundled) do
		local sl = E.slotOf(b.name)
		if sl and sl ~= "mood" and not bySlot[sl] then bySlot[sl] = b.id end
	end
	if not next(bySlot) then return F.toast("Este pacote não tem animações aplicáveis", "err") end
	local cp = E.cpNew(((it.name or "Pacote") .. " (cópia)"):sub(1, 30), nil, true)
	if not cp then return end
	E.setView("pack")
	F.toast("Copiando as animações para o seu pack...", "ok")
	task.spawn(function()
		local n = 0
		for _, r in ipairs(E.CP_ORDER) do
			local aid = bySlot[r[1]]
			if aid then
				local num = E.idNum(E.resolve(aid, true)[1])
				if num then cp.s[r[1]] = num n = n + 1 E.refreshCP() end
			end
		end
		F.save()
		F.toast(("Pack criado com %d animações: edite os IDs como quiser"):format(n), "on")
	end)
end
function E.cpExport()
	local cp = E.cpCur()
	if not cp then return end
	local parts = {}
	for _, r in ipairs(E.CP_ORDER) do
		if cp.s[r[1]] then parts[#parts + 1] = r[1] .. "=" .. cp.s[r[1]] end
	end
	if #parts == 0 then return F.toast("O pack está vazio", "err") end
	F.copyText("FoxPack|" .. cp.n:gsub("[|;=]", "") .. "|" .. table.concat(parts, ";"), "Pack")
end
function E.cpImport(text)
	text = tostring(text or "")
	local body = text:match("FoxPack|(.*)")
	local name, rest = "Pack importado", text
	if body then
		local n2, r2 = body:match("^(.-)|(.*)$")
		if n2 then name, rest = (n2 ~= "" and n2 or name), r2 end
	end
	local valid, slots, n = {}, {}, 0
	for _, r in ipairs(E.CP_ORDER) do valid[r[1]] = true end
	for k, v in rest:gmatch("(%a+)%s*=%s*(%d+)") do
		if valid[k] and #v >= 5 then slots[k] = v n = n + 1 end
	end
	if n == 0 then return F.toast("Nada para importar: use o texto copiado em “Copiar pack”", "err") end
	if E.cpNew(name:sub(1, 30), slots, true) then F.toast(("Pack importado: %s (%d animações)"):format(name, n), "on") end
end
-- confirmação em dois toques (3 s)
function E.confirm2(btn, key, text, cb)
	if E[key] then
		E[key] = false
		btn.Text = text
		return cb()
	end
	E[key] = true
	btn.Text = "Confirmar?"
	task.delay(3, function()
		if E[key] then
			E[key] = false
			if btn.Parent then btn.Text = text end
		end
	end)
end
function E.equipCustom(cp)
	E.pvStop()
	E.stopEmote()
	local hum = aliveHum()
	if not hum then return F.toast("Sem personagem vivo", "err") end
	if hum.RigType ~= Enum.HumanoidRigType.R15 then return F.toast("Packs só funcionam em personagens R15", "err") end
	local an = hum.Parent:FindFirstChild("Animate")
	if not (an and an:IsA("LocalScript")) then return F.toast("Este jogo não usa o script Animate padrão: não dá para trocar as animações", "err") end
	local jobs, res = {}, {}
	for _, r in ipairs(E.CP_ORDER) do
		local m = cp.m and cp.m[r[1]] -- pack copiado de um jogador: já traz os IDs reais de animação (não precisa baixar nada)
		if type(m) == "table" and #m > 0 then
			res[r[1]] = m
		else
			local v = cp.s[r[1]]
			if v then jobs[#jobs + 1] = { r[1], tonumber(v) } end
		end
	end
	if #jobs == 0 and next(res) == nil then return F.toast("Preencha pelo menos uma animação no pack", "err") end
	local pending = #jobs
	for _, j in ipairs(jobs) do
		task.spawn(function()
			res[j[1]] = E.resolve(j[2], true)
			pending = pending - 1
		end)
	end
	local t0 = os.clock()
	while pending > 0 and os.clock() - t0 < 25 and not V.closing do task.wait(0.1) end
	if aliveHum() ~= hum then return F.toast("O personagem mudou durante a aplicação", "err") end
	local applied = 0
	E.reanimate(an, hum, function()
		E.restoreOrig()
		E.captureOrig(an)
		for slot, ids in pairs(res) do
			if #ids > 0 and E.setFolder(an, slot, ids) then applied = applied + 1 end
		end
	end)
	if applied == 0 then return F.toast("Nenhuma animação do pack pôde ser aplicada", "err") end
	E.eq = { id = "cp", n = cp.n, cpRef = cp }
	E.applied = res
	F.toast(("Pack equipado: %s (%d animações)"):format(cp.n, applied), "on")
end
function E.cpEquip()
	local cp = E.cpCur()
	if not cp then return end
	if E.busy then return F.toast("Aguarde: ainda aplicando outro pacote", "err") end
	E.busy, E.busyId = true, nil
	E.refreshStates()
	F.toast("Aplicando: " .. cp.n .. "...", "ok")
	task.spawn(function()
		local ok, err = pcall(E.equipCustom, cp)
		E.busy, E.busyId = false, nil
		if not ok then F.toast("Falha ao equipar: " .. E.clean(err), "err") end
		E.refreshStates()
	end)
end
---------------------------------------------------------------- copiar animações de outro jogador (aba Jogadores)
-- Lê o script "Animate" do personagem do jogador e monta um pack: s = 1º ID de cada slot (aparece em "Meu pack"),
-- m = lista completa de IDs de cada slot (ex.: as duas variações de "Parado"), usada ao equipar.
function E.plRead(p)
	local ch = p and p.Character
	if not ch then return nil, "Esse jogador não tem personagem agora" end
	local hum = ch:FindFirstChildOfClass("Humanoid")
	if hum and hum.RigType ~= Enum.HumanoidRigType.R15 then return nil, "O jogador usa R6: só dá para copiar animações de R15" end
	local an = ch:FindFirstChild("Animate")
	if not an then return nil, "Não encontrei as animações desse jogador (o jogo não usa o Animate padrão)" end
	local s, m, n = {}, {}, 0
	for _, r in ipairs(E.CP_ORDER) do
		local f = an:FindFirstChild(r[1])
		if f then
			local anims = {}
			for _, c in ipairs(f:GetChildren()) do
				if c:IsA("Animation") and E.idNum(c.AnimationId) then anims[#anims + 1] = c end
			end
			table.sort(anims, function(a, b) return a.Name < b.Name end)
			if #anims > 0 then
				local list = {}
				for i, a in ipairs(anims) do list[i] = "rbxassetid://" .. E.idNum(a.AnimationId) end
				s[r[1]], m[r[1]] = E.idNum(anims[1].AnimationId), list
				n = n + 1
			end
		end
	end
	if n == 0 then return nil, "Esse jogador não tem animações para copiar" end
	return s, m, n
end
function E.plCopy(mode)
	local p = V.target
	if not p then return F.toast("Selecione um jogador primeiro", "err") end
	local s, m, n = E.plRead(p)
	if not s then return F.toast(m, "err") end
	local name = ("Pack de " .. (p.DisplayName or p.Name)):sub(1, 30)
	if mode == "save" then
		local cp = E.cpNew(name, s, true)
		if not cp then return end
		cp.m = m
		F.save()
		E.refreshCP()
		return F.toast(("Salvo em Meu pack: %s (%d animações)"):format(name, n), "on")
	end
	if E.busy then return F.toast("Aguarde: ainda aplicando outro pacote", "err") end
	E.busy, E.busyId = true, nil
	E.refreshStates()
	F.toast("Copiando animações de " .. (p.DisplayName or p.Name) .. "...", "ok")
	task.spawn(function()
		local ok, err = pcall(E.equipCustom, { n = name, s = s, m = m })
		E.busy, E.busyId = false, nil
		if not ok then F.toast("Falha ao equipar: " .. E.clean(err), "err") end
		E.refreshStates()
	end)
end
---------------------------------------------------------------- ANIMAÇÕES: velocidade · emote do jogador · sincronizar · registro · playlist
-- (1) velocidade de todas as suas animações (emote, pack, andar...). O Animate muda a velocidade das faixas sozinho (andar/correr),
-- então guardamos o valor "base" de cada faixa e multiplicamos por cima; se o Animate mudar, o novo base é aprendido.
E.spd = { pct = 100, base = setmetatable({}, { __mode = "k" }), last = setmetatable({}, { __mode = "k" }), c = nil }
E.mimOwn = setmetatable({}, { __mode = "k" }) -- faixas criadas por "Sincronizar com o jogador" (a velocidade delas é a do jogador)
function E.spdStep()
	local hum = aliveHum()
	local an = hum and hum:FindFirstChildOfClass("Animator")
	if not an then return end
	local m = E.spd.pct / 100
	for _, t in ipairs(an:GetPlayingAnimationTracks()) do
		if not X.fbOwn[t] and not E.mimOwn[t] then
			local cur, last = t.Speed, E.spd.last[t]
			if last == nil or math.abs(cur - last) > 1e-4 then E.spd.base[t] = cur end
			local want = (E.spd.base[t] or cur) * m
			if math.abs(cur - want) > 1e-4 then t:AdjustSpeed(want) end
			E.spd.last[t] = want
		end
	end
end
function E.spdSet(pct)
	E.spd.pct = pct
	if pct == 100 then
		if E.spd.c then E.spd.c:Disconnect() E.spd.c = nil end
		local hum = aliveHum()
		local an = hum and hum:FindFirstChildOfClass("Animator")
		if an then
			for _, t in ipairs(an:GetPlayingAnimationTracks()) do
				local b = E.spd.base[t]
				if b and E.spd.last[t] and not E.mimOwn[t] then pcall(function() t:AdjustSpeed(b) end) end
			end
		end
		E.spd.base, E.spd.last = setmetatable({}, { __mode = "k" }), setmetatable({}, { __mode = "k" })
	elseif not E.spd.c then
		E.spd.c = RS.Heartbeat:Connect(function() pcall(E.spdStep) end)
	end
end

-- animações em execução de um jogador (sem as de andar/correr/parado, a menos que all = true)
E.locoC = setmetatable({}, { __mode = "k" })
function E.locoSet(an2)
	local c = E.locoC[an2]
	if not c or os.clock() - c.t > 6 then
		c = { t = os.clock(), set = E.idSet(an2) }
		E.locoC[an2] = c
	end
	return c.set
end
function E.plTracks(p, all)
	local ch = p and p.Character
	local hum = ch and ch:FindFirstChildOfClass("Humanoid")
	local an = hum and hum:FindFirstChildOfClass("Animator")
	if not an then return nil end
	local an2 = ch:FindFirstChild("Animate")
	local loco = (an2 and not all) and E.locoSet(an2) or nil
	local mine = p == player
	local out = {}
	for _, t in ipairs(an:GetPlayingAnimationTracks()) do
		local a = t.Animation
		local num = a and E.idNum(a.AnimationId)
		if num and t.WeightCurrent > 0.05 and not (mine and (E.mimOwn[t] or X.fbOwn[t])) and not (loco and loco[num]) then
			out[#out + 1] = { t = t, id = num }
		end
	end
	return out
end

-- (2) emote que o jogador selecionado está tocando agora
function E.plNow(mode)
	local p = V.target
	local list = p and E.plTracks(p, false)
	if not list or #list == 0 then return F.toast("Esse jogador não está tocando nenhum emote agora", "err") end
	table.sort(list, function(a, b)
		if a.t.Priority.Value ~= b.t.Priority.Value then return a.t.Priority.Value > b.t.Priority.Value end
		return a.t.WeightCurrent > b.t.WeightCurrent
	end)
	local e = list[1]
	local num = tonumber(e.id)
	if mode == "id" then return F.copyText(e.id, "ID do emote") end
	E.anim[num] = { "rbxassetid://" .. e.id } -- é o ID real da animação: não precisa baixar nada
	local nm = ("Emote de %s #%s"):format(p.DisplayName or p.Name, e.id:sub(-4))
	if mode == "save" then
		return E.libAdd(E.mk("emote", num, nm, p.Name))
	end
	E.playEmote({ id = num, loop = true, name = nm })
end

-- (3) sincronizar: repete as animações do jogador selecionado, no mesmo ponto da animação
E.sy = { c = nil, tr = {}, fail = {}, acc = 0, an = nil }
function E.syStop()
	if E.sy.c then E.sy.c:Disconnect() E.sy.c = nil end
	for _, t in pairs(E.sy.tr) do pcall(function() t:Stop(0.2) end) end
	E.sy.tr, E.sy.fail, E.sy.an = {}, {}, nil
end
function E.syStep(dt)
	if V.closing then return E.syStop() end
	E.sy.acc += dt
	if E.sy.acc < 0.05 then return end
	E.sy.acc = 0
	local hum = aliveHum()
	local an = hum and hum:FindFirstChildOfClass("Animator")
	if not an then return end
	if E.sy.an ~= an then -- personagem novo: descarta as faixas do antigo
		E.sy.tr, E.sy.fail, E.sy.an = {}, {}, an
	end
	local p = V.target
	local list = (p and p ~= player and p.Parent == Players and E.plTracks(p, false)) or {}
	local used = {}
	for _, e in ipairs(list) do
		local id, src = e.id, e.t
		local mt = E.sy.tr[id]
		if not mt and not E.sy.fail[id] then
			local anim = Instance.new("Animation")
			anim.AnimationId = "rbxassetid://" .. id
			local ok, t = pcall(function() return an:LoadAnimation(anim) end)
			if ok and t then
				t.Priority = Enum.AnimationPriority.Action4
				E.mimOwn[t] = true
				E.sy.tr[id], mt = t, t
			else
				E.sy.fail[id] = true
			end
		end
		if mt then
			used[id] = true
			mt.Looped = src.Looped
			if not mt.IsPlaying then mt:Play(0.1, math.max(src.WeightCurrent, 0.05), src.Speed) end
			if math.abs(mt.Speed - src.Speed) > 0.01 then mt:AdjustSpeed(src.Speed) end
			local len = mt.Length
			if len > 0 then
				local d = src.TimePosition - mt.TimePosition
				if mt.Looped then d = ((d + len / 2) % len) - len / 2 end
				if math.abs(d) > 0.15 then mt.TimePosition = math.clamp(src.TimePosition, 0, len) end
			end
		end
	end
	for id, mt in pairs(E.sy.tr) do
		if not used[id] and mt.IsPlaying then mt:Stop(0.15) end
	end
end
function E.sySet(on)
	if not on then return E.syStop() end
	if not V.target or V.target.Parent ~= Players then
		F.toast("Selecione um jogador primeiro", "err")
		if Reg.syncanim then Reg.syncanim.set(false, true) end
		return
	end
	if E.sy.c then return end
	E.sy.c = RS.Heartbeat:Connect(function(dt) pcall(E.syStep, dt) end)
end

-- (4) registro de animações: anota toda animação nova que começa em qualquer jogador
E.lg = { on = false, c = nil, list = {}, seen = {}, acc = 0, hideLoco = true, draw = false }
function E.lgDraw()
	local box = F.alBox
	if not (box and box.Parent) then return end
	F.clearBox(box)
	if #E.lg.list == 0 then
		return F.note(box, "Ligue o registro: as animações novas aparecem aqui com ▶ tocar · 💾 salvar · 📋 copiar ID.", 34)
	end
	for i, e in ipairs(E.lg.list) do
		local row = F.new("Frame", { Size = U2(1, 0, 0, 36), BackgroundColor3 = C.item, LayoutOrder = i, R = 10 }, box)
		F.txt(row, ("%s  ·  %s  ·  %s"):format(e.who, e.id, e.time), { Size = U2(1, -128, 1, 0), Position = U2(0, 12, 0, 0), TextSize = 11, TextColor3 = C.text })
		local num = tonumber(e.id)
		F.smallBtn(row, "📋", 38, 30, function() F.copyText(e.id, "ID") end)
		F.smallBtn(row, "💾", 74, 30, function()
			E.anim[num] = { "rbxassetid://" .. e.id }
			E.libAdd(E.mk("emote", num, ("Emote de %s #%s"):format(e.who, e.id:sub(-4)), e.who))
		end)
		F.smallBtn(row, "▶", 110, 30, function()
			E.anim[num] = { "rbxassetid://" .. e.id }
			E.playEmote({ id = num, loop = true, name = e.id })
		end)
	end
end
function E.lgDrawSoon()
	if E.lg.draw then return end
	E.lg.draw = true
	task.delay(0.3, function()
		E.lg.draw = false
		pcall(E.lgDraw)
	end)
end
function E.lgStep(dt)
	if V.closing then return E.lgSet(false) end
	E.lg.acc += dt
	if E.lg.acc < 0.2 then return end
	E.lg.acc = 0
	for _, p in ipairs(Players:GetPlayers()) do
		local tr = E.plTracks(p, not E.lg.hideLoco)
		if tr then
			local seen = E.lg.seen[p]
			if not seen then seen = {} E.lg.seen[p] = seen end
			local now = {}
			for _, e in ipairs(tr) do
				now[e.id] = true
				if not seen[e.id] then
					seen[e.id] = true
					table.insert(E.lg.list, 1, { who = (p == player) and "Você" or (p.DisplayName or p.Name), id = e.id, time = os.date("%H:%M:%S") })
					if #E.lg.list > 14 then table.remove(E.lg.list) end
					E.lgDrawSoon()
				end
			end
			for id in pairs(seen) do
				if not now[id] then seen[id] = nil end -- quando recomeçar, registra de novo
			end
		end
	end
end
function E.lgSet(on)
	if on then
		if E.lg.c then return end
		E.lg.seen = {}
		E.lg.c = RS.Heartbeat:Connect(function(dt) pcall(E.lgStep, dt) end)
	else
		if E.lg.c then E.lg.c:Disconnect() E.lg.c = nil end
		if Reg.animlog and Reg.animlog.get() then Reg.animlog.set(false, true) end
	end
end
function E.lgClear()
	E.lg.list, E.lg.seen = {}, {}
	E.lgDrawSoon()
end

-- (5) playlist: toca os emotes do seu "Meu menu" em sequência (ou aleatório), trocando a cada X segundos
E.lst = { run = false, tok = 0, random = false, secs = 8, skip = false }
function E.lstStop()
	E.lst.tok += 1
	if E.lst.run then
		E.lst.run = false
		E.stopEmote()
	end
end
function E.lstStart()
	if E.lst.run then return end
	if #D.lib == 0 then
		F.toast("Seu menu de emotes está vazio: adicione emotes na aba Free Emotes", "err")
		if Reg.emoplay then Reg.emoplay.set(false, true) end
		return
	end
	E.lst.run = true
	E.lst.tok += 1
	local tok = E.lst.tok
	task.spawn(function()
		local function alive() return E.lst.run and E.lst.tok == tok and not V.closing end
		local last, fails = 0, 0
		while alive() do
			local n = #D.lib
			if n == 0 then break end
			local idx
			if E.lst.random and n > 1 then
				repeat idx = math.random(n) until idx ~= last
			else
				idx = last % n + 1
			end
			last = idx
			local e = D.lib[idx]
			local id = e.id
			if E.playingId == id then E.stopEmote() end -- senão o "tocar" desligaria o emote
			E.playEmote({ id = id, loop = true, name = e.n })
			local t0 = os.clock()
			while alive() and E.playingId ~= id and E.loadingId == id and os.clock() - t0 < 12 do task.wait(0.1) end
			if not alive() then return end
			if E.playingId == id then
				fails = 0
				E.lst.skip = false
				local t1 = os.clock()
				while alive() and E.playingId == id and os.clock() - t1 < E.lst.secs and not E.lst.skip do task.wait(0.1) end
				if not alive() then return end
				if E.playingId ~= id then
					F.toast("Playlist parada (o emote foi cancelado)", "off")
					break
				end
			else
				fails = fails + 1
				if fails >= n then
					F.toast("Nenhum emote da playlist carregou", "err")
					break
				end
				task.wait(0.2)
			end
		end
		if E.lst.tok == tok then
			E.lst.run = false
			if Reg.emoplay then Reg.emoplay.set(false, true) end
		end
	end)
end

function E.refreshCP()
	local ui = E.ui
	if not (ui and ui.cp and ui.cpCells) then return end
	ui.vb.pack.Text = "🛠  Meu pack (" .. #D.cp.list .. ")"
	if not ui.cp.Visible then return end
	if #D.cp.list == 0 then
		E.cpNew("Meu pack 1", nil, true)
		return
	end
	local cp = E.cpCur()
	if not ui.cpName:IsFocused() then ui.cpName.Text = cp.n end
	local n = 0
	for _, r in ipairs(E.CP_ORDER) do
		local c = ui.cpCells[r[1]]
		local v = cp.s[r[1]]
		if v then n = n + 1 end
		if not c.box:IsFocused() then c.box.Text = v or "" end
		c.dot.Text = v and "✓" or ""
	end
	local eq = E.eq ~= nil and E.eq.cpRef == cp
	ui.cpInfo.Text = ("Pack %d de %d  ·  %d/8 animações  ·  %s"):format(D.cp.sel, #D.cp.list, n, eq and "equipado" or "não equipado")
	if E.busy and not E.busyId then E.setOn(ui.cpEq, false, "Aplicando...")
