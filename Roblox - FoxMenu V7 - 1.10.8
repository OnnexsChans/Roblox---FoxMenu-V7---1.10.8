function E.openDetails(it)
	local d = E.ui.det
	E.dsel = it
	E.fillDetailsHeader()
	d.desc.Text, d.cont.Text = "Carregando informações...", "Carregando conteúdo..."
	for _, c in ipairs(d.rows:GetChildren()) do
		if c:IsA("GuiObject") then c:Destroy() end
	end
	E.loadImg(d.img, E.thumb(it.kind, it.id, 420), d.ph)
	d.f.Visible, d.f.GroupTransparency = true, 1
	d.f.Position = U2o(0, 14)
	F.tw(d.f, { GroupTransparency = 0, Position = U2() }, 0.28, QUINT)
	E.refreshStates()
	E.dtok = (E.dtok or 0) + 1
	local tok = E.dtok
	task.spawn(function()
		local det = E.fetchDetails(it)
		if E.dtok ~= tok or E.dsel ~= it then return end
		if not det then
			d.desc.Text, d.cont.Text = "Não foi possível carregar os detalhes agora. Feche e abra de novo para tentar outra vez.", "—"
			return
		end
		E.fillDetailsHeader()
		d.desc.Text = (det.desc and det.desc ~= "") and det.desc or "Sem descrição."
		if it.kind == "pack" then
			if #det.bundled == 0 then
				d.cont.Text = "O Roblox não informou os itens deste pacote."
			else
				local ok = 0
				for _, b in ipairs(det.bundled) do
					local sl = E.slotOf(b.name)
					if sl and sl ~= "mood" then ok = ok + 1 end
				end
				d.cont.Text = ok .. " de " .. #det.bundled .. " itens são aplicáveis ao R15. Copie os IDs ou mande para o seu pack:"
				E.fillRows(it, det, tok)
			end
		else
			d.cont.Text = "Toque em Testar para ver no seu personagem (qualquer movimento cancela) ou copie os IDs abaixo."
			E.fillRows(it, det, tok)
		end
	end)
end
function E.closeDetails()
	local d = E.ui and E.ui.det
	if not (d and d.f.Visible) then return end
	E.dsel = nil
	E.dtok = (E.dtok or 0) + 1
	F.tw(d.f, { GroupTransparency = 1, Position = U2o(0, 10) }, 0.18)
	task.delay(0.2, function() if not E.dsel then d.f.Visible = false end end)
	E.refreshStates()
end
function E.refreshDetails()
	local d, it = E.ui and E.ui.det, E.dsel
	if not (d and it and d.f.Visible) then return end
	local fav = E.isFav(it.kind, it.id)
	E.setOn(d.b3, fav, fav and "★ Favorito" or "☆ Favoritar")
	if it.kind == "pack" then
		local eq = E.eq ~= nil and E.eq.id == it.id
		if E.busy and E.busyId == it.id then E.setOn(d.b1, false, "Aplicando...")
		else E.setOn(d.b1, eq, eq and "✔ Equipado (tirar)" or "✅ Equipar") end
		local inW = E.libIdxP(it.id) ~= nil
		E.setOn(d.b2, inW, inW and "✖ Tirar da roda" or "🎡 Salvar na roda")
	else
		E.setOn(d.b1, E.playingId == it.id, E.playingId == it.id and "⏹ Parar" or "▶ Testar")
		local inLib = E.libIdx(it.id) ~= nil
		E.setOn(d.b2, inLib, inLib and "✖ Remover do menu" or "＋ Adicionar ao menu")
	end
end

---------------------------------------------------------------- navegação entre visões
function E.setView(v, noLoad)
	local ui = E.ui
	E.view = v
	for k, b in pairs(ui.vb) do
		local on = k == v
		F.tw(b, { BackgroundTransparency = on and 0 or 1, TextColor3 = on and C.black or C.muted }, 0.22, on and BACK or QUINT)
		if on and b:FindFirstChildOfClass("UIScale") then F.tw(b:FindFirstChildOfClass("UIScale"), { Scale = 1.04 }, 0.12) task.delay(0.12, function() if b.Parent then F.tw(b:FindFirstChildOfClass("UIScale"), { Scale = 1 }, 0.18, BACK) end end) end
	end
	local isMenu = v == "menu"
	local alt = isMenu or v == "pack"
	ui.row2.Visible = v ~= "pack"
	ui.status.Visible, ui.res.Visible = not alt, not alt
	if isMenu then ui.sb.Text = "" E.libQ, E.libMatches, E.libMI = "", {}, 0 end
	ui.sortB.Visible = v == "search"
	ui.menu.Visible = isMenu
	ui.cp.Visible = v == "pack"
	ui.sb.PlaceholderText = v == "favs" and "🔍  Filtrar favoritos..." or v == "menu" and "🔍  Filtrar seu menu de emotes..." or "🔍  Buscar por pacote, emote ou criador..."
	E.closeDetails()
	if v == "search" then
		if not E.searched and not noLoad then E.query() else E.renderGrid() end
	elseif v == "favs" then
		E.renderGrid()
	elseif v == "menu" then
		E.renderMenu()
	else
		E.refreshCP()
	end
end
function E.setMode(m)
	if E.mode == m then return end
	E.mode = m
	for k, b in pairs(E.ui.mb) do E.setOn(b, k == m) end
	E.selIdxSearch = nil
	if E.view == "search" then E.query() elseif E.view == "favs" then E.renderGrid() end
end
function E.onOpen()
	E.pvPrep()
	if E.opened then return end
	E.opened = true
	if E.view == "search" and not E.searched then E.query() end
end

