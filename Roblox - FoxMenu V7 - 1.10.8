F.ESP_MODES = ESP_MODES
F.X = X

-- ===== MARRETÃO (Flee the Facility): ESP, Never Fail, Auto Interact, Auto-Play, Anti-Void 2 =====
X.ftf = { pl = false, pods = false, exits = false, pc = false, best = false, nf = false, ai = false, ap = false,
	hl = {}, apBalls = {}, apTok = 0, aiTok = 0 }
X.av2 = {}

function F.ftfRS() return game:GetService("ReplicatedStorage") end
function F.ftfMap()
	local cm = F.ftfRS():FindFirstChild("CurrentMap")
	return cm and cm.Value or nil
end
-- a fera: IsBeast = true em TempPlayerStatsModule, ou o personagem tem "BeastPowers"
function F.ftfBeast()
	for _, p in ipairs(Players:GetPlayers()) do
		local ok, isB = pcall(function()
			local m = p:FindFirstChild("TempPlayerStatsModule")
			local v = m and m:FindFirstChild("IsBeast")
			return (v ~= nil and v.Value == true) or (p.Character ~= nil and p.Character:FindFirstChild("BeastPowers") ~= nil)
		end)
		if ok and isB then return p end
	end
end
-- PCs ainda não concluídos (tela não "Dark green"), do MAIS LONGE da fera para o mais perto; [1] = "Best PC"
function F.ftfPCs()
	local l, map, beast = {}, F.ftfMap(), F.ftfBeast()
	if not map then return l end
	local br = beast and beast.Character and beast.Character:FindFirstChild("HumanoidRootPart")
	for _, v in ipairs(map:GetChildren()) do
		local scr = v.Name == "ComputerTable" and v:FindFirstChild("Screen")
		if scr and scr.BrickColor ~= BrickColor.new("Dark green") then
			l[#l + 1] = { magnitude = br and (scr.Position - br.Position).Magnitude or 0, pc = v }
		end
	end
	table.sort(l, function(a, b) return a.magnitude > b.magnitude end)
	return l
end
function F.ftfTyping()
	local h = F.hum()
	if not h then return false end
	local ok, tracks = pcall(function() return (h:FindFirstChildOfClass("Animator") or h):GetPlayingAnimationTracks() end)
	if ok and tracks then
		for _, t in ipairs(tracks) do if t.Name == "AnimTyping" then return true end end
	end
	return false
end

-- ---------- ESP (Player · Pods · Exits · PC · Best PC) ----------
function F.ftfClear()
	for k, e in pairs(X.ftf.hl) do e.hl:Destroy() X.ftf.hl[k] = nil end
end
function F.ftfWant(inst, want, fill, outline)
	local f = X.ftf
	local e = f.hl[inst]
	if not want or not inst.Parent then
		if e then e.hl:Destroy() f.hl[inst] = nil end
		return
	end
	if not e then
		e = { hl = mkHL(inst, fill, outline, 0.5) }
		f.hl[inst] = e
	end
	e.hl.FillColor, e.hl.OutlineColor = fill, outline
end
function F.ftfUpdate()
	local f = X.ftf
	for k, e in pairs(f.hl) do if not k.Parent then e.hl:Destroy() f.hl[k] = nil end end
	local map = F.ftfMap()
	if map then
		local bestPC
		if f.pc and f.best then
			local l = F.ftfPCs()
			bestPC = l[1] and l[1].pc
		end
		for _, o in ipairs(map:GetChildren()) do
			local n = o.Name
			if n == "ComputerTable" then
				local scr = o:FindFirstChild("Screen")
				local fill = scr and scr.Color or C3(13, 105, 172)
				local out = scr and C3(math.clamp(fill.R * 400, 0, 255), math.clamp(fill.G * 400, 0, 255), math.clamp(fill.B * 400, 0, 255)) or C3(20, 165, 255)
				if f.best and scr and o == bestPC then out = C3(200, 0, 255) end -- o melhor PC ganha contorno roxo
				F.ftfWant(o, f.pc, fill, out)
			elseif n == "FreezePod" then
				F.ftfWant(o, f.pods, C3(120, 200, 255), C3(160, 255, 255))
			elseif n == "ExitDoor" then
				F.ftfWant(o, f.exits, C3(252, 255, 100), C3(255, 255, 160))
			end
		end
	end
	local beast = F.ftfBeast()
	for _, p in ipairs(Players:GetPlayers()) do
		local c = p ~= player and p.Character
		if c then
			if p == beast then F.ftfWant(c, f.pl, C3(255, 0, 0), C3(255, 127, 127))
			else F.ftfWant(c, f.pl, C3(0, 255, 0), C3(127, 255, 127)) end
		end
	end
end
function F.ftfEsp()
	local f = X.ftf
	if f.espC then f.espC:Disconnect() f.espC = nil end
	if not (f.pl or f.pods or f.exits or f.pc) then return F.ftfClear() end
	local acc = 1
	f.espC = RS.Heartbeat:Connect(function(dt)
		acc += dt
		if acc < 0.5 then return end
		acc = 0
		pcall(F.ftfUpdate)
	end)
	pcall(F.ftfUpdate)
end
function F.ftfFlag(k) return function(on) X.ftf[k] = on F.ftfEsp() end end
function F.ftfRestart()
	F.ftfClear()
	F.ftfEsp()
	F.toast("ESP reiniciado")
end

-- ---------- Never Fail (minigame dos PCs sempre com sucesso) ----------
function F.setNeverFail(on)
	local f = X.ftf
	f.nf = on
	if not on then return end
	if not f.hooked then -- hook no FireServer: força o resultado do minigame = true (só age enquanto estiver ligado)
		f.hooked = true
		local ok = pcall(function()
			local mt = getrawmetatable(game)
			local old = mt.__namecall
			setreadonly(mt, false)
			mt.__namecall = newcclosure(function(self, ...)
				if f.nf and getnamecallmethod() == "FireServer" then
					local args = { ... }
					if args[1] == "SetPlayerMinigameResult" then
						args[2] = true
						return old(self, table.unpack(args, 1, select("#", ...)))
					end
				end
				return old(self, ...)
			end)
			setreadonly(mt, true)
		end)
		if not ok then
			f.hooked = false
			F.toast("Hook indisponível neste executor (só o envio direto funciona)", "err")
		end
	end
	if not f.nfRun then
		f.nfRun = true
		task.spawn(function()
			while f.nf and not V.closing do
				local re = F.ftfRS():FindFirstChild("RemoteEvent")
				if re then pcall(function() re:FireServer("SetPlayerMinigameResult", true) end) end
				task.wait()
			end
			f.nfRun = false
		end)
	end
end

-- ---------- Auto Interact (aperta "Ação" sempre que a caixa de ação aparece) ----------
function F.setAutoInteract(on)
	local f = X.ftf
	f.ai = on
	f.aiTok += 1
	if f.aiC then f.aiC:Disconnect() f.aiC = nil end
	if not on then return end
	local tok = f.aiTok
	task.spawn(function()
		local sg = playerGui:WaitForChild("ScreenGui", 10)
		local box = sg and sg:WaitForChild("ActionBox", 10)
		if f.aiTok ~= tok or not f.ai then return end
		if not box then return F.toast("ActionBox não encontrada (você está no Flee the Facility?)", "err") end
		f.aiC = box:GetPropertyChangedSignal("Visible"):Connect(function()
			if not f.ai then return end
			local re = F.ftfRS():FindFirstChild("RemoteEvent")
			if re then pcall(function() re:FireServer("Input", "Action", true) end) end
		end)
	end)
end

-- ---------- Auto-Play (anda sozinho até os PCs usando pathfinding) ----------
function F.ftfPlayStep(tok)
	local f = X.ftf
	local function alive() return f.ap and f.apTok == tok and not V.closing end
	local map, beast = F.ftfMap(), F.ftfBeast()
	local h, root = aliveHum(), F.root()
	if not (map and h and root) then return end
	-- portas: passáveis para o pathfinding; a "Frame" da porta é evitada (custo alto)
	for _, o in ipairs(map:GetChildren()) do
		if o.Name == "SingleDoor" or o.Name == "DoubleDoor" then
			for _, dp in ipairs(o:GetDescendants()) do
				if dp.ClassName == "Part" and dp.Name ~= "Frame" and not dp:FindFirstChild("PathfindingModifier") then
					local a = Instance.new("PathfindingModifier")
					a.PassThrough = true
					a.Parent = dp
				elseif dp.Name == "Frame" and not dp:FindFirstChild("PathfindingModifier") then
					local a = Instance.new("PathfindingModifier")
					a.PassThrough, a.Label = false, "avoid"
					a.Parent = dp
				end
			end
		end
	end
	local br = beast and beast.Character and beast.Character:FindFirstChild("HumanoidRootPart")
	local near = br ~= nil and (root.Position - br.Position).Magnitude < 50
	local PFS = game:GetService("PathfindingService")
	local params = { AgentRadius = 2.4, AgentHeight = 2, AgentCanJump = true, AgentWalkableClimb = 4, WaypointSpacing = 2, Costs = { avoid = 10.0 } }
	for _, e in ipairs(F.ftfPCs()) do
		if not alive() then return end
		if F.ftfTyping() and not near then break end -- já está digitando num PC e a fera está longe: não sai de lá
		local trig = e.pc:FindFirstChild("ComputerTrigger1")
		if trig then
			local path = PFS:CreatePath(params)
			path:ComputeAsync(root.Position, trig.Position)
			if path.Status == Enum.PathStatus.Success then
				for _, wp in ipairs(path:GetWaypoints()) do
					if not alive() then return end
					h:MoveTo(wp.Position)
					if wp.Action == Enum.PathWaypointAction.Jump then h:ChangeState(Enum.HumanoidStateType.Jumping) end
					-- bolinha rosa marca o próximo ponto; some ao tocar (ou em 10 s)
					local ball = F.new("Part", { Shape = Enum.PartType.Ball, Position = wp.Position, BrickColor = BrickColor.new("Pink"),
						Material = Enum.Material.Neon, Size = Vector3.new(2, 2, 2), Anchored = true, CanCollide = false }, workspace)
					f.apBalls[ball] = true
					local touched = false
					local conn = ball.Touched:Connect(function(hit)
						if player.Character and hit:IsDescendantOf(player.Character) then touched = true end
					end)
					local t0 = os.clock()
					while not touched and os.clock() - t0 < 10 and alive() do task.wait(0.05) end
					conn:Disconnect()
					f.apBalls[ball] = nil
					ball:Destroy()
				end
				break
			end
		end
	end
end
function F.setAutoPlay(on)
	local f = X.ftf
	f.ap = on
	f.apTok += 1
	if not on then
		for b in pairs(f.apBalls) do b:Destroy() f.apBalls[b] = nil end
		local h, r = F.hum(), F.root()
		if h and r then h:MoveTo(r.Position) end
		return
	end
	local tok = f.apTok
	task.spawn(function()
		while f.ap and f.apTok == tok and not V.closing do
			task.wait(3)
			if not (f.ap and f.apTok == tok) then break end
			local ok, err = pcall(F.ftfPlayStep, tok)
			if not ok then warn("[FoxMenu] Auto-Play: " .. tostring(err)) end
		end
	end)
end

-- ---------- Anti-Void 2 (estilo Marretão: plataforma invisível sob os pés quando não há chão) ----------
function F.av2Remove()
	local a = X.av2
	if a.plat then a.plat:Destroy() end
	a.plat, a.platY = nil, nil
end
function F.setAntiVoid2(on)
	local a = X.av2
	if a.c then a.c:Disconnect() a.c = nil end
	F.av2Remove()
	a.safe = nil
	if not on then return end
	a.c = RS.Heartbeat:Connect(function()
		local r = F.root()
		if not r then return end
		local pos = r.Position
		if pos.Y < -100 and a.safe then -- caiu no void de verdade: volta ao último chão real
			F.av2Remove()
			r.CFrame = CFrame.new(a.safe + Vector3.new(0, 3, 0))
			r.AssemblyLinearVelocity = Vector3.zero
			return
		end
		local ex = { player.Character }
		if a.plat then ex[#ex + 1] = a.plat end
		local rp = RaycastParams.new()
		rp.FilterType, rp.FilterDescendantsInstances = Enum.RaycastFilterType.Exclude, ex
		local hit = workspace:Raycast(pos, Vector3.new(0, -20, 0), rp)
		local floor = hit and hit.Instance:IsA("BasePart") and (st.noclip or hit.Instance.CanCollide)
		if floor then
			a.safe = pos
			F.av2Remove()
		elseif not (a.plat and a.plat.Parent) then
			a.platY = pos.Y - 3 -- altura fixa (nunca empurra o boneco)
			a.plat = F.new("Part", { Name = "FakeFloor", Size = Vector3.new(200, 1, 200), Anchored = true, CanCollide = true,
				Transparency = 1, CFrame = CFrame.new(pos.X, a.platY, pos.Z) }, workspace)
		else
			a.plat.CFrame = CFrame.new(pos.X, a.platY, pos.Z) -- só acompanha X e Z
		end
	end)
end
F.track(player.CharacterAdded:Connect(function() X.av2.safe = nil F.av2Remove() end))
---------------------------------------------------------------- ANIMAÇÕES DO VOO (parado · frente · trás · direita · esquerda, com fade, inclinação e packs)
S.fly = type(S.fly) == "table" and S.fly or {}
S.flyPacks = type(S.flyPacks) == "table" and S.flyPacks or {}
F.FA_KEYS = { "idle", "fwd", "back", "right", "left" }
F.FA_NAMES = { idle = "🕊️  Parado no ar", fwd = "➡️  Voando para frente", back = "⬅️  Voando para trás", right = "↪️  Voando para a direita", left = "↩️  Voando para a esquerda" }
F.FA_SHORT = { idle = "Parado", fwd = "Frente", back = "Trás", right = "Direita", left = "Esquerda" }
F.FA_DEF_IDS = { idle = "72443677762664", fwd = "133965316214893", back = "72443677762664", right = "72443677762664", left = "72443677762664" }
F.FA_DEF_TILT = { fwd = false, back = true, right = true, left = true }
-- direção da inclinação (rotação X, rotação Z): X+ = deita para trás · Z- = direita · Z+ = esquerda
local FA_DIR = { fwd = { -1, 0 }, back = { 1, 0 }, right = { 0, -1 }, left = { 0, 1 } }
local function faClean(v)
	local n = tostring(v or ""):match("%d+")
	return (n and #n >= 5) and n or nil
end
local FA = { on = S.fly.on ~= false, ang = tonumber(S.fly.ang) or 12, fade = tonumber(S.fly.fade) or 3, smooth = tonumber(S.fly.smooth) or 8, ids = {}, tilt = {} }
FA.ang, FA.fade, FA.smooth = math.clamp(FA.ang, 2, 45), math.clamp(FA.fade, 0, 20), math.clamp(FA.smooth, 1, 20)
for _, k in ipairs(F.FA_KEYS) do
	FA.ids[k] = faClean(type(S.fly.ids) == "table" and S.fly.ids[k]) or F.FA_DEF_IDS[k]
end
for k, d in pairs(F.FA_DEF_TILT) do
	local v = type(S.fly.tilt) == "table" and S.fly.tilt[k]
	if type(v) ~= "boolean" then v = d end
	FA.tilt[k] = v
end
F.FA = FA
function F.faSave()
	S.fly = { on = FA.on, ang = FA.ang, fade = FA.fade, smooth = FA.smooth, ids = table.clone(FA.ids), tilt = table.clone(FA.tilt) }
	F.save()
end

local R = { tracks = {}, busy = {}, warned = {}, an = nil, cur = nil, state = "idle", cand = nil, candT = 0, tx = 0, tz = 0, ptok = 0, active = false }
F.FAR = R
local function faAnimator()
	local hum = aliveHum()
	if not hum then return nil end
	local an = hum:FindFirstChildOfClass("Animator")
	if not an then
		an = Instance.new("Animator")
		an.Parent = hum
	end
	return an
end
local function faTry(an, assetId)
	local anim = Instance.new("Animation")
	anim.AnimationId = assetId
	local ok, tr = pcall(function() return an:LoadAnimation(anim) end)
	if not ok or not tr then anim:Destroy() return end
	local t0 = os.clock()
	while tr.Length == 0 and os.clock() - t0 < 2.5 do task.wait(0.1) end
	if tr.Length == 0 then
		pcall(function() tr:Destroy() end)
		anim:Destroy()
		return
	end
	return tr
end
-- ID direto; se for um contêiner do catálogo, procura a Animation dentro dele
local function faResolve(an, num)
	local tr = faTry(an, "rbxassetid://" .. num)
	if tr then return tr end
	local ok, objs = pcall(function() return game:GetObjects("rbxassetid://" .. num) end)
	if ok and type(objs) == "table" then
		for _, o in ipairs(objs) do
			local a = o:IsA("Animation") and o or o:FindFirstChildWhichIsA("Animation", true)
			if a and a.AnimationId ~= "" then
				tr = faTry(an, a.AnimationId)
				if tr then break end
			end
		end
		for _, o in ipairs(objs) do pcall(function() o:Destroy() end) end
	end
	return tr
end
local function faDrop()
	for _, t in pairs(R.tracks) do
		if t then pcall(function() t:Stop(0) t:Destroy() end) end
	end
	R.tracks, R.cur = {}, nil
end
local function faGet(num)
	local an = faAnimator()
	if not an then return nil end
	if R.an ~= an then faDrop() R.an = an end
	local e = R.tracks[num]
	if e ~= nil then return e or nil end
	if R.busy[num] then
		local t0 = os.clock()
		while R.busy[num] and os.clock() - t0 < 15 do task.wait(0.1) end
		return R.tracks[num] or nil
	end
	R.busy[num] = true
	local tr = faResolve(an, num)
	R.busy[num] = nil
	if R.an ~= an then
		if tr then pcall(function() tr:Destroy() end) end
		return nil
	end
	if tr then
		tr.Priority, tr.Looped = Enum.AnimationPriority.Action4, true
		X.fbOwn[tr] = true -- o Flashback e a troca de pacotes de animação ignoram estas faixas
		R.tracks[num] = tr
	else
		R.tracks[num] = false
	end
	return tr
end
function F.faPreload()
	task.spawn(function()
		local seen = {}
		for _, k in ipairs(F.FA_KEYS) do
			local n = FA.ids[k]
			if n and not seen[n] then
				seen[n] = true
				pcall(faGet, n)
			end
		end
	end)
end
-- toca a animação do estado com crossfade (a que estava tocando some em "fade" segundos, a nova entra no mesmo tempo)
function F.faPlay(state)
	if not (R.active and FA.on) then return end
	R.ptok += 1
	local tok = R.ptok
	local num = FA.ids[state]
	task.spawn(function()
		local tr = faGet(num)
		if tok ~= R.ptok or not R.active then return end
		if not tr then
			if not R.warned[num] then
				R.warned[num] = true
				F.toast("Animação do voo não carregou (ID " .. num .. ": privada ou inexistente)", "err")
			end
			return
		end
		local fade = FA.fade / 10
		local old = R.cur
		if old and old ~= tr then pcall(function() old:Stop(fade) end) end
		R.cur = tr
		if old ~= tr or not tr.IsPlaying then pcall(function() tr:Play(fade, 1, 1) end) end
	end)
end
function F.faStart()
	if not FA.on then return end
	R.active, R.state, R.cand, R.tx, R.tz = true, "idle", nil, 0, 0
	F.faPlay("idle")
end
function F.faStop()
	R.active, R.cand, R.tx, R.tz = false, nil, 0, 0
	R.ptok += 1
	local fade = FA.fade / 10
	for _, t in pairs(R.tracks) do
		if t then pcall(function() t:Stop(fade) end) end
	end
	R.cur = nil
end
-- liga/desliga as animações com o voo já ativo
function F.faLive()
	if not st.fly then return end
	if FA.on then F.faStart() else F.faStop() end
end
-- IDs mudaram: tenta de novo os que falharam e troca a animação atual
function F.faReload()
	for num, t in pairs(R.tracks) do if t == false then R.tracks[num] = nil end end
	R.warned = {}
	if R.active then F.faPlay(R.state) end
	F.faPreload()
end
-- chamado a cada quadro pelo voo: decide o estado (com pequena trava anti-tremida) e devolve a inclinação suave
function F.faStep(dt, cam, md)
	if not (R.active and FA.on) then
		R.tx, R.tz = 0, 0
		return CFrame.identity
	end
	local want = "idle"
	if md.Magnitude > 0.1 then
		local cf = cam.CFrame
		local lv = cf.LookVector
		local flat = Vector3.new(lv.X, 0, lv.Z)
		if flat.Magnitude < 0.1 then -- olhando reto para cima/baixo: usa o vetor "cima" da câmera como frente
			local uv = cf.UpVector
			flat = Vector3.new(uv.X, 0, uv.Z) * (lv.Y < 0 and 1 or -1)
		end
		if flat.Magnitude > 0.01 then
			flat = flat.Unit
			local right = flat:Cross(Vector3.yAxis)
			local f, s = md:Dot(flat), md:Dot(right)
			if f > 0 and f >= math.abs(s) * 0.7 then want = "fwd"
			elseif f < 0 and -f >= math.abs(s) * 0.7 then want = "back"
			elseif s > 0 then want = "right"
			else want = "left" end
		end
	end
	if want ~= R.state then
		if R.cand ~= want then R.cand, R.candT = want, 0 end
		R.candT += dt
		if R.candT >= 0.07 then
			R.state, R.cand = want, nil
			F.faPlay(want)
		end
	else
		R.cand = nil
	end
	local tx, tz = 0, 0
	local d = FA_DIR[R.state]
	if d and FA.tilt[R.state] then
		local rad = math.rad(FA.ang)
		tx, tz = d[1] * rad, d[2] * rad
	end
	local a = 1 - math.exp(-FA.smooth * dt)
	R.tx += (tx - R.tx) * a
	R.tz += (tz - R.tz) * a
	return CFrame.Angles(R.tx, 0, R.tz)
end

-- ===== packs de voo =====
F.faBoxes = {}
function F.faSnapshot()
	return { ids = table.clone(FA.ids), tilt = table.clone(FA.tilt), ang = FA.ang, fade = FA.fade, smooth = FA.smooth }
end
function F.faApply(d)
	for _, k in ipairs(F.FA_KEYS) do
		local n = faClean(type(d.ids) == "table" and d.ids[k])
		if n then
			FA.ids[k] = n
			if F.faBoxes[k] then F.faBoxes[k].Text = n end
		end
	end
	for k in pairs(F.FA_DEF_TILT) do
		local v = type(d.tilt) == "table" and d.tilt[k]
		if type(v) == "boolean" and Reg["fa_tilt_" .. k] then Reg["fa_tilt_" .. k].set(v) end
	end
	if tonumber(d.ang) and Reg.flyang then Reg.flyang.set(d.ang) end
	if tonumber(d.fade) and Reg.flyfade then Reg.flyfade.set(d.fade) end
	if tonumber(d.smooth) and Reg.flysmooth then Reg.flysmooth.set(d.smooth) end
	F.faSave()
	F.faReload()
end
-- ordem fixa dos packs (a ordem na roda nunca muda: novos entram no fim)
S.flyOrder = type(S.flyOrder) == "table" and S.flyOrder or {}
function F.faNames()
	local out, seen = {}, {}
	for _, n in ipairs(S.flyOrder) do
		if S.flyPacks[n] and not seen[n] then seen[n] = true out[#out + 1] = n end
	end
	local rest = {}
	for n in pairs(S.flyPacks) do if not seen[n] then rest[#rest + 1] = n end end
	table.sort(rest)
	for _, n in ipairs(rest) do out[#out + 1] = n end
	S.flyOrder = out
	return out
end
-- o pack bate com a configuração atual do voo?
function F.faMatches(d)
	if type(d) ~= "table" or type(d.ids) ~= "table" then return false end
	for _, k in ipairs(F.FA_KEYS) do
		if (faClean(d.ids[k]) or F.FA_DEF_IDS[k]) ~= FA.ids[k] then return false end
	end
	for k in pairs(F.FA_DEF_TILT) do
		local v = type(d.tilt) == "table" and d.tilt[k]
		if type(v) == "boolean" and v ~= FA.tilt[k] then return false end
	end
	return (tonumber(d.ang) or FA.ang) == FA.ang and (tonumber(d.fade) or FA.fade) == FA.fade and (tonumber(d.smooth) or FA.smooth) == FA.smooth
end
-- avisa o menu de emotes/roda que a lista de packs de voo mudou (salvar, importar, apagar)
function F.faWheelSync(name)
	local E = F.EMO
	if E and E.afterFly then pcall(E.afterFly, name) end
end
function F.faPackDelete(n)
	if not S.flyPacks[n] then return end
	S.flyPacks[n] = nil
	F.faNames()
	F.save() F.rebuildFlyPacks()
	F.toast("Pack de voo removido: " .. n, "off")
	F.faWheelSync(nil)
end
-- escolher um pack de voo na roda do Roblox = aplicar a configuração dele
function F.faApplyWheel(pk)
	local d = pk and S.flyPacks[pk.n]
	if not d then return F.toast("Pack de voo não encontrado", "err") end
	F.faApply(d)
	F.rebuildFlyPacks()
	F.toast("Voo: pack \"" .. pk.n .. "\" aplicado", "on")
end
function F.faPackSave(name)
	name = tostring(name or ""):gsub("^%s+", ""):gsub("%s+$", ""):gsub("[|;=]", "")
	if name == "" then return F.toast("Dê um nome ao pack") end
	name = name:sub(1, 30)
	local n = 0
	for _ in pairs(S.flyPacks) do n += 1 end
	if n >= 40 and not S.flyPacks[name] then return F.toast("Limite de 40 packs de voo", "err") end
	S.flyPacks[name] = F.faSnapshot()
	F.faNames()
	F.save() F.rebuildFlyPacks()
	F.toast("Pack de voo salvo: " .. name, "ok")
	F.faWheelSync(name)
end
function F.faPackExport(name)
	local d = S.flyPacks[name]
	if not d then return end
	local ids, tl = {}, {}
	for _, k in ipairs(F.FA_KEYS) do ids[#ids + 1] = k .. "=" .. (faClean(d.ids and d.ids[k]) or F.FA_DEF_IDS[k]) end
	for k in pairs(F.FA_DEF_TILT) do tl[#tl + 1] = k .. ":" .. ((d.tilt and d.tilt[k]) and 1 or 0) end
	table.sort(tl)
	F.copyText(("FoxFly|%s|%s|tilt=%s|ang=%d|fade=%d|smooth=%d"):format(name, table.concat(ids, ";"), table.concat(tl, ","),
		tonumber(d.ang) or FA.ang, tonumber(d.fade) or FA.fade, tonumber(d.smooth) or FA.smooth), "Pack")
end
function F.faPackImport(text)
	local name, body = tostring(text or ""):match("^%s*FoxFly|([^|]*)|(.*)$")
	if not name then return F.toast("Código inválido: use o texto copiado em 📋", "err") end
	local d, found = { ids = {}, tilt = {} }, 0
	for k, v in body:gmatch("(%a+)=(%d+)") do
		if table.find(F.FA_KEYS, k) then
			if faClean(v) then d.ids[k] = v found += 1 end
		elseif k == "ang" or k == "fade" or k == "smooth" then
			d[k] = tonumber(v)
		end
	end
	local tl = body:match("tilt=([^|]*)")
	if tl then
		for k, v in tl:gmatch("(%a+):([01])") do d.tilt[k] = v == "1" end
	end
	if found == 0 then return F.toast("Nada para importar neste código", "err") end
	name = (name:gsub("[|;=]", "")):sub(1, 30)
	if name == "" then name = "Pack importado" end
	S.flyPacks[name] = d
	F.faNames()
	F.save() F.rebuildFlyPacks()
	F.toast("Pack importado: " .. name .. " (use Carregar)", "ok")
	F.faWheelSync(name)
end
F.rebuildFlyPacks = function()
	if not V.flyBox then return end
	F.clearBox(V.flyBox)
	local names = F.faNames()
	if #names == 0 then F.note(V.flyBox, "Nenhum pack de voo salvo.", 20) end
	for i, n in ipairs(names) do
		local row = F.new("Frame", { Size = U2(1, 0, 0, 44), BackgroundColor3 = C.item, LayoutOrder = i, R = 12 }, V.flyBox)
		F.txt(row, "🕊️  " .. n .. (F.faMatches(S.flyPacks[n]) and "   ✔ em uso" or ""), { Size = U2(1, -190, 1, 0), Position = U2o(14, 0) })
		F.smallBtn(row, "Carregar", 172, 80, function() F.faApply(S.flyPacks[n]) F.rebuildFlyPacks() F.toast("Pack de voo carregado: " .. n, "ok") end)
		F.smallBtn(row, "📋", 84, 36, function() F.faPackExport(n) end)
		F.smallBtn(row, "×", 40, 32, function() F.faPackDelete(n) end)
	end
end
function F.faIdRow(parent, key)
	local f = F.row(parent, 46)
	F.txt(f, F.FA_NAMES[key], { Size = U2(1, -250, 1, 0), Position = U2o(14, 0), TextSize = 12 })
	local tb = F.new("TextBox", { Size = U2o(150, 30), Position = U2(1, -214, 0.5, -15), BackgroundColor3 = C.panel, Text = FA.ids[key], PlaceholderText = "ID da animação",
		PlaceholderColor3 = C.muted, TextColor3 = C.white, Font = EF.GothamMedium, TextSize = 12, ClearTextOnFocus = false, TextXAlignment = EXA.Left, R = 9 }, f)
	F.new("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) }, tb)
	F.faBoxes[key] = tb
	tb.FocusLost:Connect(function()
		local n = faClean(tb.Text)
		if not n then
			tb.Text = FA.ids[key]
			return F.toast("ID inválido: digite só o número", "err")
		end
		tb.Text = n
		if n == FA.ids[key] then return end
		FA.ids[key] = n
		F.faSave() F.faReload()
		F.toast("ID atualizado: " .. F.FA_SHORT[key], "ok")
	end)
	F.smallBtn(f, "↺", 44, 32, function()
		FA.ids[key] = F.FA_DEF_IDS[key]
		tb.Text = FA.ids[key]
		F.faSave() F.faReload()
		F.toast("ID padrão restaurado: " .. F.FA_SHORT[key], "ok")
	end)
	F.reg("fa_id_" .. key, "ID da animação do voo · " .. F.FA_SHORT[key], "input", function() F.goTo("fa_id_" .. key) end, nil, f)
end
F.faPreload()
F.track(player.CharacterAdded:Connect(function() R.warned = {} task.wait(1) F.faPreload() end))

---------------------------------------------------------------- MORTAL (flip para frente / para trás, com teclas configuráveis)
do
	S.flip = type(S.flip) == "table" and S.flip or {}
	local FL = { on = false, busy = false, cap = nil,
		jump = math.clamp(tonumber(S.flip.jump) or 45, 20, 120),
		dur = math.clamp(tonumber(S.flip.dur) or 6, 3, 15), -- duração do giro em décimos de segundo
		fwd = type(S.flip.fwd) == "string" and S.flip.fwd or "",
		back = type(S.flip.back) == "string" and S.flip.back or "" }
	F.FLIP = FL
	local LABEL = { fwd = "mortal para frente", back = "mortal para trás" }
	local function keyText(k) return k ~= "" and k or "Nenhuma" end
	local function save() S.flip = { jump = FL.jump, dur = FL.dur, fwd = FL.fwd, back = FL.back } F.save() end
	function F.flipShow()
		if V.I.flip_fwd then V.I.flip_fwd(keyText(FL.fwd)) end
		if V.I.flip_back then V.I.flip_back(keyText(FL.back)) end
	end
	function F.setFlip(on) FL.on = on end
	function F.flipJump(v) FL.jump = v save() end
	function F.flipDur(v) FL.dur = v save() end
	function F.flipSetKey(which)
		FL.cap = which
		F.toast("Aperte a tecla para " .. LABEL[which] .. " (Esc cancela)")
	end
	function F.flipClearKey(which)
		FL[which] = ""
		save() F.flipShow()
		F.toast("Tecla removida: " .. LABEL[which])
	end

	-- dir = 1: para frente · dir = -1: para trás
	function F.flip(dir)
		local r, h = F.root(), aliveHum()
		if not (r and h) or FL.busy or st.fly then return end
		FL.busy = true
		local lv = r.CFrame.LookVector
		local flat = Vector3.new(lv.X, 0, lv.Z)
		flat = flat.Magnitude > 0.01 and flat.Unit or Vector3.new(0, 0, -1)
		local axis = flat:Cross(Vector3.yAxis) -- eixo "direita" do personagem
		local upright = CFrame.lookAt(Vector3.zero, flat) -- só a rotação, em pé
		local oldAR = h.AutoRotate
		r.AssemblyLinearVelocity = flat * dir * 18 + Vector3.new(0, FL.jump, 0)
		h.AutoRotate, h.PlatformStand = false, true
		local dur, t0, conn, done = FL.dur / 10, os.clock(), nil, false
		local function finish()
			if done then return end
			done = true
			if conn then conn:Disconnect() conn = nil end
			FL.busy = false
			local rr, hh = F.root(), F.hum()
			if rr and rr.Parent then
				rr.CFrame = CFrame.new(rr.Position) * upright
				rr.AssemblyAngularVelocity = Vector3.zero
			end
			if hh then
				hh.AutoRotate = oldAR
				if not st.fly then hh.PlatformStand = false end
			end
		end
		conn = RS.Heartbeat:Connect(function()
			local rr, hh = F.root(), aliveHum()
			if not (rr and hh) or hh ~= h or V.closing then return finish() end
			local a = math.clamp((os.clock() - t0) / dur, 0, 1)
			rr.CFrame = CFrame.new(rr.Position) * CFrame.fromAxisAngle(axis, -dir * math.pi * 2 * a) * upright
			rr.AssemblyAngularVelocity = Vector3.zero
			if a >= 1 then finish() end
		end)
		task.delay(dur + 1, finish) -- segurança
	end

	F.track(UIS.InputBegan:Connect(function(i, gp)
		if i.UserInputType ~= Enum.UserInputType.Keyboard or V.closing then return end
		local name = i.KeyCode.Name
		if FL.cap then -- capturando a nova tecla
			local which = FL.cap
			FL.cap = nil
			if i.KeyCode == KC.Escape then return F.toast("Atalho cancelado") end
			local other = which == "fwd" and "back" or "fwd"
			if FL[other] == name then FL[other] = "" end -- cada tecla serve a uma ação só
			FL[which] = name
			save() F.flipShow()
			return F.toast("Tecla do " .. LABEL[which] .. ": " .. name, "ok")
		end
		if gp or not FL.on or UIS:GetFocusedTextBox() or (F.isListening and F.isListening()) then return end
		if FL.fwd ~= "" and name == FL.fwd then F.flip(1)
		elseif FL.back ~= "" and name == FL.back then F.flip(-1) end
	end))
end

---------------------------------------------------------------- TECLA DO BOOST DO VOO (configurável · padrão: CTRL esquerdo)
do
	local DEFAULT = "LeftControl"
	local function valid(n) return type(n) == "string" and n ~= "" and Enum.KeyCode[n] ~= nil end
	local okk = pcall(function() return Enum.KeyCode[tostring(S.boostKey)] end) and valid(S.boostKey)
	local B = { key = okk and S.boostKey or DEFAULT, cap = false }
	F.BOOST = B
	local function show()
		if V.I.boost_key then V.I.boost_key(B.key == DEFAULT and "Ctrl esquerdo (padrão)" or B.key) end
	end
	F.boostShow = show
	-- usada pelo voo a cada quadro
	function F.boostDown()
		if UIS:GetFocusedTextBox() then return false end
		local ok, kc = pcall(function() return Enum.KeyCode[B.key] end)
		if not (ok and kc) then kc = Ctrl end
		-- no padrão, aceita também o CTRL direito
		if B.key == DEFAULT and UIS:IsKeyDown(KC.RightControl) then return true end
		return UIS:IsKeyDown(kc)
	end
	function F.boostSetKey()
		B.cap = true
		F.toast("Aperte a tecla do boost do voo (Esc cancela)")
	end
	function F.boostResetKey()
		B.key, S.boostKey = DEFAULT, nil
		F.save() show()
		F.toast("Tecla do boost: Ctrl esquerdo (padrão)", "ok")
	end
	F.track(UIS.InputBegan:Connect(function(i)
		if not B.cap or V.closing or i.UserInputType ~= Enum.UserInputType.Keyboard then return end
		B.cap = false
		if i.KeyCode == KC.Escape then return F.toast("Atalho cancelado") end
		if i.KeyCode == KC.Unknown then return end
		B.key, S.boostKey = i.KeyCode.Name, i.KeyCode.Name
		F.save() show()
		local msg = "Tecla do boost: " .. B.key
		if ({ W = true, A = true, S = true, D = true, Q = true, E = true, Z = true, V = true, B = true, C = true, Space = true })[B.key] then
			msg ..= "  ·  atenção: usada por outro recurso"
		end
		F.toast(msg, "ok")
	end))
end

---------------------------------------------------------------- IDENTIFICAÇÃO FOXMENU (🦊 | FoxMenu | dispositivo) + tag OWNER / DEV
-- Como funciona: um script de cliente não consegue falar direto com o de outro jogador. Por isso cada usuário do FoxMenu
-- toca, no próprio personagem, uma animação "sinal" quase invisível (prioridade mais baixa, peso 0.02). Animações do seu
-- personagem são replicadas para todos, então os outros FoxMenu leem as animações que tocam no boneco alheio e reconhecem o sinal.
-- Cada dispositivo usa um ID diferente (PC / Celular / Console): é assim que o emoji certo aparece.
-- DICA: os IDs abaixo reaproveitam animações do próprio FoxMenu. Para um sinal 100% limpo, publique 3 animações vazias suas
-- e troque os IDs em TG.IDS.
do
	S.tg = type(S.tg) == "table" and S.tg or {}
	local TG = {
		OWNER_NAME = "Onnexs_Chans", -- dono e desenvolvedor: a tag OWNER / DEV é exclusiva dele
		OWNER_ID = nil, -- (opcional) coloque aqui o UserId numérico dele; se vazio, o menu descobre pelo nome
		-- >>> COLE AQUI O ENDEREÇO DO SEU SERVIDOR (ex: "https://foxmenu-relay.onrender.com").
		-- Com endereço = usa o servidor (recomendado). Vazio = usa o sinal por animação (menos confiável).
		SERVER_URL = "https://foxmenu-relay.onrender.com",
		net = { busy = false, last = 0 },
		-- >>> AJUSTES DA TAG (distância em studs, medida a partir da CÂMERA)
		MAX_DIST  = 60,   -- some completamente além dessa distância
		FULL_DIST = 25,   -- até aqui a tag fica no tamanho normal; depois disso vai encolhendo
		MIN_SCALE = 0.35, -- tamanho mínimo antes de sumir (0.35 = 35%)
		IDS = { pc = "108172243817649", mobile = "133965316214893", console = "72443677762664" },
		EMO = { pc = "🖥️", mobile = "📱", console = "🎮" },
		LBL = { pc = "PC", mobile = "Celular", console = "Console" },
		cfg = { share = S.tg.share ~= false, self = S.tg.self ~= false, others = S.tg.others ~= false, owner = S.tg.owner ~= false, incognito = S.tg.incognito == true },
		tracks = {}, failT = {}, peers = {}, bb = {}, byId = {}, loading = false, animator = nil, warned = false,
	}
	F.TG = TG
	for dev, id in pairs(TG.IDS) do TG.byId[tonumber(id)] = dev end

	function TG.save()
		S.tg = { share = TG.cfg.share, self = TG.cfg.self, others = TG.cfg.others, owner = TG.cfg.owner, incognito = TG.cfg.incognito }
		F.save()
	end
	-- a tag OWNER / DEV só existe para o Onnexs_Chans: quem decide é SEMPRE quem está vendo (UserId do jogador),
	-- então ninguém consegue "se dar" a tag perante os outros
	function TG.isOwner(p)
		if not p then return false end
		if TG.OWNER_ID then return p.UserId == TG.OWNER_ID end
		return p.Name == TG.OWNER_NAME
	end
	function TG.ownerUI() -- a opção da tag OWNER (e o modo incógnito) só aparecem para o dono
		for _, id in ipairs({ "tg_owner", "tg_incognito" }) do
			local e = Ent[id]
			if e and e.frame then e.frame.Visible = TG.isOwner(player) end
		end
	end
	task.spawn(function()
		for _ = 1, 6 do
			if V.closing or TG.OWNER_ID then break end
			local ok, id = pcall(Players.GetUserIdFromNameAsync, Players, TG.OWNER_NAME)
			if ok and type(id) == "number" then TG.OWNER_ID = id break end
			task.wait(4)
		end
		TG.ownerUI()
	end)

	function TG.myDevice()
		local ten = false
		pcall(function() ten = game:GetService("GuiService"):IsTenFootInterface() end)
		if ten then return "console" end
		if UIS.TouchEnabled and not UIS.KeyboardEnabled then return "mobile" end
		if UIS.GamepadEnabled and not UIS.KeyboardEnabled and not UIS.TouchEnabled then return "console" end
		return "pc"
	end

	---------- emissão do sinal
	function TG.dropTracks()
		for _, t in pairs(TG.tracks) do
			if t then pcall(function() t:Stop(0) t:Destroy() end) end
		end
		TG.tracks, TG.animator = {}, nil
	end
	function TG.broadcast()
		if TG.loading then return end
		local hum = aliveHum()
		local an = hum and hum:FindFirstChildOfClass("Animator")
		if TG.isOwner(player) and TG.cfg.incognito then -- incógnito: nem o sinal de identificação sai
			for _, t in pairs(TG.tracks) do
				if t and t.IsPlaying then pcall(function() t:Stop(0.1) end) end
			end
			return
		end
		if not (TG.cfg.share and an) then
			for _, t in pairs(TG.tracks) do
				if t and t.IsPlaying then pcall(function() t:Stop(0.1) end) end
			end
			return
		end
		if TG.animator ~= an then TG.dropTracks() TG.animator = an end
		local dev = TG.myDevice()
		for d, t in pairs(TG.tracks) do
			if d ~= dev and t and t.IsPlaying then pcall(function() t:Stop(0.1) end) end
		end
		local t = TG.tracks[dev]
		if t == false and os.clock() - (TG.failT[dev] or 0) > 30 then t, TG.tracks[dev] = nil, nil end -- tenta de novo
		if t == nil then
			TG.loading = true
			task.spawn(function()
				local ok, tr = pcall(faResolve, an, TG.IDS[dev])
				if ok and tr and TG.animator == an and not V.closing then
					tr.Priority, tr.Looped = Enum.AnimationPriority.Core, true
					X.fbOwn[tr] = true -- Flashback e troca de pacotes ignoram esta faixa
					TG.tracks[dev] = tr
				elseif TG.animator == an then
					TG.tracks[dev], TG.failT[dev] = false, os.clock()
					if not TG.warned then
						TG.warned = true
						F.toast("Identificação: o sinal não carregou (os outros podem não te ver)", "err")
					end
				end
				TG.loading = false
			end)
		elseif t and not t.IsPlaying then
			pcall(function() t:Play(0.1, 0.02, 1) end)
		end
	end

	---------- leitura do sinal dos outros
	function TG.scan()
		local now = os.clock()
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= player then
				local hum = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
				local an = hum and hum:FindFirstChildOfClass("Animator")
				local found
				if an then
					local ok, list = pcall(an.GetPlayingAnimationTracks, an)
					if ok and type(list) == "table" then
						for _, tr in ipairs(list) do
							local a = tr.Animation
							local num = a and tonumber(tostring(a.AnimationId):match("%d+"))
							local d = num and TG.byId[num]
							if d then found = found or {} found[d] = true end
						end
					end
				end
				local pe = TG.peers[p]
				if found then
					local dev
					if pe and found[pe.dev] then dev = pe.dev -- mantém o dispositivo já confirmado
					else
						for _, d in ipairs({ "pc", "mobile", "console" }) do
							if found[d] then dev = d break end
						end
					end
					if not pe then
						TG.peers[p] = { dev = dev, n = 1, last = now, ok = false, cn = 0 }
					else
						pe.last = now
						if pe.dev == dev then
							pe.n, pe.cn = pe.n + 1, 0
						else
							pe.cn += 1
							if pe.cn >= 3 then pe.dev, pe.cn = dev, 0 end -- só troca se persistir (evita piscar)
						end
						if pe.n >= 2 then pe.ok = true end -- confirmado após 2 leituras seguidas
					end
				elseif pe and now - pe.last > 8 then
					TG.peers[p] = nil
				end
			end
		end
		for p in pairs(TG.peers) do
			if not p.Parent then TG.peers[p] = nil end
		end
	end

	---------- visual
	function TG.build(head, dev, own, mus)
		local b = F.new("BillboardGui", { Name = "FoxTag", Adornee = head, Size = U2o(280, 64), StudsOffset = Vector3.new(0, 3.9, 0),
			AlwaysOnTop = false, MaxDistance = TG.MAX_DIST, LightInfluence = 0 }, gui)
		local wrap = F.new("Frame", { AnchorPoint = Vector2.new(0.5, 1), Position = U2(0.5, 0, 1, 0), Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 }, b)
		local dsc = F.new("UIScale", { Scale = 1 }, wrap) -- escala por distância
		local box = F.new("Frame", { AnchorPoint = Vector2.new(0.5, 1), Position = U2(0.5, 0, 1, 0), Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 }, wrap)
		F.new("UIListLayout", { VerticalAlignment = Enum.VerticalAlignment.Bottom, HorizontalAlignment = Enum.HorizontalAlignment.Center,
			Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder }, box)
		local sc = F.new("UIScale", { Scale = 0.7 }, box)
		local function pad(o, l, r, t, bt)
			F.new("UIPadding", { PaddingLeft = UDim.new(0, l), PaddingRight = UDim.new(0, r), PaddingTop = UDim.new(0, t), PaddingBottom = UDim.new(0, bt) }, o)
		end
		local function row(o, gap) -- conteúdo em linha, centralizado na vertical
			F.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, VerticalAlignment = Enum.VerticalAlignment.Center,
				HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, gap), SortOrder = Enum.SortOrder.LayoutOrder }, o)
		end
		local function grad(parent, seq, rot)
			local g = Instance.new("UIGradient")
			g.Color, g.Rotation = seq, rot or 0
			g.Parent = parent
			return g
		end
		local function kp(t, c) return ColorSequenceKeypoint.new(t, c) end
		if own then -- tag do dono: cápsula dourada com brilho passando, coroa e texto em caixa alta
			local o = F.new("Frame", { AutomaticSize = Enum.AutomaticSize.XY, Size = U2(), BackgroundColor3 = C3(255, 255, 255),
				BorderSizePixel = 0, LayoutOrder = 1, R = 999 }, box)
			local g = grad(o, ColorSequence.new({ kp(0, FOX.d), kp(0.42, FOX.l), kp(0.5, C3(255, 236, 196)), kp(0.58, FOX.l), kp(1, FOX.d) }), 0)
			g.Offset = Vector2.new(-1, 0)
			pcall(function() -- brilho que atravessa a tag de tempos em tempos
				TS:Create(g, TweenInfo.new(2.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, false, 1.2), { Offset = Vector2.new(1, 0) }):Play()
			end)
			local k = Instance.new("UIStroke")
			k.Color, k.Thickness, k.Transparency = C3(255, 238, 205), 1.6, 0.1
			k.Parent = o
			row(o, 5)
			pad(o, 11, 13, 3, 3)
			F.txt(o, "👑", { AutomaticSize = Enum.AutomaticSize.XY, Size = U2(), TextSize = 14, LayoutOrder = 1, TextTruncate = Enum.TextTruncate.None })
			F.txt(o, "OWNER", { AutomaticSize = Enum.AutomaticSize.XY, Size = U2(), TextColor3 = FOX.k, Font = EF.GothamBlack, TextSize = 13,
				LayoutOrder = 2, TextTruncate = Enum.TextTruncate.None })
			F.new("Frame", { Size = U2o(1, 12), BackgroundColor3 = FOX.k, BackgroundTransparency = 0.55, BorderSizePixel = 0, LayoutOrder = 3 }, o)
			F.txt(o, "DEV", { AutomaticSize = Enum.AutomaticSize.XY, Size = U2(), TextColor3 = FOX.k, Font = EF.GothamBlack, TextSize = 13,
				LayoutOrder = 4, TextTruncate = Enum.TextTruncate.None })
		end
		local spkScale
		if mus then -- 🎵 | nome da música | 🔊  (fica ACIMA da tag FoxMenu e ABAIXO da tag OWNER)
			local nm = mus
			local nn = utf8.len(nm)
			if nn and nn > 30 then nm = nm:sub(1, utf8.offset(nm, 31) - 1) .. "…" end
			local mp = F.new("Frame", { AutomaticSize = Enum.AutomaticSize.XY, Size = U2(), BackgroundColor3 = C3(255, 255, 255),
				BackgroundTransparency = 0.06, BorderSizePixel = 0, LayoutOrder = 2, R = 999 }, box)
			grad(mp, ColorSequence.new(C3(34, 30, 38), C3(12, 12, 16)), 90)
			local mst = Instance.new("UIStroke")
			mst.Color, mst.Thickness, mst.Transparency = C3(255, 255, 255), 1.4, 0
			mst.Parent = mp
			grad(mst, ColorSequence.new(FOX.l, FOX.d), 35)
			row(mp, 7)
			pad(mp, 10, 11, 4, 4)
			F.txt(mp, "🎵", { AutomaticSize = Enum.AutomaticSize.XY, Size = U2(), TextSize = 13, LayoutOrder = 1, TextTruncate = Enum.TextTruncate.None })
			F.new("Frame", { Size = U2o(1, 14), BackgroundColor3 = C3(255, 255, 255), BackgroundTransparency = 0.7, BorderSizePixel = 0, LayoutOrder = 2 }, mp)
			F.txt(mp, nm, { AutomaticSize = Enum.AutomaticSize.XY, Size = U2(), TextColor3 = C3(255, 255, 255), Font = EF.GothamBold, TextSize = 12,
				LayoutOrder = 3, TextTruncate = Enum.TextTruncate.None })
			F.new("Frame", { Size = U2o(1, 14), BackgroundColor3 = C3(255, 255, 255), BackgroundTransparency = 0.7, BorderSizePixel = 0, LayoutOrder = 4 }, mp)
			local spk = F.txt(mp, "🔊", { AutomaticSize = Enum.AutomaticSize.XY, Size = U2(), TextSize = 13, LayoutOrder = 5, TextTruncate = Enum.TextTruncate.None })
			spkScale = F.new("UIScale", { Scale = 1 }, spk)
		end
		if dev then -- [🦊] FoxMenu | 🖥️ PC
			local pill = F.new("Frame", { AutomaticSize = Enum.AutomaticSize.XY, Size = U2(), BackgroundColor3 = C3(255, 255, 255),
				BackgroundTransparency = 0.06, BorderSizePixel = 0, LayoutOrder = 3, R = 999 }, box)
			grad(pill, ColorSequence.new(C3(34, 30, 38), C3(12, 12, 16)), 90)
			local ps = Instance.new("UIStroke")
			ps.Color, ps.Thickness, ps.Transparency = C3(255, 255, 255), 1.4, 0
			ps.Parent = pill
			grad(ps, ColorSequence.new(FOX.l, FOX.d), 35) -- contorno em degradê laranja
			row(pill, 7)
			pad(pill, 4, 12, 4, 4)
			local badge = F.new("Frame", { Size = U2o(22, 22), BackgroundColor3 = C3(255, 255, 255), BorderSizePixel = 0, LayoutOrder = 1, R = 999 }, pill)
			grad(badge, ColorSequence.new(FOX.l, FOX.d), 90)
			F.txt(badge, "🦊", { Size = UDim2.fromScale(1, 1), TextSize = 13, TextXAlignment = EXA.Center, TextTruncate = Enum.TextTruncate.None })
			local nm = F.txt(pill, "FoxMenu", { AutomaticSize = Enum.AutomaticSize.XY, Size = U2(), TextColor3 = C3(255, 255, 255), Font = EF.GothamBlack,
				TextSize = 13, LayoutOrder = 2, TextTruncate = Enum.TextTruncate.None })
			grad(nm, ColorSequence.new(FOX.c, FOX.l), 0)
			F.new("Frame", { Size = U2o(1, 14), BackgroundColor3 = C3(255, 255, 255), BackgroundTransparency = 0.7, BorderSizePixel = 0, LayoutOrder = 3 }, pill)
			F.txt(pill, ("%s  %s"):format(TG.EMO[dev] or "", TG.LBL[dev] or ""), { AutomaticSize = Enum.AutomaticSize.XY, Size = U2(),
				TextColor3 = C3(190, 190, 202), Font = EF.GothamBold, TextSize = 12, LayoutOrder = 4, TextTruncate = Enum.TextTruncate.None })
		end
		F.tw(sc, { Scale = 1 }, 0.4, BACK)
		return { gui = b, head = head, dev = dev, own = own, dsc = dsc, mus = mus, spk = spkScale }
	end
	-- o que mostrar para cada jogador (cada opção age só no seu pedaço)
	function TG.want(p)
		if p == player then
			local dev = TG.cfg.self and TG.myDevice() or nil
			return dev, TG.isOwner(p) and TG.cfg.owner and not TG.cfg.incognito
		end
		if not TG.cfg.others then return nil, false end
		local pe = TG.peers[p]
		if not (pe and pe.ok) then return nil, false end
		return pe.dev, TG.isOwner(p)
	end
	function TG.render()
		local alive = {}
		for _, p in ipairs(Players:GetPlayers()) do
			local head = p.Character and p.Character:FindFirstChild("Head")
			local dev, own, mus
			if head then
				dev, own = TG.want(p)
				if F.musicFor then local okm, nm = pcall(F.musicFor, p) mus = okm and nm or nil end
			end
			own = own and true or false
			if head and (dev or own or mus) then
				alive[p] = true
				local cur = TG.bb[p]
				if not cur or cur.head ~= head or cur.dev ~= dev or cur.own ~= own or cur.mus ~= mus or not cur.gui.Parent then
					if cur then pcall(function() cur.gui:Destroy() end) end
					TG.bb[p] = TG.build(head, dev, own, mus)
				end
			end
		end
		for p, e in pairs(TG.bb) do
			if not alive[p] then
				pcall(function() e.gui:Destroy() end)
				TG.bb[p] = nil
			end
		end
	end
	-- encolhe com a distância e esconde além de TG.MAX_DIST (roda todo quadro, para ficar suave)
	F.track(RS.RenderStepped:Connect(function()
		local cam = F.CAM()
		if not cam then return end
		local cp = cam.CFrame.Position
		for _, e in pairs(TG.bb) do
			if e.head and e.head.Parent and e.gui.Parent then
				local d = (e.head.Position - cp).Magnitude
				e.gui.Enabled = d <= TG.MAX_DIST
				e.dsc.Scale = math.clamp(TG.FULL_DIST / math.max(d, 1), TG.MIN_SCALE, 1)
			end
		end
	end))

	---------- modo servidor: avisa que você usa o FoxMenu e recebe quem mais usa neste mesmo servidor do jogo
	function TG.netStep()
		if TG.net.busy or os.clock() - TG.net.last < 4 then return end
		local rq = request or http_request or (syn and syn.request) or (http and http.request)
		if not rq then
			if not TG.warned then TG.warned = true F.toast("Identificação: seu executor não tem request()", "err") end
			return
		end
		TG.net.busy, TG.net.last = true, os.clock()
		local base = TG.SERVER_URL:gsub("/+$", "")
		local dev = TG.myDevice()
		task.spawn(function()
			local ok, res = pcall(function()
				-- CORREÇÃO: no modo incógnito (só o dono) o aviso ao servidor também não sai; antes só o sinal por animação respeitava isso
				if TG.cfg.share and not (TG.isOwner(player) and TG.cfg.incognito) then
					return rq({ Url = base .. "/ping", Method = "POST", Headers = { ["Content-Type"] = "application/json" },
						Body = Http:JSONEncode({ j = game.JobId, u = player.UserId, d = dev }) })
				end
				return rq({ Url = base .. "/list?j=" .. Http:UrlEncode(game.JobId), Method = "GET" })
			end)
			TG.net.busy = false
			if not (ok and type(res) == "table" and res.StatusCode == 200) then
				if not TG.warned then
					TG.warned = true
					F.toast("Identificação: sem resposta do servidor (confira o endereço em TG.SERVER_URL)", "err")
				end
				return
			end
			TG.warned = false
			local okd, data = pcall(Http.JSONDecode, Http, res.Body)
			if not (okd and type(data) == "table") then return end
			local by = {}
			for _, e in ipairs(data) do
				if type(e) == "table" and tonumber(e.u) and TG.EMO[e.d] then by[tonumber(e.u)] = e.d end
			end
			local now = os.clock()
			for _, p in ipairs(Players:GetPlayers()) do
				if p ~= player then
					local d = by[p.UserId]
					TG.peers[p] = d and { dev = d, ok = true, last = now, n = 9, cn = 0 } or nil
				end
			end
		end)
	end
	function TG.tick()
		if TG.SERVER_URL ~= "" then
			pcall(TG.netStep)
		else
			pcall(TG.broadcast)
			pcall(TG.scan)
		end
		pcall(TG.render)
		local d = TG.myDevice()
		if V.I.tg_dev then V.I.tg_dev(TG.EMO[d] .. "  " .. TG.LBL[d]) end
		if V.I.tg_n then
			local n = 0
			for _, pe in pairs(TG.peers) do if pe.ok then n += 1 end end
			V.I.tg_n(tostring(n))
		end
	end
	local acc = 0
	F.track(RS.Heartbeat:Connect(function(dt)
		acc += dt
		if acc < 1 then return end
		acc = 0
		if not V.closing then TG.tick() end
	end))
	F.track(Players.PlayerRemoving:Connect(function(p)
		TG.peers[p] = nil
		local e = TG.bb[p]
		if e then pcall(function() e.gui:Destroy() end) TG.bb[p] = nil end
	end))

	-- alto-falante da tag de música: pulsa de leve. Na sua tag segue o volume real do áudio; nas dos outros é um pulso suave
	-- (o áudio dos outros não toca no seu jogo, então não existe volume para medir)
	F.track(RS.RenderStepped:Connect(function()
		local t = os.clock()
		for p, e in pairs(TG.bb) do
			local sc = e.spk
			if sc and sc.Parent then
				local k
				if p == player then
					local sn = F.musicSnd and F.musicSnd()
					k = (sn and sn.IsPlaying) and math.clamp(sn.PlaybackLoudness / 350, 0, 1) or 0
				else
					k = 0.35 + 0.35 * math.sin(t * 6 + (p.UserId % 7))
				end
				sc.Scale += ((1 + 0.22 * k) - sc.Scale) * 0.35
			end
		end
	end))

	---------- opções (cada uma independente)
	function F.tgSetShare(on) TG.cfg.share = on TG.save() task.defer(TG.tick) end
	function F.tgSetSelf(on) TG.cfg.self = on TG.save() task.defer(TG.tick) end
	function F.tgSetOthers(on) TG.cfg.others = on TG.save() task.defer(TG.tick) end
	function F.tgSetOwner(on)
		if not TG.isOwner(player) then return end
		TG.cfg.owner = on
		TG.save()
		task.defer(TG.tick)
	end
	function F.tgSetIncognito(on)
		if not TG.isOwner(player) then return end
		TG.cfg.incognito = on
		TG.save()
		task.defer(TG.tick)
		if on then F.toast("Modo incógnito ligado: sua tag some pra todo mundo, inclusive pra você", "ok") end
	end
	function F.tgStop()
		TG.dropTracks()
		for p, e in pairs(TG.bb) do
			pcall(function() e.gui:Destroy() end)
			TG.bb[p] = nil
		end
	end
end

