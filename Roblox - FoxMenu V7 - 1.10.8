function F.makePalette(theme, accent)
	local t, p = THEMES[theme], {}
	for k, v in pairs(t) do p[k] = v end
	p.white, p.accent = ACCENTS[accent] or t.accent, nil
	local l = 0.299 * p.white.R + 0.587 * p.white.G + 0.114 * p.white.B
	p.black = l > 0.55 and C3(0, 0, 0) or C3(255, 255, 255)
	return p
end
