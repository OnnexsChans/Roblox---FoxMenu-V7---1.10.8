local h0 = F.hum()
local origWS, origJP, origUJP = h0 and h0.WalkSpeed or 16, h0 and h0.JumpPower or 50, h0 and h0.UseJumpPower
if origUJP == nil then origUJP = true end
local origGravity = workspace.Gravity
local L0 = {}
for _, k in ipairs({ "Brightness", "Ambient", "OutdoorAmbient", "GlobalShadows", "FogEnd", "ClockTime", "ColorShift_Top", "ColorShift_Bottom", "ExposureCompensation" }) do
	L0[k] = Lighting[k]
end

function F.baseWS() return st.statsTouched and st.ws or origWS end
function F.applyStats()
	local h = F.hum()
	if h then h.WalkSpeed, h.UseJumpPower, h.JumpPower = st.ws, true, st.jp end
end
function F.restoreStats()
	st.statsTouched = false
	local h = F.hum()
	if h then h.WalkSpeed, h.UseJumpPower, h.JumpPower = origWS, origUJP, origJP end
end
function F.charParams(extra)
	local rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Exclude
	local l = { player.Character }
	for _, e in ipairs(extra or {}) do l[#l + 1] = e end
	rp.FilterDescendantsInstances = l
	return rp
end
function F.isCharPart(p)
	local m = p:FindFirstAncestorOfClass("Model")
	return m and Players:GetPlayerFromCharacter(m)
end

do -- voo, noclip, pulos, planar, água, escalada, gravação, ciclo
	local bv, bg, flyConn, flyVel, flyHum, flyTok = nil, nil, nil, Vector3.zero, nil, 0
	-- silencia o som de passos enquanto voa (guarda o volume original e restaura ao parar)
	local stepSaved = {}
	local STEP_NAMES = { Running = true, Walking = true }
	local function muteSteps()
		local c = player.Character
		if not c then return end
		for _, d in ipairs(c:GetDescendants()) do
			if d:IsA("Sound") and STEP_NAMES[d.Name] then
				if stepSaved[d] == nil then stepSaved[d] = d.Volume end
				d.Volume = 0
			end
		end
	end
	local function restoreSteps()
		for snd, vol in pairs(stepSaved) do
			if snd.Parent then pcall(function() snd.Volume = vol end) end
		end
		stepSaved = {}
	end
	local function flyClean()
		if flyConn then flyConn:Disconnect() flyConn = nil end
		if bv then pcall(function() bv:Destroy() end) bv = nil end
		if bg then pcall(function() bg:Destroy() end) bg = nil end
		-- varre sobras deste recurso (ex.: personagem trocado) e devolve o controle ao Humanoid
		local c = player.Character
		if c then
			for _, d in ipairs(c:GetDescendants()) do
				if d.Name == "Fox_FlyBV" or d.Name == "Fox_FlyBG" then pcall(function() d:Destroy() end) end
			end
		end
		if F.faStop then pcall(F.faStop) end -- animações do voo: fade out suave
		restoreSteps() -- passos voltam ao normal
		if flyHum and flyHum.Parent then pcall(function() flyHum.PlatformStand = false end) end
		flyHum = nil
		local h = F.hum()
		if h then h.PlatformStand = false end
	end
	function F.setFly(on)
		on = on and true or false
		flyTok += 1
		local tok = flyTok
		st.fly = on
		flyClean()
		if not on then return end
		local r, h = F.root(), F.hum()
		if not (r and h) then return end -- sem personagem agora: o CharacterAdded religa
		h.PlatformStand, flyHum, flyVel = true, h, Vector3.zero
		bv = F.new("BodyVelocity", { Name = "Fox_FlyBV", MaxForce = Vector3.one * 1e9, Velocity = Vector3.zero }, r)
		bg = F.new("BodyGyro", { Name = "Fox_FlyBG", MaxTorque = Vector3.one * 1e9, P = 1e4 }, r)
		local myConn
		myConn = RS.RenderStepped:Connect(function(dt)
			if tok ~= flyTok or not st.fly then myConn:Disconnect() return end -- conexão velha: some sozinha
			local cam, hh, rr = F.CAM(), F.hum(), F.root()
			if not (hh and rr and cam) then return end
			if hh ~= flyHum or not bv or not bg or bv.Parent ~= rr or bg.Parent ~= rr then return F.setFly(true) end -- personagem/corpo trocado
			hh.PlatformStand = true
			muteSteps() -- sem som de passos enquanto voa
			local dir, md = Vector3.zero, hh.MoveDirection
			if md.Magnitude > 0 then
				local l = cam.CFrame:VectorToObjectSpace(md)
				dir = cam.CFrame.LookVector * -l.Z + cam.CFrame.RightVector * l.X
			end
			local goal = dir * st.flySpeed * (F.boostDown() and st.boost or 1)
			flyVel = st.smooth and flyVel:Lerp(goal, math.clamp(dt * 8, 0, 1)) or goal
			bv.Velocity = flyVel
			-- animações do voo: detecta a direção e devolve a inclinação suave (CFrame) do estado atual
			local tilt = CFrame.identity
			if F.faStep then
				local okT, t = pcall(F.faStep, dt, cam, md)
				if okT and t then tilt = t end
			end
			bg.CFrame = cam.CFrame * tilt
		end)
		flyConn = myConn
		if F.faStart then pcall(F.faStart) end
	end

	local ccSaved, ccWas = {}, false
	function F.restoreCollide()
		for p in pairs(ccSaved) do if p.Parent then p.CanCollide = true end end
		ccSaved = {}
	end
	F.track(RS.Stepped:Connect(function()
		-- NOVO: V.mode == "face" também atravessa paredes/chão enquanto você zoa o alvo
		local on = st.noclip or V.mode == "attach" or V.mode == "orbit" or V.mode == "face"
		if on and player.Character then
			for _, p in ipairs(player.Character:GetDescendants()) do
				if p:IsA("BasePart") and p.CanCollide then ccSaved[p] = true p.CanCollide = false end
			end
		elseif ccWas then
			F.restoreCollide()
		end
		ccWas = on
	end))

	local jumpsUsed = 0
	F.track(UIS.JumpRequest:Connect(function()
		local h = F.hum()
		if not h then return end
		if st.inf then return h:ChangeState(Enum.HumanoidStateType.Jumping) end
		if st.extra > 0 then
			local s = h:GetState()
			if (s == Enum.HumanoidStateType.Freefall or s == Enum.HumanoidStateType.Jumping) and jumpsUsed < st.extra then
				jumpsUsed += 1
				h:ChangeState(Enum.HumanoidStateType.Jumping)
			end
		end
	end))

	function F.clearWater() if V.water then V.water:Destroy() V.water = nil end end
	local function waterStep()
		local r = F.root()
		if not r then return end
		if not V.water then
			V.water = F.new("Part", { Name = "Fox_Agua", Anchored = true, Size = Vector3.new(14, 1, 14), Transparency = 1, CanQuery = false, CanTouch = false, CanCollide = false }, workspace)
		end
		local rp = F.charParams({ V.water })
		rp.IgnoreWater = false
		local hit = workspace:Raycast(r.Position + Vector3.new(0, 3, 0), Vector3.new(0, -14, 0), rp)
		if hit and hit.Material == Enum.Material.Water then
			V.water.CFrame = CFrame.new(r.Position.X, hit.Position.Y - 0.5, r.Position.Z)
			V.water.CanCollide = true
		else
			V.water.CanCollide = false
		end
	end

	local recAcc = 0
	F.track(RS.Heartbeat:Connect(function(dt)
		local h, r = F.hum(), F.root()
		if not (h and r) then return end
		if st.sprint then h.WalkSpeed = F.baseWS() * (UIS:IsKeyDown(KC.LeftShift) and st.sprintMul or 1) end
		if h.FloorMaterial ~= Enum.Material.Air then jumpsUsed = 0 end
		if st.glide and UIS:IsKeyDown(KC.Space) and h:GetState() == Enum.HumanoidStateType.Freefall then
			local v = r.AssemblyLinearVelocity
			if v.Y < -st.glideSpeed then r.AssemblyLinearVelocity = Vector3.new(v.X, -st.glideSpeed, v.Z) end
		end
		if st.water then waterStep() end
		if st.climb and h.MoveDirection.Magnitude > 0 then
			local hit = workspace:Raycast(r.Position, r.CFrame.LookVector * 3, F.charParams())
			if hit and hit.Instance.CanCollide then
				local v = r.AssemblyLinearVelocity
				r.AssemblyLinearVelocity = Vector3.new(v.X * 0.2, st.climbSpeed, v.Z * 0.2)
			end
		end
		if st.cycle then Lighting.ClockTime = (Lighting.ClockTime + dt * st.cycleSpd / 30) % 24 end
		if V.recOn then
			recAcc += dt
			if recAcc >= 0.05 then
				recAcc = 0
				V.rec[#V.rec + 1] = r.CFrame
				if #V.rec >= 600 then Reg.rec.set(false) end
			end
		end
	end))
	F.recReset = function() recAcc = 0 end
end

do -- modo deus
	local godConn, godFF
	function F.setGod(on)
		st.god = on
		if godConn then godConn:Disconnect() godConn = nil end
		if godFF then godFF:Destroy() godFF = nil end
		local h, c = F.hum(), player.Character
		if not (h and c) then return end
		if on then
			pcall(function() h:SetStateEnabled(Enum.HumanoidStateType.Dead, false) end)
			godFF = Instance.new("ForceField")
			godFF.Visible = false
			godFF.Parent = c
			h.Health = h.MaxHealth
			godConn = h.HealthChanged:Connect(function() if st.god and h.Health < h.MaxHealth then h.Health = h.MaxHealth end end)
		else
			pcall(function() h:SetStateEnabled(Enum.HumanoidStateType.Dead, true) end)
		end
	end
end
function F.resetChar()
	if st.god then
		if Reg.god then Reg.god.set(false, true) end
		F.setGod(false)
	end
	local h = F.hum()
	if h then h.Health = 0 end
end
function F.setSit(on) local h = F.hum() if h then h.Sit = on end end

local afkConn, afkCount, afkSince = nil, 0, 0
function F.setAfk(on)
	if afkConn then afkConn:Disconnect() afkConn = nil end
	if on then
		afkCount, afkSince = 0, os.clock()
		afkConn = player.Idled:Connect(function()
			afkCount += 1
			pcall(function()
				local vu = game:GetService("VirtualUser")
				vu:CaptureController()
				vu:ClickButton2(Vector2.new())
			end)
		end)
	end
end

function F.tpCF(cf, msg)
	local r = F.root()
	if not r then return end
	V.prev = r.CFrame
	r.CFrame, r.AssemblyLinearVelocity = cf, Vector3.zero
	if msg then F.toast(msg) end
end
function F.tpBack()
	local r = F.root()
	if not r then return end
	if not V.prev then return F.toast("Sem posição anterior") end
	local cur = r.CFrame
	r.CFrame, r.AssemblyLinearVelocity = V.prev, Vector3.zero
	V.prev = cur
	F.toast("Voltou à posição anterior")
end
do
	local lastDash = 0
	function F.dash()
		local r = F.root()
		if not r or os.clock() - lastDash < st.dashCd then return end
		lastDash = os.clock()
		local look = r.CFrame.LookVector
		if st.dashCam then
			local c = F.CAM().CFrame.LookVector
			local f = Vector3.new(c.X, 0, c.Z)
			if f.Magnitude > 0.01 then look = f.Unit end
		end
		r.CFrame += look * st.dashDist
	end
end
function F.mouseHit()
	local m = UIS:GetMouseLocation()
	local ray = F.CAM():ViewportPointToRay(m.X, m.Y)
	return workspace:Raycast(ray.Origin, ray.Direction * 5000, F.charParams())
end
function F.tpMouse()
	local r = F.root()
	if not r then return end
	local hit = F.mouseHit()
	if not hit then return F.toast("Nada para teleportar ali") end
	F.tpCF(CFrame.new(hit.Position + Vector3.new(0, 3, 0)) * (r.CFrame - r.CFrame.Position))
end
function F.tpCamera() F.tpCF(CFrame.new(F.CAM().CFrame.Position)) F.toast("Teleportado até a câmera") end

local placeKey = tostring(game.PlaceId)
S.pos[placeKey] = S.pos[placeKey] or {}
function F.posList() return S.pos[placeKey] end
function F.savePosNamed(name)
	local r = F.root()
	if not r then return end
	local l = F.posList()
	name = (name and name:gsub("^%s+", ""):gsub("%s+$", "")) or ""
	if name == "" then name = "Posição " .. (#l + 1) end
	local p = r.Position
	l[#l + 1] = { n = name, x = p.X, y = p.Y, z = p.Z }
	F.save() F.rebuildPos()
	F.toast("Salvo: " .. name)
end
function F.goPos(e) F.tpCF(CFrame.new(e.x, e.y + 3, e.z), "Ido para " .. e.n) end
function F.copyCF() local r = F.root() if r then F.copyText(tostring(r.CFrame), "CFrame") end end

do -- câmera
	local camConn, camCF, camYaw, camPitch, rmb = nil, nil, 0, 0, false
	local oZmax, oZmin, oMode = player.CameraMaxZoomDistance, player.CameraMinZoomDistance, player.CameraMode
	V.origFOV = F.CAM().FieldOfView
	local fovTarget = V.origFOV
	function F.stopCam()
		if camConn then camConn:Disconnect() camConn = nil end
		if V.cam == "free" then local r = F.root() if r then r.Anchored = false end end
		V.cam = nil
		local c, h = F.CAM(), F.hum()
		c.CameraType = Enum.CameraType.Custom
		if h then c.CameraSubject = h end
		UIS.MouseBehavior = Enum.MouseBehavior.Default
	end
	function F.setCamMode(mode)
		F.stopCam()
		if mode == "free" then
			V.cam = "free"
			local c = F.CAM()
			camCF = c.CFrame
			camPitch, camYaw = camCF:ToEulerAnglesYXZ()
			c.CameraType = Enum.CameraType.Scriptable
			local r = F.root()
			if r then r.Anchored = true end
			camConn = RS.RenderStepped:Connect(function(dt)
				local sp = st.freeSpeed * (UIS:IsKeyDown(KC.LeftShift) and 3 or 1)
				camCF = CFrame.new(camCF.Position) * CFrame.fromEulerAnglesYXZ(camPitch, camYaw, 0)
				local mv = Vector3.zero
				if UIS:IsKeyDown(KC.W) then mv += camCF.LookVector end
				if UIS:IsKeyDown(KC.S) then mv -= camCF.LookVector end
				if UIS:IsKeyDown(KC.D) then mv += camCF.RightVector end
				if UIS:IsKeyDown(KC.A) then mv -= camCF.RightVector end
				if UIS:IsKeyDown(KC.E) then mv += Vector3.yAxis end
				if UIS:IsKeyDown(KC.Q) then mv -= Vector3.yAxis end
				camCF += mv * sp * dt
				F.CAM().CFrame = camCF
			end)
		elseif mode == "orbit" then
			V.cam = "orbit"
			local ang = 0
			F.CAM().CameraType = Enum.CameraType.Scriptable
			camConn = RS.RenderStepped:Connect(function(dt)
				local r = F.root()
				if not r then return end
				ang += dt * st.orbSpeed * 0.1
				local pos = r.Position + Vector3.new(math.cos(ang) * st.orbRad, 4, math.sin(ang) * st.orbRad)
				F.CAM().CFrame = CFrame.new(pos, r.Position + Vector3.new(0, 2, 0))
			end)
		end
		if Reg.freecam then Reg.freecam.set(mode == "free", true) end
		if Reg.orbit then Reg.orbit.set(mode == "orbit", true) end
	end
	function F.restoreCamera()
		player.CameraMaxZoomDistance, player.CameraMinZoomDistance, player.CameraMode = oZmax, oZmin, oMode
		st.camH, st.camHTouched = 0, false
		local h = F.hum()
		if h then h.CameraOffset = Vector3.zero end
		fovTarget = V.origFOV
		F.CAM().FieldOfView = V.origFOV
	end
	function F.setFov(v) fovTarget = v F.tw(F.CAM(), { FieldOfView = v }, 0.2) end
	function F.firstP(on) player.CameraMode = on and Enum.CameraMode.LockFirstPerson or oMode end
	function F.camDist(v) player.CameraMinZoomDistance, player.CameraMaxZoomDistance = v, v end
	function F.setZoom(on) player.CameraMaxZoomDistance = on and 10000 or oZmax end
	function F.shot()
		pcall(function() game:GetService("CaptureService"):CaptureScreenshot(function() end) end)
		F.toast("Screenshot solicitado")
	end
	F.track(UIS.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton2 then rmb = true end end))
	F.track(UIS.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton2 then rmb = false UIS.MouseBehavior = Enum.MouseBehavior.Default end
	end))
	F.track(UIS.InputChanged:Connect(function(i)
		if V.closing then return end
		if i.UserInputType == Enum.UserInputType.MouseMovement and V.cam == "free" and rmb then
			UIS.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
			camYaw -= i.Delta.X * 0.003
			camPitch = math.clamp(camPitch - i.Delta.Y * 0.003, -1.5, 1.5)
		elseif i.UserInputType == Enum.UserInputType.MouseWheel and UIS:IsKeyDown(KC.Z) then
			fovTarget = math.clamp(fovTarget - i.Position.Z * 6, 10, 120)
			F.tw(F.CAM(), { FieldOfView = fovTarget }, 0.2)
		end
	end))
end

do -- iluminação, filtros, desempenho
	function F.getFx(class, name)
		if V.fx[name] and V.fx[name].Parent then return V.fx[name] end
		local e = Instance.new(class)
		e.Name = "Fox_" .. name
		e.Parent = Lighting
		V.fx[name] = e
		return e
	end
	function F.clearFx() for _, e in pairs(V.fx) do e:Destroy() end V.fx = {} end
	function F.restoreLighting()
		for k, v in pairs(L0) do Lighting[k] = v end
		F.clearFx()
	end
	local PRESETS = {
		["Padrão (original)"] = false,
		["Dia"] = { t = 14, b = 2.2, a = C3(130, 130, 130), sat = 0.08, con = 0.05, tint = C3(255, 255, 255) },
		["Noite"] = { t = 0, b = 0.6, a = C3(35, 40, 70), sat = -0.1, con = 0.1, tint = C3(190, 200, 255) },
		["Pôr do sol"] = { t = 18.1, b = 1.6, a = C3(150, 90, 70), sat = 0.2, con = 0.08, tint = C3(255, 200, 160) },
		["Neon"] = { t = 0, b = 1, a = C3(90, 40, 140), sat = 0.7, con = 0.25, tint = C3(255, 190, 255), bloom = 0.9 },
		["Sépia"] = { t = 14, b = 2, a = C3(120, 105, 85), sat = -1, con = 0.1, tint = C3(255, 225, 185) },
	}
	F.PRESET_ORDER = { "Padrão (original)", "Dia", "Noite", "Pôr do sol", "Neon", "Sépia" }
	function F.applyPreset(name)
		local p = PRESETS[name]
		F.restoreLighting()
		if not p then return end
		Lighting.ClockTime, Lighting.Brightness, Lighting.Ambient, Lighting.OutdoorAmbient = p.t, p.b, p.a, p.a
		local cc = F.getFx("ColorCorrectionEffect", "cc")
		cc.Saturation, cc.Contrast, cc.TintColor = p.sat, p.con, p.tint
		if p.bloom then F.getFx("BloomEffect", "bloom").Intensity = p.bloom end
	end
	function F.setFullbright(on)
		if on then
			Lighting.Brightness, Lighting.Ambient = 2, Color3.new(1, 1, 1)
			Lighting.OutdoorAmbient, Lighting.GlobalShadows = Color3.new(1, 1, 1), false
		else
			for _, k in ipairs({ "Brightness", "Ambient", "OutdoorAmbient", "GlobalShadows" }) do Lighting[k] = L0[k] end
		end
	end
	function F.setNoFog(on) Lighting.FogEnd = on and 1e6 or L0.FogEnd end
	V.amb = { r = 128, g = 128, b = 128, on = false }
	function F.applyAmbient()
		local a = V.amb
		if not a.on then return end
		local c = C3(a.r, a.g, a.b)
		Lighting.Ambient, Lighting.OutdoorAmbient = c, c
		local at = F.getFx("Atmosphere", "atm")
		at.Color, at.Decay, at.Density, at.Haze = c, c, 0.3, 1
	end
	function F.setAmbient(on)
		V.amb.on = on
		if on then F.applyAmbient()
		else
			Lighting.Ambient, Lighting.OutdoorAmbient = L0.Ambient, L0.OutdoorAmbient
			if V.fx.atm then V.fx.atm:Destroy() V.fx.atm = nil end
		end
	end

	V.collR, V.collBoxes = 40, {}
	function F.clearColl() for _, b in ipairs(V.collBoxes) do b:Destroy() end V.collBoxes = {} end
	function F.updateColl()
		F.clearColl()
		local r = F.root()
		if not r then return end
		local ex = {}
		for _, p in ipairs(Players:GetPlayers()) do if p.Character then ex[#ex + 1] = p.Character end end
		local rp = OverlapParams.new()
		rp.FilterType, rp.FilterDescendantsInstances, rp.MaxParts = Enum.RaycastFilterType.Exclude, ex, 120
		for _, part in ipairs(workspace:GetPartBoundsInRadius(r.Position, V.collR, rp)) do
			V.collBoxes[#V.collBoxes + 1] = F.new("SelectionBox", { Adornee = part, LineThickness = 0.03, Transparency = 0.35,
				Color3 = part.CanCollide and C3(80, 255, 120) or C3(255, 90, 90) }, gui)
		end
	end
	function F.setColl(on) V.collOn = on if on then F.updateColl() else F.clearColl() end end

	local matSaved, fxSaved, origQL, origDeco = {}, {}, nil, nil
	function F.setSimpleMat(on)
		if on then
			for _, p in ipairs(workspace:GetDescendants()) do
				if p:IsA("BasePart") and not p:IsA("Terrain") and p.Material ~= Enum.Material.Plastic and not F.isCharPart(p) then
					matSaved[p] = p.Material
					p.Material = Enum.Material.Plastic
				end
			end
		else
			for p, m in pairs(matSaved) do if p.Parent then p.Material = m end end
			matSaved = {}
		end
	end
	function F.setNoFx(on)
		if on then
			for _, o in ipairs(workspace:GetDescendants()) do
				if (o:IsA("ParticleEmitter") or o:IsA("Trail") or o:IsA("Beam") or o:IsA("Smoke") or o:IsA("Fire") or o:IsA("Sparkles")) and o.Enabled then
					fxSaved[o] = true
					o.Enabled = false
				end
			end
		else
			for o in pairs(fxSaved) do if o.Parent then o.Enabled = true end end
			fxSaved = {}
		end
	end
	function F.setLowQ(on)
		pcall(function()
			local r = settings().Rendering
			if on then origQL = origQL or r.QualityLevel r.QualityLevel = Enum.QualityLevel.Level01
			elseif origQL then r.QualityLevel = origQL origQL = nil end
		end)
	end
	function F.setNoTerrain(on)
		pcall(function()
			local t = workspace.Terrain
			if on then if origDeco == nil then origDeco = t.Decoration end t.Decoration = false
			elseif origDeco ~= nil then t.Decoration = origDeco origDeco = nil end
		end)
	end
end

---------------------------------------------------------------- sistema de jogadores
function F.targetRoot() local c = V.target and V.target.Character return c and c:FindFirstChild("HumanoidRootPart") end
function F.others()
	local l = {}
	for _, p in ipairs(Players:GetPlayers()) do if p ~= player then l[#l + 1] = p end end
	table.sort(l, function(a, b)
		local fa, fb = S.pfav[a.Name] and 0 or 1, S.pfav[b.Name] and 0 or 1
		if fa ~= fb then return fa < fb end
		return a.DisplayName:lower() < b.DisplayName:lower()
	end)
	return l
end
function F.needTarget()
	if V.target and V.target.Parent == Players then return true end
	F.toast("Selecione um jogador primeiro")
end
function F.dist(p)
	local a, b = F.root(), p.Character and p.Character:FindFirstChild("HumanoidRootPart")
	return a and b and math.floor((a.Position - b.Position).Magnitude) or nil
end
function F.stopAction(silent)
	if V.conn then V.conn:Disconnect() V.conn = nil end
	local was = V.mode
	if was == "attach" then F.setSit(false)
	elseif was == "follow" then
		local h, r = F.hum(), F.root()
		if h and r then h:MoveTo(r.Position) end
	end
	V.mode = nil
	F.refreshUI()
	if was and not silent then F.toast("Ação parada") end
end
-- CORREÇÃO: espectar agora é sincronizado com o botão, religa a câmera quando o alvo renasce e para de verdade
function F.setSpectate(on)
	local cam = F.CAM()
	if on then
		if not F.needTarget() then F.syncActs() return false end
		local th = V.target.Character and V.target.Character:FindFirstChildOfClass("Humanoid")
		if not th then F.toast("Personagem indisponível") F.syncActs() return false end
		V.spec = true
		cam.CameraType, cam.CameraSubject = Enum.CameraType.Custom, th
		if not V.specC then
			local acc = 0
			V.specC = F.track(RS.Heartbeat:Connect(function(dt)
				acc += dt
				if acc < 0.25 or not V.spec or V.cam then return end
				acc = 0
				local t = V.target
				local hum = t and t.Character and t.Character:FindFirstChildOfClass("Humanoid")
				if hum and F.CAM().CameraSubject ~= hum then F.CAM().CameraSubject = hum end
			end))
		end
	else
		V.spec = false
		if V.specC then V.specC:Disconnect() V.specC = nil end
		local h = F.hum()
		if h then cam.CameraSubject = h end
		if not V.cam then cam.CameraType = Enum.CameraType.Custom end
	end
	F.refreshUI()
	return true
end
function F.selectTarget(p)
	if V.target == p then return end
	V.target = p
	F.stopAction(true)
	if V.spec then F.setSpectate(p ~= nil) end
	if p then
		local h = S.hist
		local i = table.find(h, p.Name)
		if i then table.remove(h, i) end
		table.insert(h, 1, p.Name)
		while #h > 6 do table.remove(h) end
		F.save()
	end
	F.refreshUI()
	F.rebuildHist()
end
function F.cycle(step)
	local l = F.others()
	if #l == 0 then return F.toast("Nenhum outro jogador") end
	local i = table.find(l, V.target) or (step > 0 and 0 or #l + 1)
	i = ((i - 1 + step) % #l) + 1
	F.selectTarget(l[i])
	F.toast("Selecionado: " .. l[i].DisplayName)
end
function F.specCycle(step) F.cycle(step) F.setSpectate(true) end
function F.tpToTarget()
	if not F.needTarget() then return end
	local tr = F.targetRoot()
	if not (tr and F.root()) then return F.toast("Personagem indisponível") end
	F.tpCF(tr.CFrame * CFrame.new(0, 0, 4), "Teleportado até " .. V.target.DisplayName)
end
local MSG = { attach = "Grudado nas costas de ", follow = "Seguindo ", orbit = "Orbitando " }
do
	local orbitA = 0
	function F.startAction(mode)
		if not F.needTarget() then return end
		if not (F.targetRoot() and F.root()) then return F.toast("Personagem indisponível") end
		F.stopAction(true)
		V.mode = mode
		local acc = 0
		V.conn = RS.Heartbeat:Connect(function(dt)
			local tr, r, h = F.targetRoot(), F.root(), F.hum()
			if not (tr and r and h) then return end
			if mode == "attach" then
				h.Sit = true
				r.AssemblyLinearVelocity, r.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
				r.CFrame = tr.CFrame * CFrame.new(0, P.height / 10, P.dist / 10) * CFrame.Angles(0, math.pi, 0)
			elseif mode == "orbit" then
				orbitA += dt * P.speed
				local c = tr.Position
				local pos = c + Vector3.new(math.cos(orbitA) * P.radius, 0, math.sin(orbitA) * P.radius)
				r.AssemblyLinearVelocity = Vector3.zero
				r.CFrame = CFrame.new(pos, Vector3.new(c.X, pos.Y, c.Z))
			else
				acc += dt
				if acc < 0.12 then return end
				acc = 0
				if (tr.Position - r.Position).Magnitude > P.follow then
					h:MoveTo(tr.Position)
					if tr.Position.Y - r.Position.Y > 3.5 then h.Jump = true end
				else
					h:MoveTo(r.Position)
				end
			end
		end)
		F.refreshUI()
		F.toast(MSG[mode] .. V.target.DisplayName)
	end
end

function F.clearTags() for _, t in pairs(V.tags) do t:Destroy() end V.tags = {} end
function F.updateTags()
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player then
			local head = p.Character and p.Character:FindFirstChild("Head")
			local t = V.tags[p]
			if head and (not t or t.Adornee ~= head) then
				if t then t:Destroy() end
				t = F.new("BillboardGui", { Adornee = head, Size = U2o(150, 36), StudsOffset = Vector3.new(0, 2.8, 0), AlwaysOnTop = false, MaxDistance = 300 }, gui)
				F.txt(t, p.DisplayName, { Name = "n", Size = U2(1, 0, 0.5, 0), TextXAlignment = EXA.Center, Font = EF.GothamBold, TextSize = 14 })
				F.txt(t, "", { Name = "d", Size = U2(1, 0, 0.5, 0), Position = UDim2.fromScale(0, 0.5), TextXAlignment = EXA.Center, TextColor3 = C.muted, TextSize = 12 })
				V.tags[p] = t
			end
			if t and head then
				local d = F.dist(p)
				t.d.Text = d and (d .. "m") or ""
			end
		end
	end
end
