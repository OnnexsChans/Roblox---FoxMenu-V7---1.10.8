function F.selectTab(name)
	if curTab == name or not V.tabs[name] then return end
	local first = curTab == nil
	local hid = V.tabs[name].hidden
	if curTab and not V.tabs[curTab].hidden then V.prevTab = curTab end
	curTab, V.curTab = name, name
	if not hid then S.tab = name F.save() end
	if not first then F.snd("tab") end
	indicator.Visible = not hid
	if F.devBtnSet then F.devBtnSet(name == F.DEV_TAB) end
	if F.newsBtnSet then F.newsBtnSet(name == F.NEWS_TAB) end
	F.pageT.Text, F.pageS.Text = name, F.TAB_SUB[name] or ""
	F.pageT.TextTransparency, F.pageS.TextTransparency = 1, 1
	F.pageT.Position, F.pageS.Position = U2o(10, 12), U2o(10, 38)
	F.tw(F.pageT, { TextTransparency = 0, Position = U2o(24, 12) }, 0.4, QUINT)
	task.delay(0.06, function() F.tw(F.pageS, { TextTransparency = 0, Position = U2o(24, 38) }, 0.4, QUINT) end)
	for n, t in pairs(V.tabs) do
		local on = n == name
		F.tw(t.btn, { TextColor3 = on and C.text or C.muted, BackgroundTransparency = 1 }, 0.2)
		if on then
			if not hid then F.tw(indicator, { Position = U2(0, 8, 0, F.tabY(t.i)) }, 0.5, BACK) end
			t.group.Position, t.group.GroupTransparency, t.group.Visible = U2o(12, GY + 18), 1, true
			F.tw(t.group, { Position = U2o(12, GY), GroupTransparency = 0 }, 0.4, QUINT)
		elseif t.group.Visible then
			F.tw(t.group, { Position = U2o(12, GY - 10), GroupTransparency = 1 }, 0.14)
			task.delay(0.15, function() if curTab ~= n then t.group.Visible = false end end)
		end
	end
end
