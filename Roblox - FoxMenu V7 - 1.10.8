-- mantém cada interruptor igual ao estado real (evita botão "ligado" com o recurso desligado e vice-versa)
F.SYNC = { fly = "fly", noclip = "noclip", inf = "inf", glide = "glide", water = "water", climb = "climb", sprint = "sprint", god = "god" }
function F.syncToggles()
	for id, key in pairs(F.SYNC) do
		local r = Reg[id]
		local real = st[key] == true
		if r and r.get() ~= real then r.set(real, true) end
	end
	local hg = Reg.hidegui
	if hg and hg.get() ~= X.hg.on then hg.set(X.hg.on, true) end
end

