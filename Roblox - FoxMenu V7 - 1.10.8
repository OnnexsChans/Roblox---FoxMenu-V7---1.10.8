do
	local t0, acc, acc2, acc3, fr, tick = os.clock(), 0, 0, 0, 0, 0
	F.track(RS.RenderStepped:Connect(function(dt)
		fr += 1 acc += dt acc2 += dt acc3 += dt
		if acc3 >= 0.1 then
			acc3 = 0
			local e = F.swElapsed()
			local es = math.floor(e)
			I.sw(string.format("%02d:%02d.%d", es // 60, es % 60, math.floor((e * 10) % 10)))
			if V.alarm and os.clock() >= V.alarm then
				V.alarm = nil
				F.toast("⏰ Alarme!")
				F.chime(1, 1.26, 1.5, 2)
			end
		end
		if acc2 >= 0.25 then
			acc2 = 0
			tick += 1
			local r = F.root()
			if r then
				local l = F.posList()
				for i, dot in ipairs(V.mmDots) do
					local e = l[i]
					if e then
						local dx, dz = e.x - r.Position.X, e.z - r.Position.Z
						local m = math.sqrt(dx * dx + dz * dz)
						local s = 80 / mmRadius
						if m > mmRadius then s = s * mmRadius / m end
						dot.Position = U2o(88 + dx * s, 88 + dz * s)
						dot.BackgroundColor3 = m > mmRadius and C.off or C.white
						dot.Visible = true
					else
						dot.Visible = false
					end
				end
			end
			if V.tagsOn then F.updateTags() end
			if V.collOn and tick % 3 == 0 then F.updateColl() end
			for p, rw in pairs(rows) do
				local d = F.dist(p)
				rw.sub.Text = "@" .. p.Name .. (d and ("  ·  " .. d .. "m") or "")
			end
			if V.target then local d = F.dist(V.target) I.p_dist(d and (d .. " m") or "—") end
		end
		if acc >= 0.5 then
			local fps = math.floor(fr / acc + 0.5)
			I.fps(fps .. " fps")
			V.G.fps(fps)
			local ok, ping = pcall(function() return player:GetNetworkPing() end)
			if ok then I.ping(math.floor(ping * 1000) .. " ms") V.G.ping(ping * 1000) end
			local r = F.root()
			if r then local p = r.Position I.pos(string.format("%d, %d, %d", math.floor(p.X), math.floor(p.Y), math.floor(p.Z))) end
			I.srv(#Players:GetPlayers() .. " / " .. Players.MaxPlayers)
			local s = math.floor(os.clock() - t0)
			I.ses(string.format("%02d:%02d:%02d", s // 3600, (s % 3600) // 60, s % 60))
			I.clock(os.date("%H:%M:%S"))
			I.rec_n(#V.rec .. (V.recOn and "  (gravando)" or ""))
			I.afk_n(tostring(afkCount))
			local at = afkConn and math.floor(os.clock() - afkSince) or 0
			I.afk_t(string.format("%02d:%02d:%02d", at // 3600, (at % 3600) // 60, at % 60))
			local n = 0
			for _, rg in pairs(Reg) do if rg.feat and rg.get() == true then n += 1 end end
			badge.Visible, badgeTxt.Text = n > 0, tostring(n)
			F.syncToggles()
			for _, q in ipairs(quickBtns) do
				local e = Ent[q.id]
				local on = e and e.kind == "toggle" and e.get() == true
				q.btn.BackgroundColor3 = on and C.white or C.item
				q.btn.TextColor3 = on and C.black or C.text
			end
			for _, t in ipairs(V.tiles) do
				local e = Ent[t.id]
				local on = e and e.kind == "toggle" and e.get() == true
				t.btn.BackgroundColor3 = on and C.white or C.item
				t.nm.TextColor3 = on and C.black or C.text
				t.dot.BackgroundColor3 = on and C3(60, 200, 120) or C.off
			end
			acc, fr = 0, 0
		end
	end))
end

